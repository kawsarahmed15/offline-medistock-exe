# .gitignore for Medistock Pharmacy ERP (.NET 10 / WinUI 3 / SQLite / PostgreSQL)

# Visual Studio & IDE
.vs/
.vscode/
*.user
*.userosscache
*.sln.docstates
*.suo

# Build Results & Binaries
[Bb]in/
[Oo]bj/
dist/
publish/
*.zip
*.7z
*.rar
*.tar.gz
installer/Output/
installer/*.exe
[Aa]pp[Pp]ackages/
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
*.nupkg
*.pfx
*.snk

# C# / .NET
*.exe
*.dll
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json

# WinUI 3 / MSIX / Windows App SDK
Generated Files/
bundleconfig.json.bindings
*.msix
*.appx
*.msixbundle
*.appxbundle
*.appxrecipe

# SQLite / Database artifacts
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.db
*.sqlite
*.sqlite3
!/migrations/**

# Logs & Diagnostics
*.log
*.tmp
_logs/
logs/
TestResults/
*.trx
*.coverage
*.coveragexml

# OS Generated
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Secrets & Environment Local Configs
*.env
*.env.local
*.secrets.json
appsettings.Development.json
appsettings.Local.json
