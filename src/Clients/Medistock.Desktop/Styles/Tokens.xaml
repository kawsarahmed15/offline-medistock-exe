<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Medistock.Desktop.Controls">

    <controls:StringFormatConverter x:Key="StringFormatConverter" />
    <controls:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <ThemeShadow x:Key="SharedShadow" />

    <!-- Spacing Scale (8dp grid) -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">20</x:Double>
    <x:Double x:Key="Spacing2Xl">24</x:Double>
    <x:Double x:Key="Spacing3Xl">32</x:Double>

    <!-- Corner Radius Scale -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <!-- Type Scale -->
    <x:Double x:Key="FontSize11">11</x:Double>
    <x:Double x:Key="FontSize12">12</x:Double>
    <x:Double x:Key="FontSize13">13</x:Double>
    <x:Double x:Key="FontSize14">14</x:Double>
    <x:Double x:Key="FontSize15">15</x:Double>
    <x:Double x:Key="FontSize16">16</x:Double>
    <x:Double x:Key="FontSize18">18</x:Double>
    <x:Double x:Key="FontSize20">20</x:Double>
    <x:Double x:Key="FontSize24">24</x:Double>
    <x:Double x:Key="FontSize28">28</x:Double>
    <x:Double x:Key="FontSize32">32</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <!-- Light Theme Palette -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackground" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSubtle" Color="#F1F5F9" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#F1F5F9" />

            <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
            <SolidColorBrush x:Key="TextSecondary" Color="#475569" />
            <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
            <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AccentPrimary" Color="#15803D" />
            <SolidColorBrush x:Key="AccentHover" Color="#166534" />
            <SolidColorBrush x:Key="AccentSubtle" Color="#DCFCE7" />

            <SolidColorBrush x:Key="BorderDefault" Color="#E2E8F0" />
            <SolidColorBrush x:Key="BorderFocus" Color="#15803D" />
            <SolidColorBrush x:Key="BorderStrong" Color="#CBD5E1" />

            <SolidColorBrush x:Key="StatusSuccess" Color="#16A34A" />
            <SolidColorBrush x:Key="StatusWarning" Color="#D97706" />
            <SolidColorBrush x:Key="StatusDanger" Color="#DC2626" />
            <SolidColorBrush x:Key="StatusInfo" Color="#0369A1" />

            <!-- Pharmacy Specific -->
            <SolidColorBrush x:Key="BatchExpiryCritical" Color="#DC2626" />
            <SolidColorBrush x:Key="BatchExpiryWarning" Color="#D97706" />
            <SolidColorBrush x:Key="BatchExpiryOk" Color="#16A34A" />
            <SolidColorBrush x:Key="ScheduleHBadge" Color="#7C3AED" />
            <SolidColorBrush x:Key="NarcoticBadge" Color="#DC2626" />
        </ResourceDictionary>

        <!-- Dark Theme Palette -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackground" Color="#0D1117" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#161B22" />
            <SolidColorBrush x:Key="SurfaceElevated" Color="#21262D" />
            <SolidColorBrush x:Key="SurfaceSubtle" Color="#0D1117" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#13151A" />

            <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
            <SolidColorBrush x:Key="TextSecondary" Color="#8B949E" />
            <SolidColorBrush x:Key="TextMuted" Color="#6E7681" />
            <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AccentPrimary" Color="#22C55E" />
            <SolidColorBrush x:Key="AccentHover" Color="#16A34A" />
            <SolidColorBrush x:Key="AccentSubtle" Color="#14532D" />

            <SolidColorBrush x:Key="BorderDefault" Color="#30363D" />
            <SolidColorBrush x:Key="BorderFocus" Color="#22C55E" />
            <SolidColorBrush x:Key="BorderStrong" Color="#484F58" />

            <SolidColorBrush x:Key="StatusSuccess" Color="#22C55E" />
            <SolidColorBrush x:Key="StatusWarning" Color="#F59E0B" />
            <SolidColorBrush x:Key="StatusDanger" Color="#F87171" />
            <SolidColorBrush x:Key="StatusInfo" Color="#38BDF8" />

            <!-- Pharmacy Specific -->
            <SolidColorBrush x:Key="BatchExpiryCritical" Color="#F87171" />
            <SolidColorBrush x:Key="BatchExpiryWarning" Color="#F59E0B" />
            <SolidColorBrush x:Key="BatchExpiryOk" Color="#22C55E" />
            <SolidColorBrush x:Key="ScheduleHBadge" Color="#A78BFA" />
            <SolidColorBrush x:Key="NarcoticBadge" Color="#F87171" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
