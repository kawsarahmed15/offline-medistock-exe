<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Medistock.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Medistock.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Medistock — Pharmacy ERP &amp; POS"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource SurfaceBackground}" Padding="12,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/MedistockLogo.png" Width="24" Height="24" />
                <TextBlock Text="Medistock" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="— Pharmacy ERP &amp; POS" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Right Header Controls: Theme Toggle & Status -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ThemeToggleButton"
                        Click="ThemeToggleButton_Click"
                        Content="🌙 / ☀️ Theme"
                        ToolTipService.ToolTip="Toggle Dark / Light Theme"
                        IsTabStop="False"
                        Background="Transparent"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="4"
                        FontSize="11"
                        Padding="8,4" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        CompactPaneLength="52"
                        OpenPaneLength="240"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <!-- Sales -->
                <NavigationViewItem Content="Sales [F3]" Tag="pos"
                                    ToolTipService.ToolTip="Sales — Create bills, apply discounts and print receipts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 🔄 Sales History & Returns -->
                <NavigationViewItem Content="Sales History &amp; Returns [F7]" Tag="sales_history"
                                    ToolTipService.ToolTip="View past bills, process returns and credit notes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Purchases & Inward -->
                <NavigationViewItem Content="Purchases [F4]" Tag="purchases"
                                    ToolTipService.ToolTip="Purchases — Record invoices and inward stock from suppliers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 📦 Inventory & Stock -->
                <NavigationViewItem Content="Inventory &amp; Stock" Tag="inventory"
                                    ToolTipService.ToolTip="Manage medicines, batches, stock levels and search catalog">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- ⏰ Expiry Risk -->
                <NavigationViewItem Content="Expiry Risk Engine" Tag="expiry"
                                    ToolTipService.ToolTip="Track near-expiry and expired batches to prevent losses">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 📋 Schedule Drug Register -->
                <NavigationViewItem Content="Schedule Drug Register" Tag="compliance"
                                    ToolTipService.ToolTip="H/H1/X schedule drug sales register — compliance &amp; audit log">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 💰 Financial Accounts -->
                <NavigationViewItem Content="Financial Accounts" Tag="accounting"
                                    ToolTipService.ToolTip="Party ledgers, outstanding dues, payments received/made">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 🧾 GST Reports -->
                <NavigationViewItem Content="GST Reports (GSTR-1/2/3B)" Tag="gst_reports"
                                    ToolTipService.ToolTip="Generate GSTR-1, GSTR-3B and purchase GST reports for filing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 🔁 Stock Transfers -->
                <NavigationViewItem Content="Stock Transfers (Multi-Branch)" Tag="stock_transfers"
                                    ToolTipService.ToolTip="Transfer stock between branches or warehouse locations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 🤝 B2B Wholesale -->
                <NavigationViewItem Content="B2B Wholesaler Commerce" Tag="b2b_commerce"
                                    ToolTipService.ToolTip="Manage wholesale orders, buyer accounts and distributor sales">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 🖨️ Bill Customizer -->
                <NavigationViewItem Content="Bill Customizer Studio" Tag="bill_customizer"
                                    ToolTipService.ToolTip="Design bill templates, headers, columns and invoice layout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!-- ⚙️ Settings -->
                <NavigationViewItem Content="Settings &amp; Preferences" Tag="settings"
                                    ToolTipService.ToolTip="App settings, store profile, backup, updates and seeder">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- First-Launch Theme Selection Modal Overlay -->
        <Grid x:Name="ThemeOnboardingOverlay"
              Grid.RowSpan="2"
              Background="#CC000000"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource BorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="28,24"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <!-- Header with Logo -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/MedistockLogo.png" Width="44" Height="44" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Welcome to Medistock" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Medical &amp; Pharmacy ERP Software" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Choose your preferred visual theme for billing and inventory:"
                               FontSize="13"
                               Foreground="{ThemeResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,4" />

                    <!-- Theme Option Cards -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!-- Dark Theme Card -->
                        <Button x:Name="DarkThemeCard"
                                Grid.Column="0"
                                Click="SelectDarkTheme_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="16,20"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource AccentPrimary}"
                                BorderThickness="2"
                                CornerRadius="6">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="🌙" FontSize="26" HorizontalAlignment="Center" />
                                <TextBlock Text="Dark Mode" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Recommended for POS" FontSize="11" Foreground="{ThemeResource AccentPrimary}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="High contrast, low eye fatigue in billing counters." FontSize="10" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Light Theme Card -->
                        <Button x:Name="LightThemeCard"
                                Grid.Column="1"
                                Click="SelectLightTheme_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="16,20"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="☀️" FontSize="26" HorizontalAlignment="Center" />
                                <TextBlock Text="Light Mode" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Daytime Classic" FontSize="11" Foreground="{ThemeResource TextSecondary}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Clean daylight look with crisp paper-white backgrounds." FontSize="10" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button Content="Confirm &amp; Start Billing [Enter]"
                            Click="ConfirmThemeSelection_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="38"
                            FontWeight="Bold"
                            FontSize="13"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- ACTIVATION & LICENSE GATE MODAL OVERLAY                   -->
        <!-- ========================================================= -->
        <Grid x:Name="ActivationOverlay"
              Grid.RowSpan="2"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="Collapsed"
              Canvas.ZIndex="200">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Spacing="0">
                <!-- Logo & Title -->
                <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Image Source="ms-appx:///Assets/MedistockLogo.png" Width="56" Height="56" HorizontalAlignment="Center" />
                    <TextBlock Text="Medistock" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="Pharmacy ERP &amp; POS" FontSize="13" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Activation Card -->
                <Border Background="{ThemeResource SurfaceBackground}"
                        CornerRadius="12"
                        Padding="32,28"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource BorderDefault}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Sign in to activate your software" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />

                        <!-- Email -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Email Address" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBox x:Name="ActivationEmailBox"
                                     PlaceholderText="owner@pharmacy.com"
                                     KeyDown="ActivationInput_KeyDown" />
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Account Password" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <PasswordBox x:Name="ActivationPasswordBox"
                                         PlaceholderText="••••••••"
                                         KeyDown="ActivationInput_KeyDown" />
                        </StackPanel>

                        <!-- Activate Button -->
                        <Button x:Name="ActivateSubmitButton"
                                Content="Activate Software"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="38"
                                FontWeight="Bold"
                                Click="ActivateSubmitButton_Click"
                                Margin="0,8,0,0" />

                        <!-- Status Message -->
                        <TextBlock x:Name="ActivationStatusText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed" />

                        <!-- Progress Bar -->
                        <ProgressBar x:Name="ActivationProgressBar"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <TextBlock Text="Valid Medistock license required. Contact: support@medistock.in"
                           FontSize="11"
                           Foreground="{ThemeResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
