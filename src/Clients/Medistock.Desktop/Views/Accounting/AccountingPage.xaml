<Page
    x:Class="Medistock.Desktop.Views.Accounting.AccountingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:Medistock.Application.Accounting.DTOs"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource SurfaceBackground}" Padding="16,12" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="FINANCIAL ACCOUNTING CORE" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="● Double-Entry General Ledger &amp; Day Book" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="+ Customer Receipt" Command="{x:Bind ViewModel.OpenReceiptDialogCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="+ Supplier Payment" Command="{x:Bind ViewModel.OpenPaymentDialogCommand}" />
                <Button Content="+ Expense" Command="{x:Bind ViewModel.OpenExpenseDialogCommand}" />
                <Button Content="↻ Refresh" Command="{x:Bind ViewModel.LoadInitialDataCommand}" />
            </StackPanel>
        </Grid>


        <!-- 2. KPI Summary Ribbon -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="16,12,16,12">
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12" Margin="0,0,0,12">
                <!-- Trial Balance Debits -->
                <Border Grid.Column="0" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL DEBITS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalDebits, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                    </StackPanel>
                </Border>

                <!-- Trial Balance Credits -->
                <Border Grid.Column="1" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL CREDITS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalCredits, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                    </StackPanel>
                </Border>

                <!-- Total Revenue -->
                <Border Grid.Column="2" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="REVENUE (30 DAYS)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalRevenue, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource StatusSuccess}" />
                    </StackPanel>
                </Border>

                <!-- Net Profit -->
                <Border Grid.Column="3" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="NET PROFIT / (LOSS)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.NetProfit, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Accounting Tabs -->
            <TabView Grid.Row="1" SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}">
                <!-- Tab 1: Chart of Accounts & Individual Ledgers -->
                <TabViewItem Header="Chart of Accounts &amp; Ledgers" IsClosable="False">
                    <Grid ColumnDefinitions="350,*" Margin="0,8,0,0">
                        <!-- Left: Account Heads List -->
                        <Border Grid.Column="0" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="Accounts Head Catalog" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,8" />
                                <ListView Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:AccountHeadDto">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                                <Border Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="4,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{x:Bind Code}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                                                    <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind CurrentBalance, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Right: Account Ledger Running Statement -->
                        <Border Grid.Column="1" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Row="0" Text="Account Ledger Statement" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                                
                                <Grid Grid.Row="1" ColumnDefinitions="110,90,*,100,100,110" Padding="8,6" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Voucher" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="Particulars / Narration" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="Debit (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Credit (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Balance (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>

                                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.LedgerLines, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="dtos:AccountLedgerLineDto">
                                            <Grid ColumnDefinitions="110,90,*,100,100,110" Padding="8,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                                <TextBlock Grid.Column="0" Text="{x:Bind VoucherDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:yyyy-MM-dd}'}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind VoucherNumber}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Particulars}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Narration}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{x:Bind DebitAmount, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource StatusDanger}" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind CreditAmount, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource StatusSuccess}" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind RunningBalance, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>

                <!-- Tab 2: Day Book -->
                <TabViewItem Header="Day Book (Daily Vouchers)" IsClosable="False">
                    <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="Daily Transaction Vouchers" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

                            <Grid Grid.Row="1" ColumnDefinitions="110,120,100,*,110,120" Padding="8,6" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Voucher No" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Type" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="Primary Account / Narration" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="4" Text="User" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="5" Text="Total Amount (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>

                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.DayBookEntries, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:DayBookVoucherDto">
                                        <Grid ColumnDefinitions="110,120,100,*,110,120" Padding="8,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                            <TextBlock Grid.Column="0" Text="{x:Bind VoucherDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:yyyy-MM-dd}'}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind VoucherNumber}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentPrimary}" />
                                            <Border Grid.Column="2" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind VoucherType}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind PrimaryAccount}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Narration}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{x:Bind CreatedByUserId}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind TotalAmount, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </TabViewItem>

                <!-- Tab 3: Trial Balance Summary -->
                <TabViewItem Header="Trial Balance" IsClosable="False">
                    <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="Trial Balance (As of Current Date)" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

                            <Grid Grid.Row="1" ColumnDefinitions="100,*,140,140,140" Padding="8,6" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="Code" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Account Name" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Category" FontWeight="Bold" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="Debit Balance (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Credit Balance (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>

                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.TrialBalanceItems, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:TrialBalanceItemDto">
                                        <Grid ColumnDefinitions="100,*,140,140,140" Padding="8,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                            <TextBlock Grid.Column="0" Text="{x:Bind AccountCode}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind AccountName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Category}" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind DebitBalance, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CreditBalance, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </TabViewItem>
            </TabView>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{ThemeResource SurfaceBackground}" Padding="16,6">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
        </Border>

        <!-- 4. Quick Voucher Dialog Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
              Visibility="{x:Bind ViewModel.IsVoucherDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{ThemeResource SharedShadow}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Record Accounting Voucher" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />

                    <!-- Party / Vendor Name -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Party / Customer / Vendor Name:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{x:Bind ViewModel.VoucherPartyName, Mode=TwoWay}" PlaceholderText="e.g. John Doe / Apex Distributors" />
                    </StackPanel>

                    <!-- Amount -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Settlement Amount (₹):" FontSize="12" FontWeight="SemiBold" />
                        <NumberBox Value="{x:Bind ViewModel.VoucherAmount, Mode=TwoWay}" SpinButtonPlacementMode="Inline" Minimum="0" />
                    </StackPanel>

                    <!-- Payment Mode -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Payment Mode / Account:" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="Cash on Hand (acc_cash)" IsChecked="{x:Bind ViewModel.IsCashPayment, Mode=TwoWay}" />
                            <RadioButton Content="Bank / UPI (acc_bank)" IsChecked="{x:Bind ViewModel.IsCashPayment, Mode=TwoWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Expense Account Dropdown (if expense) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Expense Head (if Expense Voucher):" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ExpenseAccounts, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedExpenseAccount, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Narration -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Voucher Narration / Reference:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{x:Bind ViewModel.VoucherNarration, Mode=TwoWay}" PlaceholderText="Narration..." />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="Cancel" Command="{x:Bind ViewModel.CloseVoucherDialogCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Post Voucher" Command="{x:Bind ViewModel.SaveVoucherCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

