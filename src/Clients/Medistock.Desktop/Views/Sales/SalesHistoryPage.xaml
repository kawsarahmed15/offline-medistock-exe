<Page
    x:Class="Medistock.Desktop.Views.Sales.SalesHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:Medistock.Application.Sales.DTOs"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. Header Toolbar -->
        <Grid Grid.Row="0" Background="{ThemeResource SurfaceBackground}" Padding="16,12" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="SALES HISTORY &amp; RETURNS" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="● Tax Invoices, Credit Notes &amp; Restocking" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </Border>
            </StackPanel>

            <!-- Search Field -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                         PlaceholderText="Search by Invoice No (e.g. INV-2026-0001) or Customer Name..."
                         Width="380" />
                <Button Content="Search" Command="{x:Bind ViewModel.LoadSalesCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="↻ Refresh" Command="{x:Bind ViewModel.LoadSalesCommand}" />
            </StackPanel>
        </Grid>

        <!-- 2. Two-Panel Split: Invoices List (Left) & Invoice Detail + Return Action (Right) -->
        <Grid Grid.Row="1" ColumnDefinitions="450,*" Margin="16,12,16,12">
            <!-- Left: Sales Invoices List -->
            <Border Grid.Column="0" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
                        <TextBlock Text="Issued Tax Invoices" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Sales.Count, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} Invoices'}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                    </Grid>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Sales, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSaleSummary, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:SaleSummaryDto">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="6,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <!-- Invoice No badge -->
                                    <Border Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind InvoiceNo}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                    </Border>

                                    <!-- Customer & Date -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind CustomerName, TargetNullValue='Walk-in Customer'}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind InvoiceDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                            <TextBlock Text="{x:Bind ItemsCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} items'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Amount & Status -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Total, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" />
                                        <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource StatusSuccess}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Detailed Invoice View & Action Bar -->
            <Border Grid.Column="1" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Invoice Header Info -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.InvoiceNo, Mode=OneWay, TargetNullValue='Select an invoice'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.Status, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.CustomerName, Mode=OneWay, TargetNullValue='Walk-in Customer'}" FontSize="13" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>

                        <!-- Action: Initiate Return, Print & PDF -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="🖨️ Print / Preview Bill"
                                    Click="PrintInvoice_Click" />
                            <Button Content="📥 Download PDF"
                                    Click="DownloadPdf_Click" />
                            <Button Content="↩ Process Return"
                                    Command="{x:Bind ViewModel.OpenReturnDialogCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Table Header -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,100,60,70,80,80,90" Padding="8,6" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Product / Composition" FontWeight="Bold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Batch No" FontWeight="Bold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Qty" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Price (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="GST" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Returned" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Total (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Table Items -->
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedSaleDetail.Items, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:SaleDetailItemDto">
                                <Grid ColumnDefinitions="*,100,60,70,80,80,90" Padding="8,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ProductName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BatchNumber}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Quantity}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind UnitPrice, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind TotalGstRate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind AlreadyReturnedQuantity}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource StatusDanger}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind NetAmount, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Invoice Totals Summary Footer -->
                    <Border Grid.Row="3" Background="{ThemeResource SurfaceSubtle}" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SUBTOTAL" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.Subtotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOTAL GST" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.TaxAmount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ROUND OFF" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.RoundOff, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                <TextBlock Text="INVOICE GRAND TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.Total, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{ThemeResource SurfaceBackground}" Padding="16,6">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
        </Border>

        <!-- 4. Sale Return / Credit Note Dialog Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
              Visibility="{x:Bind ViewModel.IsReturnDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{ThemeResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Issue Sale Return / Credit Note" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" Margin="0,0,0,12" />

                    <!-- Header Columns for Return Items -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,100,70,80,140,80" Padding="6,4" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Product" FontWeight="Bold" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Batch" FontWeight="Bold" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="Sold Qty" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Return Qty" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Stock Decision" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Refund (₹)" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Return Items List -->
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ReturnRows, Mode=OneWay}" MaxHeight="240" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReturnItemRowViewModel">
                                <Grid ColumnDefinitions="*,100,70,80,140,80" Padding="4,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ProductName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BatchNumber}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SoldQuantity}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    
                                    <!-- Return Quantity Input -->
                                    <NumberBox Grid.Column="3" Value="{x:Bind ReturnQuantity, Mode=TwoWay}"
                                               Minimum="0" Maximum="{x:Bind MaxReturnableQuantity}"
                                               SpinButtonPlacementMode="Inline" Margin="4,0" SmallChange="1" />

                                    <!-- Restock Decision Dropdown -->
                                    <ComboBox Grid.Column="4" SelectedValue="{x:Bind RestockDecision, Mode=TwoWay}"
                                              SelectedValuePath="Tag" HorizontalAlignment="Stretch" Margin="4,0">
                                        <ComboBoxItem Content="Restock Available" Tag="RestockToAvailable" />
                                        <ComboBoxItem Content="Quarantine Damaged" Tag="QuarantineDamaged" />
                                        <ComboBoxItem Content="Quarantine Expired" Tag="QuarantineExpired" />
                                    </ComboBox>

                                    <TextBlock Grid.Column="5" Text="{x:Bind RefundTotal, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Reason and Refund Mode Controls -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Return Reason:" FontSize="12" FontWeight="SemiBold" />
                            <TextBox Text="{x:Bind ViewModel.ReturnReason, Mode=TwoWay}" PlaceholderText="e.g. Doctor changed prescription / Wrong dose" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Total Refund Payable:" FontSize="12" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="8,6">
                                <TextBlock Text="{x:Bind ViewModel.TotalRefundAmount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Dialog Action Buttons -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="Cancel" Command="{x:Bind ViewModel.CloseReturnDialogCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Confirm Return &amp; Issue Credit Note" Command="{x:Bind ViewModel.ProcessReturnCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
