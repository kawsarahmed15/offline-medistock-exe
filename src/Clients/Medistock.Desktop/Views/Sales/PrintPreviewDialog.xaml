<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Medistock.Desktop.Views.Sales.PrintPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    Title="Invoice Print Preview &amp; Export"
    PrimaryButtonText="🖨️ Quick Print"
    SecondaryButtonText="📥 Download PDF"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="PrintButton_Click"
    SecondaryButtonClick="DownloadPdfButton_Click"
    MinWidth="850"
    MinHeight="650"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" Width="820" Height="580">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="{ThemeResource SurfaceSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Template Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Template:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="TemplateComboBox"
                              ItemsSource="{x:Bind ViewModel.AvailableTemplates, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                              SelectionChanged="TemplateComboBox_SelectionChanged"
                              DisplayMemberPath="Name"
                              Width="220"
                              Height="32" />
                </StackPanel>

                <!-- Target Printer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Target Printer:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="PrinterComboBox"
                              ItemsSource="{x:Bind ViewModel.InstalledPrinters, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPrinter, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="220"
                              Height="32" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Live HTML Rendering Container -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4" Background="#ffffff">
            <WebView2 x:Name="PreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>

        <!-- Bottom Status Line -->
        <Border Grid.Row="2" Padding="4,8,4,0">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
        </Border>
    </Grid>
</ContentDialog>
