<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Medistock.Desktop.Views.Sales.PrintPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    Title="Invoice Print Preview &amp; Export"
    PrimaryButtonText="🖨️ Quick Print"
    SecondaryButtonText="📥 Download PDF"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="PrintButton_Click"
    SecondaryButtonClick="DownloadPdfButton_Click"
    MinWidth="1150"
    MaxWidth="1400"
    MinHeight="800"
    MaxHeight="980"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" Width="1180" Height="780">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="{ThemeResource SurfaceSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                <!-- Template Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Template:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="TemplateComboBox"
                              ItemsSource="{x:Bind ViewModel.AvailableTemplates, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                              SelectionChanged="TemplateComboBox_SelectionChanged"
                              DisplayMemberPath="Name"
                              Width="220"
                              Height="32" />
                </StackPanel>

                <!-- Zoom Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Zoom:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                    <Button Content="−" Width="30" Height="30" Padding="0" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom Out" />
                    <Button x:Name="ZoomPercentButton" Content="100%" Width="52" Height="30" Padding="0" Click="ZoomReset_Click" ToolTipService.ToolTip="Reset Zoom to 100%" />
                    <Button Content="+" Width="30" Height="30" Padding="0" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom In" />
                </StackPanel>

                <!-- Target Printer -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Target Printer:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="PrinterComboBox"
                              ItemsSource="{x:Bind ViewModel.InstalledPrinters, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPrinter, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="220"
                              Height="32" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Live HTML Rendering Container -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4" Background="#ffffff" MinHeight="660">
            <WebView2 x:Name="PreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>

        <!-- Bottom Status Line -->
        <Border Grid.Row="2" Padding="4,8,4,0">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
        </Border>
    </Grid>
</ContentDialog>
