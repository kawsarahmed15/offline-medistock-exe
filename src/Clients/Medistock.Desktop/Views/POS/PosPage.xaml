<Page
    x:Class="Medistock.Desktop.Views.POS.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    xmlns:q="using:Medistock.Application.Products.Queries"
    xmlns:cust="using:Medistock.Application.Customers.DTOs"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}"
    PointerPressed="PageBackground_PointerPressed">

    <Page.Resources>
        <ThemeShadow x:Key="SharedShadow" />
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MaxHeight" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="TextBoxDeleteButtonStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MaxHeight" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" PointerPressed="PageBackground_PointerPressed">
        <!-- 1. Top Chrome-Style Multi-Invoice Tabs Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource SurfaceBackground}" Padding="12,6,12,4" ColumnDefinitions="Auto,*,Auto">
            <!-- App / POS Brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="MEDISTOCK" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2">
                    <TextBlock Text="MARG POS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                </Border>
            </StackPanel>

            <!-- Invoice Tabs Strip (Chrome style) -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Previous Tab Button (◀) -->
                    <Button ToolTipService.ToolTip="Previous Bill (Ctrl+Shift+Tab / Ctrl+PageUp)"
                            Command="{x:Bind ViewModel.PreviousTabCommand}"
                            Background="Transparent"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="4"
                            FontSize="11"
                            Padding="8,5"
                            Content="◀"
                            IsTabStop="False" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.InvoiceTabs, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InvoiceTabViewModel">
                                <Border Background="{x:Bind TabBackgroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderBrush="{x:Bind TabBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,0,0"
                                        Padding="10,6,8,6"
                                        PointerPressed="TabHeader_PointerPressed"
                                        Tag="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📄" FontSize="11" VerticalAlignment="Center" Foreground="{x:Bind TabForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" />
                                        <TextBlock Text="{x:Bind TabTitle, Mode=OneWay}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{x:Bind TabForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" />
                                        <Border Background="{x:Bind TabBadgeBackgroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" CornerRadius="999" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind GrandTotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N0}'}"
                                                       FontSize="11" FontWeight="Bold" Foreground="{x:Bind TabBadgeForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" />
                                        </Border>
                                        <Button Content="✕"
                                                Click="CloseTabButton_Click"
                                                Tag="{x:Bind}"
                                                Background="Transparent"
                                                Foreground="{x:Bind TabCloseForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                FontSize="10"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Next Tab Button (▶) -->
                    <Button ToolTipService.ToolTip="Next Bill (Ctrl+Tab / Ctrl+PageDown)"
                            Command="{x:Bind ViewModel.NextTabCommand}"
                            Background="Transparent"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="4"
                            FontSize="11"
                            Padding="8,5"
                            Content="▶"
                            IsTabStop="False" />

                    <!-- New Tab (+) Button -->
                    <Button Content="+ New Bill (Ctrl+T)"
                            Command="{x:Bind ViewModel.AddNewTabCommand}"
                            Background="Transparent"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="4"
                            FontSize="11"
                            Padding="8,5"
                            Margin="4,0,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Top Action Toolbar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="➕ [F2] Add Item"
                        Command="{x:Bind ViewModel.OpenCreateProductModalCommand}"
                        Background="{ThemeResource AccentSubtle}"
                        Foreground="{ThemeResource AccentPrimary}"
                        BorderBrush="{ThemeResource AccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="4"
                        FontSize="11"
                        FontWeight="Bold"
                        Padding="8,4" />
                <Button Content="[F1] Shortcuts"
                        Command="{x:Bind ViewModel.ToggleShortcutHelpCommand}"
                        Background="Transparent"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="4"
                        FontSize="11"
                        Padding="8,4" />
                <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="{x:Bind ViewModel.CashierName, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Invoice Header & Customer Metadata Ribbon (Marg ERP Header Bar) -->
        <Border Grid.Row="1" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,1" Padding="12,8" Margin="0,2,0,0">
            <Grid ColumnDefinitions="140,110,1.8*,130,1.4*,130,Auto" ColumnSpacing="8">
                <!-- Invoice No & Date -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Active Invoice" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.TabTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                </StackPanel>

                <!-- Date / Time (Read-only Today Date) -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Date [Today]" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                    <TextBox x:Name="InvoiceDateBox"
                             Text="{x:Bind ViewModel.ActiveTab.InvoiceDateString, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Background="{ThemeResource SurfaceSubtle}"
                             Foreground="{ThemeResource TextSecondary}"
                             FontSize="13"
                             Height="34"
                             Padding="8,4" />
                </StackPanel>

                <!-- Customer Details with Quick Pick Autocomplete -->
                <Grid Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Customer Name [Enter / Search]" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBox x:Name="CustomerBox"
                                 Text="{x:Bind ViewModel.ActiveTab.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="WALK-IN CUSTOMER (Type to search)"
                                 CharacterCasing="Upper"
                                 FontSize="13"
                                 Height="34"
                                 Padding="8,4"
                                 GotFocus="CartCell_GotFocus"
                                 LostFocus="CartCell_LostFocus"
                                 TextChanged="CustomerBox_TextChanged"
                                 KeyDown="CustomerBox_KeyDown" />
                    </StackPanel>

                    <!-- Floating Customer Autocomplete / Quick Pick Popup -->
                    <Popup x:Name="CustomerQuickPickPopup"
                           IsOpen="{x:Bind ViewModel.IsCustomerQuickPickOpen, Mode=OneWay}"
                           VerticalOffset="52"
                           HorizontalOffset="0"
                           IsLightDismissEnabled="False">
                        <Border Width="380"
                                MaxHeight="260"
                                Background="{ThemeResource SurfaceBackground}"
                                BorderBrush="{ThemeResource BorderStrong}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Shadow="{StaticResource SharedShadow}">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="{ThemeResource SurfaceBackgroundSecondary}" Padding="10,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Quick Pick Customer (↑/↓ to choose, Enter to select)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="[Esc: Dismiss]" FontSize="10" Foreground="{ThemeResource TextMuted}" />
                                </Grid>

                                <!-- Customer List -->
                                <ListView Grid.Row="1"
                                          x:Name="CustomerSuggestionsList"
                                          ItemsSource="{x:Bind ViewModel.CustomerSuggestions, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedCustomerSuggestionIndex, Mode=TwoWay}"
                                          ItemClick="CustomerSuggestionsList_ItemClick"
                                          IsItemClickEnabled="True"
                                          SelectionMode="Single"
                                          Padding="0,4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="cust:CustomerDto">
                                            <Grid ColumnDefinitions="*,Auto" Padding="6,4">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                                                    <TextBlock Text="{x:Bind Phone, TargetNullValue='No Mobile'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind City, TargetNullValue=''}" FontSize="11" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind CurrentBalance, Converter={StaticResource StringFormatConverter}, ConverterParameter='Bal: ₹{0:N0}'}"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Customer Mobile -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Mobile No [Enter]" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                    <TextBox x:Name="CustomerMobileBox"
                             Text="{x:Bind ViewModel.ActiveTab.CustomerMobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="10-digit Mobile"
                             FontSize="13"
                             Height="34"
                             Padding="8,4"
                             GotFocus="CartCell_GotFocus"
                             LostFocus="CartCell_LostFocus"
                             KeyDown="CustomerMobileBox_KeyDown" />
                </StackPanel>

                <!-- Doctor / Rx Ref -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Doctor / Rx Ref [Enter]" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                    <TextBox x:Name="DoctorBox"
                             Text="{x:Bind ViewModel.ActiveTab.DoctorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="DR. NAME / RX NO"
                             CharacterCasing="Upper"
                             FontSize="13"
                             Height="34"
                             Padding="8,4"
                             GotFocus="CartCell_GotFocus"
                             LostFocus="CartCell_LostFocus"
                             KeyDown="DoctorBox_KeyDown" />
                </StackPanel>

                <!-- Payment Mode -->
                <StackPanel Grid.Column="5">
                    <TextBlock Text="Payment Mode [Enter]" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                    <ComboBox x:Name="PaymentModeBox"
                              SelectedIndex="{x:Bind ViewModel.ActiveTab.PaymentModeIndex, Mode=TwoWay}"
                              Height="34"
                              FontSize="13"
                              HorizontalAlignment="Stretch"
                              KeyDown="PaymentModeBox_KeyDown">
                        <ComboBoxItem Content="Cash" />
                        <ComboBoxItem Content="UPI / QR" />
                        <ComboBoxItem Content="Card" />
                        <ComboBoxItem Content="Credit" />
                    </ComboBox>
                </StackPanel>

                <!-- Interstate Checkbox -->
                <CheckBox Grid.Column="6"
                          IsChecked="{x:Bind ViewModel.ActiveTab.IsInterstate, Mode=TwoWay}"
                          Content="Interstate (IGST)"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,10,0,0" />
            </Grid>
        </Border>

        <!-- 3. Medicine Search Bar -->
        <Grid Grid.Row="2" Margin="12,8,12,6">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="🔍 [F3] Type Medicine Name, Generic / Salt, or Scan Barcode... [F2: Create, Enter on Blank: Settle, ↑/↓: Navigate]"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Height="42"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     BorderThickness="2"
                     BorderBrush="{ThemeResource AccentPrimary}"
                     KeyDown="SearchBox_KeyDown" />

            <!-- Stage 1 Floating Search Dropdown Table (Marg Style) -->
            <Popup x:Name="SearchResultsPopup"
                   IsOpen="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}"
                   VerticalOffset="44"
                   HorizontalOffset="0"
                   IsLightDismissEnabled="False">
                <Border Width="1100"
                        MaxHeight="300"
                        Background="{ThemeResource SurfaceBackground}"
                        BorderBrush="{ThemeResource BorderStrong}"
                        BorderThickness="1.5"
                        CornerRadius="4"
                        Shadow="{StaticResource SharedShadow}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Table Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="2*,1.5*,85,95,85,75,80,80,75" Background="{ThemeResource SurfaceSubtle}" Padding="10,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                            <TextBlock Grid.Column="0" Text="Medicine / Product Name" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="Generic / Salt" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBlock Grid.Column="2" Text="Pack" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBlock Grid.Column="3" Text="Batch No" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBlock Grid.Column="4" Text="Expiry" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBlock Grid.Column="5" Text="Stock" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="MRP (₹)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="Rate (₹)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="8" Text="Schedule" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" />
                        </Grid>

                        <!-- Live Items -->
                        <ListView Grid.Row="1"
                                  x:Name="SearchResultsList"
                                  ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                  SelectionMode="Single"
                                  SelectedIndex="{x:Bind ViewModel.SelectedSearchIndex, Mode=TwoWay}"
                                  IsItemClickEnabled="True"
                                  ItemClick="SearchResults_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductSearchItemViewModel">
                                    <Border Background="{x:Bind RowBackgroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                            BorderBrush="{x:Bind RowBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="1,1">
                                        <Grid ColumnDefinitions="2*,1.5*,85,95,85,75,80,80,75" Padding="8,5">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                                <Border Background="#DC2626" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind HasExpiryBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind ExpiryBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind GenericName}" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind PackSizeDescription}" FontSize="12" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind BatchNumber, TargetNullValue='DEFAULT'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind ExpiryDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ExpiryForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind StockDisplay}" FontWeight="Bold" FontSize="12.5" Foreground="{x:Bind StockForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind Mrp, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="7" Text="{x:Bind SaleRate, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Border Grid.Column="8" Background="{ThemeResource SurfaceSubtle}" CornerRadius="2" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Schedule}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <!-- 4. Main Marg ERP Billing Data Grid (Rows & Columns) -->
        <Border Grid.Row="3" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderStrong}" BorderThickness="1" Margin="12,4,12,4">
            <Grid RowDefinitions="Auto,*">
                <!-- Grid Table Header (Marg Style) - 13 Columns without GST% and Del -->
                <Grid Grid.Row="0" ColumnDefinitions="40,2.5*,85,100,80,70,70,65,85,85,90,70,110"
                      Background="{ThemeResource SurfaceSubtle}"
                      Padding="8,8"
                      BorderBrush="{ThemeResource BorderStrong}"
                      BorderThickness="0,0,0,1">
                    <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Medicine / Item Description" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" />
                    <TextBlock Grid.Column="2" Text="Pack" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" />
                    <TextBlock Grid.Column="3" Text="Batch No" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" />
                    <TextBlock Grid.Column="4" Text="Expiry" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" />
                    <TextBlock Grid.Column="5" Text="Strip" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="Tab/Qty" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="Free" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="MRP (₹)" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="9" Text="Rate (₹)" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="10" Text="Gross (₹)" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="11" Text="Disc %" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="12" Text="Net Amount (₹)" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" />
                </Grid>

                <!-- Billing Grid Rows (Marg ERP DataGrid) -->
                <ListView Grid.Row="1"
                          x:Name="CartListView"
                          ItemsSource="{x:Bind ViewModel.ActiveTab.CartItems, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectedIndex="{x:Bind ViewModel.ActiveTab.SelectedCartIndex, Mode=TwoWay}"
                          KeyDown="CartListView_KeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CartItemViewModel">
                            <Grid ColumnDefinitions="40,2.5*,85,100,80,70,70,65,85,85,90,70,110"
                                  Padding="8,0"
                                  Height="40"
                                  BorderBrush="{ThemeResource BorderDefault}"
                                  BorderThickness="0,0,0,1">
                                <!-- Row Index Number (#) -->
                                <TextBlock Grid.Column="0" Text="{x:Bind LineNumber, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Medicine Name -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{x:Bind ProductName}" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource TextPrimary}" />
                                </StackPanel>

                                <!-- Pack -->
                                <TextBlock Grid.Column="2" Text="{x:Bind PackSizeDescription}" FontSize="13.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />

                                <!-- Batch No -->
                                <TextBlock Grid.Column="3" Text="{x:Bind BatchNumber}" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />

                                <!-- Expiry Date -->
                                <TextBlock Grid.Column="4" Text="{x:Bind ExpiryDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:MM/yy}'}" FontSize="13.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />

                                <!-- Strip Quantity Edit Box -->
                                <NumberBox x:Name="RowStripBox"
                                           Grid.Column="5"
                                           Value="{x:Bind StripQuantityDouble, Mode=TwoWay}"
                                           Minimum="0"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Hidden"
                                           Height="40"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           Margin="0"
                                           Padding="6,0"
                                           CornerRadius="0"
                                           BorderThickness="0.5"
                                           BorderBrush="{ThemeResource BorderDefault}"
                                           GotFocus="CartCell_GotFocus"
                                           LostFocus="CartCell_LostFocus"
                                           PreviewKeyDown="CartRow_Cell_PreviewKeyDown"
                                           KeyDown="CartRow_Strip_KeyDown" />

                                <!-- Tab / Qty Edit Box -->
                                <NumberBox x:Name="RowTabBox"
                                           Grid.Column="6"
                                           Value="{x:Bind TabQuantityDouble, Mode=TwoWay}"
                                           Minimum="0"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Hidden"
                                           Height="40"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           Margin="0"
                                           Padding="6,0"
                                           CornerRadius="0"
                                           BorderThickness="0.5"
                                           BorderBrush="{ThemeResource BorderDefault}"
                                           GotFocus="CartCell_GotFocus"
                                           LostFocus="CartCell_LostFocus"
                                           PreviewKeyDown="CartRow_Cell_PreviewKeyDown"
                                           KeyDown="CartRow_Tab_KeyDown" />

                                <!-- Free Qty Edit Box -->
                                <NumberBox x:Name="RowFreeBox"
                                           Grid.Column="7"
                                           Value="{x:Bind FreeQuantityDouble, Mode=TwoWay}"
                                           Minimum="0"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Hidden"
                                           Height="40"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           Margin="0"
                                           Padding="6,0"
                                           CornerRadius="0"
                                           BorderThickness="0.5"
                                           BorderBrush="{ThemeResource BorderDefault}"
                                           GotFocus="CartCell_GotFocus"
                                           LostFocus="CartCell_LostFocus"
                                           PreviewKeyDown="CartRow_Cell_PreviewKeyDown"
                                           KeyDown="CartRow_Free_KeyDown" />

                                <!-- MRP -->
                                <TextBlock Grid.Column="8" Text="{x:Bind Mrp, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />

                                <!-- Rate Edit Box -->
                                <NumberBox x:Name="RowRateBox"
                                           Grid.Column="9"
                                           Value="{x:Bind UnitPriceDouble, Mode=TwoWay}"
                                           Minimum="0"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Hidden"
                                           Height="40"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           Margin="0"
                                           Padding="6,0"
                                           CornerRadius="0"
                                           BorderThickness="0.5"
                                           BorderBrush="{ThemeResource BorderDefault}"
                                           GotFocus="CartCell_GotFocus"
                                           LostFocus="CartCell_LostFocus"
                                           PreviewKeyDown="CartRow_Cell_PreviewKeyDown"
                                           KeyDown="CartRow_Rate_KeyDown" />

                                <!-- Gross Amount -->
                                <TextBlock Grid.Column="10" Text="{x:Bind GrossAmount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />

                                <!-- Discount % Edit Box -->
                                <NumberBox x:Name="RowDiscBox"
                                           Grid.Column="11"
                                           Value="{x:Bind DiscountPercentDouble, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="100"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Hidden"
                                           Height="40"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           Margin="0"
                                           Padding="6,0"
                                           CornerRadius="0"
                                           BorderThickness="0.5"
                                           BorderBrush="{ThemeResource BorderDefault}"
                                           GotFocus="CartCell_GotFocus"
                                           LostFocus="CartCell_LostFocus"
                                           PreviewKeyDown="CartRow_Cell_PreviewKeyDown"
                                           KeyDown="CartRow_Disc_KeyDown" />

                                <!-- Net Amount Column -->
                                <TextBlock Grid.Column="12" Text="{x:Bind NetAmount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="14.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 5. Bottom Marg ERP Calculation Summary & Hotkey Settlement Ribbon -->
        <Border Grid.Row="4" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderStrong}" BorderThickness="0,1,0,1" Padding="14,10" Margin="0,2,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Items & Qty Counters -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Total Items" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTab.TotalItemsCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Total Quantity" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTab.TotalQuantity, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Middle: Subtotal, Bill Discounts (% and Flat ₹), Total Discount -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Subtotal Gross -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Subtotal (Gross)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTab.Subtotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Bill Disc % Input -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Disc %" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                        <NumberBox x:Name="BottomBar_DiscountPercentBox"
                                   Value="{x:Bind ViewModel.ActiveTab.BillDiscountPercentDouble, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="100"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Hidden"
                                   Width="80"
                                   Height="32"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   HorizontalContentAlignment="Center"
                                   VerticalAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   GotFocus="CartCell_GotFocus"
                                   LostFocus="CartCell_LostFocus"
                                   ValueChanged="BottomBar_DiscountPercentBox_ValueChanged"
                                   PreviewKeyDown="BottomBar_DiscountBox_PreviewKeyDown"
                                   KeyDown="BottomBar_DiscountBox_KeyDown" />
                    </StackPanel>

                    <!-- Bill Disc Flat ₹ Input -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Disc (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                        <NumberBox x:Name="BottomBar_DiscountFlatBox"
                                   Value="{x:Bind ViewModel.ActiveTab.BillDiscountAmountDouble, Mode=TwoWay}"
                                   Minimum="0"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Hidden"
                                   Width="95"
                                   Height="32"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   HorizontalContentAlignment="Center"
                                   VerticalAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   GotFocus="CartCell_GotFocus"
                                   LostFocus="CartCell_LostFocus"
                                   ValueChanged="BottomBar_DiscountFlatBox_ValueChanged"
                                   PreviewKeyDown="BottomBar_DiscountBox_PreviewKeyDown"
                                   KeyDown="BottomBar_DiscountBox_KeyDown" />
                    </StackPanel>

                    <!-- Total Discount Display (Line items + Bill Discount + %) -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Total Discount" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveTab.TotalDiscountDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource StatusWarning}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Net Payable Highlight & Settle Button (F6) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AccentSubtle}" CornerRadius="6" Padding="18,8" BorderBrush="{ThemeResource AccentPrimary}" BorderThickness="1.5">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="NET PAYABLE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveTab.GrandTotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}"
                                       FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>

                    <!-- Pay Button (F6) -->
                    <Button x:Name="BottomBar_PayAndPrintButton"
                            Click="PayAndPrintBottomBar_Click"
                            Background="{ThemeResource AccentPrimary}"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="18,10"
                            Height="50"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="[F6] PAY &amp; PRINT" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. Status Message Strip -->
        <Border Grid.Row="5" Background="{ThemeResource SurfaceSubtle}" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Shortcuts: [F3] Search | [F2] Add Item | [F6] Pay | [Ctrl+P] Print | [F7] Sale History | [F1] Help" FontSize="12" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 7. Keyboard Shortcut Help Modal Dialog (F1 Overlay) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#80000000"
              Canvas.ZIndex="1500"
              Visibility="{x:Bind ViewModel.IsShortcutHelpOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="600"
                    MaxHeight="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Title -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="⌨ Complete Keyboard Shortcuts Reference" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            <TextBlock Text="High-speed Marg ERP keyboard hotkeys for instant billing" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{x:Bind ViewModel.CloseShortcutHelpCommand}" Background="Transparent" BorderThickness="0" FontSize="14" />
                    </Grid>

                    <!-- Shortcuts Content Table -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <!-- Multi-Tab Invoicing -->
                            <TextBlock Text="1. MULTI-INVOICE TAB SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F9 / Ctrl+Tab" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Switch to next invoice tab" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F8 / Ctrl+Shift+Tab" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Switch to previous invoice tab" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Ctrl + T" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Open new invoice tab" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="3" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Ctrl + W / Ctrl + F4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Close active invoice tab (smart discard check)" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="4" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Alt + 1 .. 9" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Direct jump to invoice tab 1 to 9" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="5" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Ctrl+PgDn / Ctrl+PgUp" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Alternate next / previous tab navigation" FontSize="12" Margin="8,2" />
                            </Grid>

                            <!-- Navigation & Data Entry -->
                            <TextBlock Text="2. MEDICINE SEARCH &amp; CART DATA ENTRY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Focus medicine search box / barcode scan" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Create New Medicine Master &amp; Opening Batch on-the-fly" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="↑ / ↓ (Arrows)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Navigate search results &amp; FEFO batch list" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="3" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Enter" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Select item / pick batch / focus next cell" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="4" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="→ / ← (Arrows)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Increase (+1) / Decrease (-1) item quantity" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="5" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Delete" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Remove selected row from bill" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="6" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Insert" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Insert line item before selected row" FontSize="12" Margin="8,2" />
                            </Grid>

                            <!-- Settle & Financial -->
                            <TextBlock Text="3. SETTLEMENT, PRINT &amp; SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F6 / Ctrl+S / End" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Open Settlement Dialog (Save &amp; Next / Save &amp; Print)" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F7 / Ctrl + P" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Open Tax Invoice Print Preview &amp; PDF Download" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Hold active bill" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="3" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Recall held bills" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="4" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="Esc" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Close active modal dialog / cancel action" FontSize="12" Margin="8,2" />

                                <Border Grid.Row="5" Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="6,2"><TextBlock Text="F1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Show / hide this shortcuts reference" FontSize="12" Margin="8,2" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Close -->
                    <Button Grid.Row="2" Content="Close [Esc]" Command="{x:Bind ViewModel.CloseShortcutHelpCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- 8. On-The-Fly Item Creation Modal Dialog (F2 Overlay) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#80000000"
              Canvas.ZIndex="2000"
              Visibility="{x:Bind ViewModel.IsCreateProductModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Width="720"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="➕ [F2] Fast Item Master &amp; Opening Batch Creation" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            <TextBlock Text="Instantly registers medicine and opening stock batch into SQLite and active bill" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{x:Bind ViewModel.CloseCreateProductModalCommand}" Background="Transparent" BorderThickness="0" FontSize="14" IsTabStop="False" />
                    </Grid>

                    <!-- Content Form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Padding="0,4">
                            <!-- Form Error Banner -->
                            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="10,6"
                                    Visibility="{x:Bind ViewModel.CreateProductFormError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.CreateProductFormError, Mode=OneWay}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Row 1: Medicine Name & Brand -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Medicine / Product Name *" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewProductNameBox" TabIndex="1" Text="{x:Bind ViewModel.NewProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Azithral 500mg Tablet" FontSize="13" KeyDown="CreateProductInput_KeyDown" Loaded="NewProductNameBox_Loaded" />
                                    <TextBlock Text="{x:Bind ViewModel.NewProductNameError, Mode=OneWay}" Foreground="{ThemeResource AccentDanger}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.NewProductNameError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Generic / Salt Formulation" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewGenericNameBox" TabIndex="2" Text="{x:Bind ViewModel.NewGenericName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Azithromycin 500mg" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Pack Size / Breakdown, Base Unit, Manufacturer -->
                            <Grid ColumnDefinitions="140,90,*">
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Pack (e.g. 10x10, 10x5x5) *" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewPackSizeTextBox" TabIndex="3" Text="{x:Bind ViewModel.NewPackSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="10x10" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                    <TextBlock Text="{x:Bind ViewModel.NewPackSizeTextError, Mode=OneWay}" Foreground="{ThemeResource AccentDanger}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.NewPackSizeTextError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Base Unit" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewBaseUnitBox" TabIndex="4" Text="{x:Bind ViewModel.NewBaseUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="TAB" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Company / Manufacturer" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewManufacturerNameBox" TabIndex="5" Text="{x:Bind ViewModel.NewManufacturerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Alembic Pharma" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: HSN, GST %, Barcode -->
                            <Grid ColumnDefinitions="120,120,*">
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="HSN Code" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewHsnCodeBox" TabIndex="6" Text="{x:Bind ViewModel.NewHsnCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="3004" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="GST Rate (%)" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <NumberBox x:Name="NewGstPercentBox" TabIndex="7" Value="{x:Bind ViewModel.NewGstPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Inline" SmallChange="1" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Barcode (Optional)" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewBarcodeBox" TabIndex="8" Text="{x:Bind ViewModel.NewBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Scan or type barcode" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: Opening Batch Details Banner -->
                            <Border Background="{ThemeResource SurfaceSubtle}" Padding="8,4" CornerRadius="4" Margin="0,6,0,0">
                                <TextBlock Text="📦 OPENING BATCH &amp; INVENTORY DETAILS" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            </Border>

                            <!-- Row 5: Batch Number & Expiry Date -->
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Batch Number *" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="NewBatchNumberBox" TabIndex="9" Text="{x:Bind ViewModel.NewBatchNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. B2401" FontSize="13" KeyDown="CreateProductInput_KeyDown" />
                                    <TextBlock Text="{x:Bind ViewModel.NewBatchNumberError, Mode=OneWay}" Foreground="{ThemeResource AccentDanger}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.NewBatchNumberError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Expiry Date" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <DatePicker x:Name="NewExpiryDatePicker" TabIndex="10" Date="{x:Bind ViewModel.NewExpiryDate, Mode=TwoWay}" HorizontalAlignment="Stretch" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 6: MRP, Purchase Rate, Sale Rate, Opening Stock Qty, Min Stock Alert -->
                            <Grid ColumnDefinitions="*,*,*,*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="MRP (₹) *" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <NumberBox x:Name="NewMrpBox" TabIndex="11" Value="{x:Bind ViewModel.NewMrp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" KeyDown="CreateProductInput_KeyDown" />
                                    <TextBlock Text="{x:Bind ViewModel.NewMrpError, Mode=OneWay}" Foreground="{ThemeResource AccentDanger}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.NewMrpError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="Purchase (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <NumberBox x:Name="NewPurchaseRateBox" TabIndex="12" Value="{x:Bind ViewModel.NewPurchaseRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="Sale Rate (₹) *" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <NumberBox x:Name="NewSaleRateBox" TabIndex="13" Value="{x:Bind ViewModel.NewSaleRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" KeyDown="CreateProductInput_KeyDown" />
                                    <TextBlock Text="{x:Bind ViewModel.NewSaleRateError, Mode=OneWay}" Foreground="{ThemeResource AccentDanger}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.NewSaleRateError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                    <TextBlock Text="Opening Qty *" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <NumberBox x:Name="NewOpeningQtyBox" TabIndex="14" Value="{x:Bind ViewModel.NewOpeningQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="4,0,0,0">
                                    <TextBlock Text="Min Alert Qty" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                    <NumberBox x:Name="NewMinStockAlertBox" TabIndex="15" Value="{x:Bind ViewModel.NewMinStockAlert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" Minimum="1" SmallChange="1" KeyDown="CreateProductInput_KeyDown" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Action Buttons -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="Press [Enter / F2] to Save &amp; Insert into Bill | [Esc] Cancel" FontSize="11" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                        <Button x:Name="CancelCreateProductButton" TabIndex="15" Content="Cancel [Esc]" Command="{x:Bind ViewModel.CloseCreateProductModalCommand}" Margin="0,0,8,0" KeyDown="CreateProductInput_KeyDown" />
                        <Button x:Name="SaveCreateProductButton" TabIndex="16" Content="✔ Save &amp; Add to Bill [Enter]" Click="SaveCreateProductButton_Click" Style="{StaticResource AccentButtonStyle}" FontWeight="Bold" KeyDown="CreateProductInput_KeyDown" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 8.5. Credit Sale Party Selection Dialog (Marg ERP Style) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#80000000"
              Canvas.ZIndex="2100"
              Visibility="{x:Bind ViewModel.IsPartyPickerOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Width="740"
                    MaxHeight="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="👤 [CREDIT SALE] Select Ledger Party / Debtor" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            <TextBlock Text="Select existing credit customer or press [F2] to add new party" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{x:Bind ViewModel.ClosePartyPickerCommand}" Background="Transparent" BorderThickness="0" FontSize="14" IsTabStop="False" />
                    </Grid>

                    <!-- Search and Fast Add Header Bar -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBox x:Name="PartySearchBox"
                                 Grid.Column="0"
                                 PlaceholderText="🔍 Type Party Name, Mobile No, or City... [↑/↓ Navigate, Enter Select]"
                                 Text="{x:Bind ViewModel.PartySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13"
                                 Margin="0,0,8,0"
                                 KeyDown="PartySearchBox_KeyDown"
                                 Loaded="PartySearchBox_Loaded" />
                        <Button Grid.Column="1"
                                Content="➕ New Party [F2]"
                                Command="{x:Bind ViewModel.OpenCreatePartyModalCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                FontWeight="SemiBold"
                                FontSize="12"
                                IsTabStop="False" />
                    </Grid>

                    <!-- Party Table List -->
                    <Border Grid.Row="2" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource SurfaceSubtle}">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Table Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="2*,1.2*,1.2*,100,100" Background="{ThemeResource SurfaceBackgroundSecondary}" Padding="10,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="Party Name" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="Mobile No" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="2" Text="City / Area" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="3" Text="Balance (₹)" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="4" Text="Credit Limit" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextSecondary}" />
                            </Grid>

                            <!-- Results List -->
                            <ListView x:Name="PartySearchList"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.PartySearchResults, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedPartyIndex, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      ItemClick="PartySearchList_ItemClick"
                                      KeyDown="PartySearchList_KeyDown">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="cust:CustomerDto">
                                        <Grid ColumnDefinitions="2*,1.2*,1.2*,100,100" Padding="0,4">
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Phone}" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind City}" FontSize="11" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind CurrentBalance, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{ThemeResource AccentDanger}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CreditLimit, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N0}'}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Footer Help & Action -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="[Enter] Select Party &amp; Start Bill | [F2] Create New Party | [Esc] Back" FontSize="11" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cancel [Esc]" Command="{x:Bind ViewModel.ClosePartyPickerCommand}" FontSize="12" IsTabStop="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 8.6. Fast Party Creation Sub-Modal Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#80000000"
              Canvas.ZIndex="2200"
              Visibility="{x:Bind ViewModel.IsCreatePartyModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Width="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="➕ Register New Credit Customer / Party" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            <TextBlock Text="Instantly adds party ledger into database and selects for current bill" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{x:Bind ViewModel.CloseCreatePartyModalCommand}" Background="Transparent" BorderThickness="0" FontSize="14" IsTabStop="False" />
                    </Grid>

                    <!-- Content Form -->
                    <StackPanel Grid.Row="1" Spacing="10" Padding="0,4">
                        <!-- Form Error Banner -->
                        <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="10,6"
                                Visibility="{x:Bind ViewModel.CreatePartyFormError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.CreatePartyFormError, Mode=OneWay}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Row 1: Party Name -->
                        <StackPanel>
                            <TextBlock Text="Party / Customer Name *" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                            <TextBox x:Name="NewPartyNameBox" TabIndex="1" Text="{x:Bind ViewModel.NewPartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Dr. A. K. Sharma Clinic" FontSize="13" KeyDown="CreatePartyInput_KeyDown" Loaded="NewPartyNameBox_Loaded" />
                            <TextBlock Text="{x:Bind ViewModel.NewPartyNameError, Mode=OneWay}" Foreground="{ThemeResource AccentDanger}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.NewPartyNameError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Row 2: Mobile No & City -->
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Mobile Number *" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                <TextBox x:Name="NewPartyPhoneBox" TabIndex="2" Text="{x:Bind ViewModel.NewPartyPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="10-digit mobile" FontSize="13" KeyDown="CreatePartyInput_KeyDown" />
                                <TextBlock Text="{x:Bind ViewModel.NewPartyPhoneError, Mode=OneWay}" Foreground="{ThemeResource AccentDanger}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{x:Bind ViewModel.NewPartyPhoneError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="City / Area" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                <TextBox x:Name="NewPartyCityBox" TabIndex="3" Text="{x:Bind ViewModel.NewPartyCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Delhi" FontSize="13" KeyDown="CreatePartyInput_KeyDown" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Address -->
                        <StackPanel>
                            <TextBlock Text="Full Address (Optional)" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                            <TextBox x:Name="NewPartyAddressBox" TabIndex="4" Text="{x:Bind ViewModel.NewPartyAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Shop/Clinic address" FontSize="13" KeyDown="CreatePartyInput_KeyDown" />
                        </StackPanel>

                        <!-- Row 4: Credit Limit & Opening Balance -->
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Credit Limit (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                <NumberBox x:Name="NewPartyCreditLimitBox" TabIndex="5" Value="{x:Bind ViewModel.NewPartyCreditLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" KeyDown="CreatePartyInput_KeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Opening Balance (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                <NumberBox x:Name="NewPartyOpeningBalanceBox" TabIndex="6" Value="{x:Bind ViewModel.NewPartyOpeningBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Compact" KeyDown="CreatePartyInput_KeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="GSTIN (Optional)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondary}" Margin="0,0,0,2" />
                                <TextBox x:Name="NewPartyGstinBox" TabIndex="7" Text="{x:Bind ViewModel.NewPartyGstin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="15-digit GST" FontSize="13" KeyDown="CreatePartyInput_KeyDown" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Footer Action Buttons -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="Press [Enter] to Save &amp; Select Party | [Esc] Cancel" FontSize="11" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                        <Button x:Name="CancelCreatePartyButton" TabIndex="8" Content="Cancel [Esc]" Command="{x:Bind ViewModel.CloseCreatePartyModalCommand}" Margin="0,0,8,0" KeyDown="CreatePartyInput_KeyDown" />
                        <Button x:Name="SaveCreatePartyButton" TabIndex="9" Content="✔ Save &amp; Select [Enter]" Click="SaveCreatePartyButton_Click" Style="{StaticResource AccentButtonStyle}" FontWeight="Bold" KeyDown="CreatePartyInput_KeyDown" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 9. Payment & Settlement Dialog (F6 / Ctrl+S / Pay & Print) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#B3000000"
              Canvas.ZIndex="2500"
              Visibility="{x:Bind ViewModel.IsSaveConfirmationOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- Title & Invoice Strip -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AccentSubtle}" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="💳 PAYMENT &amp; SETTLEMENT" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.ActiveTab.DisplayInvoiceNo, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Click="CancelSaveButton_Click" Background="Transparent" BorderThickness="0" FontSize="14" />
                    </Grid>

                    <!-- Bill Summary Card -->
                    <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,16">
                        <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="6" Padding="14,12" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer Name &amp; Phone:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.CustomerName, Mode=OneWay, FallbackValue='Walk-in Customer'}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.CustomerMobile, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextMuted}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Items / Quantity:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.TotalItemsCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} Item(s)'}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.TotalQuantity, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='({0} Qty)'}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Subtotal (Gross):" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.Subtotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Discount:" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource StatusWarning}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.TotalDiscountDisplay, Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold" Foreground="{ThemeResource StatusWarning}" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment Mode:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <Border Grid.Row="4" Grid.Column="1" Background="{ThemeResource AccentSubtle}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.PaymentMode, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                </Border>

                                <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="GRAND TOTAL (NET PAYABLE):" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.GrandTotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}"
                                           FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Modal Actions Footer -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,*">
                        <Button Grid.Column="0"
                                x:Name="CancelSaveButton"
                                Content="✕ Cancel [Esc]"
                                Click="CancelSaveButton_Click"
                                KeyDown="SaveConfirmationBtn_KeyDown"
                                PreviewKeyDown="SaveConfirmationBtn_PreviewKeyDown"
                                Margin="0,0,8,0"
                                Height="40" />
                        <Button Grid.Column="1"
                                x:Name="SaveAndPrintButton"
                                Content="🖨️ Save &amp; Print"
                                Click="SaveAndPrintButton_Click"
                                KeyDown="SaveConfirmationBtn_KeyDown"
                                PreviewKeyDown="SaveConfirmationBtn_PreviewKeyDown"
                                Margin="0,0,8,0"
                                Height="40"
                                FontWeight="SemiBold" />
                        <Button Grid.Column="2"
                                x:Name="ConfirmSaveButton"
                                Content="✔ Save &amp; Next Invoice [Enter]"
                                Click="ConfirmSaveButton_Click"
                                KeyDown="SaveConfirmationBtn_KeyDown"
                                PreviewKeyDown="SaveConfirmationBtn_PreviewKeyDown"
                                Style="{StaticResource AccentButtonStyle}"
                                FontWeight="Bold"
                                Height="40" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 10. FEFO Batch Picker Modal Dialog (Opens when selected product has multiple batches) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#80000000"
              Canvas.ZIndex="2200"
              Visibility="{x:Bind ViewModel.IsBatchPickerOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Width="780"
                    MaxHeight="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Title Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="📦 Select Medicine Batch (FEFO Order):" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedProductForBatches.Name, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="Navigate batches with [↑/↓] arrows, press [Enter] to select batch, [Esc] to cancel" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{x:Bind ViewModel.CloseBatchPickerCommand}" Background="Transparent" BorderThickness="0" FontSize="14" />
                    </Grid>

                    <!-- Table Header -->
                    <Grid Grid.Row="1" ColumnDefinitions="1.5*,1.2*,1*,1*,1*,1*" Background="{ThemeResource SurfaceSubtle}" Padding="12,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                        <TextBlock Grid.Column="0" Text="Batch Number" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="Expiry Date" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Grid.Column="2" Text="Stock Qty" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="MRP (₹)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Rate (₹)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Status" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Center" />
                    </Grid>

                    <!-- Batch Items ListView -->
                    <ListView Grid.Row="2"
                              x:Name="BatchPickerList"
                              ItemsSource="{x:Bind ViewModel.SelectedProductBatches, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectedIndex="{x:Bind ViewModel.SelectedBatchIndex, Mode=TwoWay}"
                              IsItemClickEnabled="True"
                              ItemClick="BatchPickerList_ItemClick"
                              KeyDown="BatchPickerList_KeyDown"
                              MaxHeight="260"
                              Padding="0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="q:ProductBatchDto">
                                <Border Background="{x:Bind RowBackgroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderBrush="{x:Bind RowBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="1,1">
                                    <Grid ColumnDefinitions="1.5*,1.2*,1*,1*,1*,1.1*" Padding="10,6">
                                        <TextBlock Grid.Column="0" Text="{x:Bind BatchNumber}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ExpiryDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:MM/yy}'}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ExpiryForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind StockDisplay}" FontWeight="Bold" FontSize="13" Foreground="{x:Bind StockForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Mrp, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind SaleRate, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Border Grid.Column="5" Background="{x:Bind StatusBackgroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{x:Bind StatusForegroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="Press [Enter] to select batch &amp; add to bill" FontSize="11" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cancel [Esc]" Command="{x:Bind ViewModel.CloseBatchPickerCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="✔ Select Batch [Enter]" Click="BatchPickerConfirm_Click" Style="{StaticResource AccentButtonStyle}" FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 11. MARG ERP Print Receipt Confirmation Prompt Dialog (Opens after sale is saved or via Ctrl+P / F7) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#80000000"
              Canvas.ZIndex="2600"
              Visibility="{x:Bind ViewModel.IsPrintPromptOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{StaticResource SharedShadow}">
                <StackPanel Spacing="16">
                    <!-- Title & Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{ThemeResource AccentSubtle}" CornerRadius="6" Padding="8">
                            <TextBlock Text="🖨️" FontSize="22" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Bill Saved Successfully!" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource StatusSuccess}" />
                            <TextBlock Text="Do you want to print the receipt?" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Summary Card -->
                    <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="6" Padding="14,10" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice Number:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.LastCompletedInvoiceNo, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.LastCompletedCustomer, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Amount Paid:" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.LastCompletedAmount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource StatusSuccess}" />
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0"
                                x:Name="SkipPrintButton"
                                Content="✔ Save &amp; Close [Esc]"
                                Click="SkipPrintButton_Click"
                                KeyDown="PrintPromptBtn_KeyDown"
                                PreviewKeyDown="PrintPromptBtn_PreviewKeyDown"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,4,0"
                                Height="40" />
                        <Button Grid.Column="1"
                                x:Name="DownloadPdfPromptButton"
                                Content="📥 Download PDF"
                                Click="DownloadPdfPromptButton_Click"
                                KeyDown="PrintPromptBtn_KeyDown"
                                PreviewKeyDown="PrintPromptBtn_PreviewKeyDown"
                                HorizontalAlignment="Stretch"
                                Margin="4,0,4,0"
                                Height="40" />
                        <Button Grid.Column="2"
                                x:Name="PrintReceiptButton"
                                Content="🖨️ Print &amp; Close [Enter]"
                                Click="PrintReceiptButton_Click"
                                KeyDown="PrintPromptBtn_KeyDown"
                                PreviewKeyDown="PrintPromptBtn_PreviewKeyDown"
                                Style="{StaticResource AccentButtonStyle}"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                Margin="4,0,0,0"
                                Height="40" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 11.5. Bill Amount Details & Breakdown Modal Dialog (Opens on Enter from Discount input) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#99000000"
              Canvas.ZIndex="2650"
              Visibility="{x:Bind ViewModel.IsAmountDetailsModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{StaticResource SharedShadow}">
                <StackPanel Spacing="16">
                    <!-- Title & Header Strip -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AccentSubtle}" CornerRadius="6" Padding="8">
                                <TextBlock Text="🧾" FontSize="20" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Bill Amount &amp; Tax Summary" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Text="Review breakdown before selecting payment mode" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Click="AmountDetailsBack_Click" Background="Transparent" BorderThickness="0" FontSize="14" />
                    </Grid>

                    <!-- Customer & Invoice Info Strip -->
                    <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="6" Padding="12,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ActiveTab.CustomerName, Mode=OneWay, FallbackValue='Walk-in Customer'}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveTab.CustomerMobile, Mode=OneWay, FallbackValue='No Mobile'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ActiveTab.DisplayInvoiceNo, Mode=OneWay, FallbackValue='INV-TEMP'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveTab.InvoiceDateString, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Financial Details Card -->
                    <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="8" Padding="16,12" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <!-- Total Items & Qty -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total Items / Quantity:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.TotalItemsCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Items" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextSecondary}" Margin="4,0" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.TotalQuantity, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Units" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource BorderDefault}" />

                            <!-- Subtotal (Gross) -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Subtotal (Gross Value):" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.Subtotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="SemiBold" FontSize="13" />
                            </Grid>

                            <!-- Product / Item Level Discounts -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Item-level Discounts:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.ItemDiscounts, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='-₹{0:N2}'}" FontSize="12" Foreground="{ThemeResource StatusWarning}" />
                            </Grid>

                            <!-- Special Bill Discount -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Bill Discount:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.BillDiscountPercent, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='({0:0.##}%)'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveTab.BillDiscountAmount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='-₹{0:N2}'}" FontSize="12" Foreground="{ThemeResource StatusWarning}" />
                                </StackPanel>
                            </Grid>

                            <!-- Total Discount -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total Discount:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.TotalDiscountDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource StatusWarning}" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource BorderDefault}" />

                            <!-- Taxable Value -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Taxable Amount:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.TaxableAmount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" />
                            </Grid>

                            <!-- GST Details -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total GST (CGST + SGST):" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.TotalGst, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Net Payable Hero Banner -->
                    <Border Background="{ThemeResource AccentSubtle}" CornerRadius="8" Padding="16,12" BorderBrush="{ThemeResource AccentPrimary}" BorderThickness="1.5">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="NET PAYABLE AMOUNT" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Text="Inclusive of all taxes &amp; discounts" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveTab.GrandTotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}"
                                       FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Action Buttons Footer -->
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                x:Name="AmountDetailsBackBtn"
                                Content="✕ Back to Search [Esc]"
                                Click="AmountDetailsBack_Click"
                                KeyDown="AmountDetailsBtn_KeyDown"
                                PreviewKeyDown="AmountDetailsBtn_PreviewKeyDown"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,6,0"
                                Height="42" />
                        <Button Grid.Column="1"
                                x:Name="AmountDetailsProceedBtn"
                                Content="Proceed to Payment [Enter] ➔"
                                Click="AmountDetailsProceed_Click"
                                KeyDown="AmountDetailsBtn_KeyDown"
                                PreviewKeyDown="AmountDetailsBtn_PreviewKeyDown"
                                Style="{StaticResource AccentButtonStyle}"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                Margin="6,0,0,0"
                                Height="42" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 12. Sale Type Selection Prompt Modal Dialog (Cash, Credit, UPI, Card) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#99000000"
              Canvas.ZIndex="2700"
              Visibility="{x:Bind ViewModel.IsSaleTypePromptOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="26"
                    Shadow="{StaticResource SharedShadow}">
                <StackPanel Spacing="18">
                    <!-- Title & Header -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AccentSubtle}" CornerRadius="6" Padding="8">
                                <TextBlock Text="🛒" FontSize="22" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Select Sale / Payment Type" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Text="Choose transaction mode to initialize this invoice" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 4 Sale Type Buttons Grid -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <!-- Option 1: Cash -->
                        <Button Grid.Row="0" Grid.Column="0"
                                x:Name="SaleTypeCashBtn"
                                Click="SaleTypeCash_Click"
                                GotFocus="SaleTypeBtn_GotFocus"
                                KeyDown="SaleTypeBtn_KeyDown"
                                PreviewKeyDown="SaleTypeBtn_PreviewKeyDown"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Height="70"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="SaleTypeCashBadge" Grid.Column="0" Background="{ThemeResource AccentSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Width="40" Height="40" Margin="0,0,10,0">
                                    <TextBlock Text="[1]" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CASH SALE" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                    <TextBlock Text="Immediate Cash Payment [C]" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Option 2: Credit -->
                        <Button Grid.Row="0" Grid.Column="1"
                                x:Name="SaleTypeCreditBtn"
                                Click="SaleTypeCredit_Click"
                                GotFocus="SaleTypeBtn_GotFocus"
                                KeyDown="SaleTypeBtn_KeyDown"
                                PreviewKeyDown="SaleTypeBtn_PreviewKeyDown"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Height="70"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="SaleTypeCreditBadge" Grid.Column="0" Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Width="40" Height="40" Margin="0,0,10,0">
                                    <TextBlock Text="[2]" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource StatusWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CREDIT SALE" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                    <TextBlock Text="Customer Ledger Account [R]" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Option 3: UPI / QR -->
                        <Button Grid.Row="1" Grid.Column="0"
                                x:Name="SaleTypeUpiBtn"
                                Click="SaleTypeUpi_Click"
                                GotFocus="SaleTypeBtn_GotFocus"
                                KeyDown="SaleTypeBtn_KeyDown"
                                PreviewKeyDown="SaleTypeBtn_PreviewKeyDown"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Height="70"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="SaleTypeUpiBadge" Grid.Column="0" Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Width="40" Height="40" Margin="0,0,10,0">
                                    <TextBlock Text="[3]" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="UPI / QR CODE" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                    <TextBlock Text="GooglePay / PhonePe / Paytm [U]" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Option 4: Card -->
                        <Button Grid.Row="1" Grid.Column="1"
                                x:Name="SaleTypeCardBtn"
                                Click="SaleTypeCard_Click"
                                GotFocus="SaleTypeBtn_GotFocus"
                                KeyDown="SaleTypeBtn_KeyDown"
                                PreviewKeyDown="SaleTypeBtn_PreviewKeyDown"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Height="70"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="SaleTypeCardBadge" Grid.Column="0" Background="{ThemeResource SurfaceElevated}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Width="40" Height="40" Margin="0,0,10,0">
                                    <TextBlock Text="[4]" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource StatusInfo}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="DEBIT / CREDIT CARD" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                    <TextBlock Text="POS Card Swipe / Tap [D]" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Hint / Instructions -->
                    <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="6" Padding="12,8">
                        <TextBlock Text="⌨ Hotkeys: Use [↑ / ↓ / ← / →] Arrow Keys to navigate, [Enter] to confirm | [1] Cash, [2] Credit, [3] UPI, [4] Card"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 13. Full-Screen Tax Invoice Print Preview Modal Dialog (Ctrl+P / F7 / Settle Preview) -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#B3000000"
              Canvas.ZIndex="2800"
              Visibility="{x:Bind ViewModel.IsPrintPreviewOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentPrimary}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Width="880"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Top Modal Header Strip -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AccentSubtle}" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="🖨️ TAX INVOICE GENERATED" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.LastCompletedInvoiceNo, Mode=OneWay, FallbackValue='TAX INVOICE'}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{x:Bind ViewModel.ClosePrintPreviewCommand}" Background="Transparent" BorderThickness="0" FontSize="14" />
                    </Grid>

                    <!-- Invoice Sheet Container: Unified Bill Template Live HTML Preview -->
                    <Border Grid.Row="1" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4" Background="#ffffff" MinHeight="480">
                        <WebView2 x:Name="PosPreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>

                    <!-- Modal Actions Footer -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,14,0,0" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="Press [← / →] to switch buttons | [Enter] to Print | [Esc] to Close &amp; Next Invoice" FontSize="12" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                x:Name="ClosePrintPreviewButton"
                                Content="✕ Close [Esc]"
                                Click="ClosePrintPreviewButton_Click"
                                KeyDown="PrintPreviewBtn_KeyDown"
                                PreviewKeyDown="PrintPreviewBtn_PreviewKeyDown"
                                Margin="0,0,8,0"
                                Height="40" />
                        <Button Grid.Column="2"
                                x:Name="DownloadPdfPreviewButton"
                                Content="📥 Download PDF"
                                Click="DownloadPdfPreviewButton_Click"
                                KeyDown="PrintPreviewBtn_KeyDown"
                                PreviewKeyDown="PrintPreviewBtn_PreviewKeyDown"
                                Margin="0,0,8,0"
                                Height="40" />
                        <Button Grid.Column="3"
                                x:Name="ConfirmPrintPreviewButton"
                                Content="🖨️ Print Receipt [Enter]"
                                Click="ConfirmPrintPreviewButton_Click"
                                KeyDown="PrintPreviewBtn_KeyDown"
                                PreviewKeyDown="PrintPreviewBtn_PreviewKeyDown"
                                Style="{StaticResource AccentButtonStyle}"
                                FontWeight="Bold"
                                Height="40"
                                Padding="16,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 14. Close Tab Confirmation Modal Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#B3000000"
              Canvas.ZIndex="2900"
              Visibility="{x:Bind ViewModel.IsCloseTabConfirmationOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentDanger}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- Top Modal Header Strip -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="Discard Unsaved Bill?" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentDanger}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Click="CancelCloseTabButton_Click" Background="Transparent" BorderThickness="0" FontSize="14" />
                    </Grid>

                    <!-- Modal Body -->
                    <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,20">
                        <TextBlock Text="This bill contains active items. Closing this tab will discard all items and customer details on this bill."
                                   TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextSecondary}" />
                        
                        <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="6" Padding="12,10" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.TabPendingClose.TabTitle, Mode=OneWay, FallbackValue='Invoice'}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                                    <TextBlock Text="{x:Bind ViewModel.TabPendingClose.CustomerName, Mode=OneWay, FallbackValue='Walk-in Customer'}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.TabPendingClose.TotalItemsCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} Item(s)'}" FontSize="12" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind ViewModel.TabPendingClose.GrandTotal, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentDanger}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Modal Actions Footer -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="Press [← / →] | [Enter] | [Esc]" FontSize="11" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                x:Name="CancelCloseTabButton"
                                Content="Keep Bill [Esc]"
                                Click="CancelCloseTabButton_Click"
                                KeyDown="CloseTabModalBtn_KeyDown"
                                PreviewKeyDown="CloseTabModalBtn_PreviewKeyDown"
                                Margin="0,0,8,0"
                                Height="36" />
                        <Button Grid.Column="2"
                                x:Name="ConfirmCloseTabButton"
                                Content="🗑️ Discard &amp; Close [Enter]"
                                Click="ConfirmCloseTabButton_Click"
                                KeyDown="CloseTabModalBtn_KeyDown"
                                PreviewKeyDown="CloseTabModalBtn_PreviewKeyDown"
                                Background="{ThemeResource AccentDanger}"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="36" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 11. Sale Error / Insufficient Stock Alert Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="6"
              Background="#B3000000"
              Canvas.ZIndex="3500"
              Visibility="{x:Bind ViewModel.IsSaleErrorModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource AccentDanger}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- Title -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SaleErrorTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentDanger}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Click="SaleErrorOkButton_Click" Background="Transparent" BorderThickness="0" FontSize="14" IsTabStop="False" />
                    </Grid>

                    <!-- Body -->
                    <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,20">
                        <TextBlock Text="{x:Bind ViewModel.SaleErrorMessage, Mode=OneWay}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextPrimary}"
                                   LineHeight="22" />
                    </StackPanel>

                    <!-- Actions -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <Button Grid.Column="1"
                                x:Name="SaleErrorOkButton"
                                Content="OK [Enter / Esc]"
                                Click="SaleErrorOkButton_Click"
                                Background="{ThemeResource AccentDanger}"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="36"
                                Padding="20,0"
                                CornerRadius="4" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
