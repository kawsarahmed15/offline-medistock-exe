<Page
    x:Class="Medistock.Desktop.Views.Purchases.PurchaseEntryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- 1. Header & Supplier Information Panel -->
        <Border Grid.Row="0"
                Background="{ThemeResource SurfaceDefault}"
                BorderBrush="{ThemeResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="🚚 Rapid Purchase Invoice Entry"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimary}" />
                        <TextBlock Text="Keyboard-first Goods Receipt Note (GRN) &amp; Wholesaler purchase invoice posting"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding AddNewRowCommand}"
                            Content="➕ Add Item Row [F2]"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <!-- Supplier / Header Metadata Fields -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,1.5*,1.5*,Auto" ColumnSpacing="16">
                    <TextBox Grid.Column="0"
                             Header="Wholesaler / Supplier"
                             Text="{Binding SelectedSupplierName, Mode=TwoWay}"
                             PlaceholderText="Apex Pharma Wholesalers" />

                    <TextBox Grid.Column="1"
                             Header="Supplier Invoice No. *"
                             Text="{Binding SupplierInvoiceNo, Mode=TwoWay}"
                             PlaceholderText="e.g. APEX/2026/8892" />

                    <TextBox Grid.Column="2"
                             Header="Supplier GSTIN"
                             Text="{Binding SupplierGstin, Mode=TwoWay}"
                             PlaceholderText="29AABCU9603R1ZM" />

                    <CheckBox Grid.Column="3"
                              Content="Interstate (IGST)"
                              IsChecked="{Binding IsInterstate, Mode=TwoWay}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,8" />
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Purchase Line Items Grid -->
        <Border Grid.Row="1"
                Background="{ThemeResource SurfaceDefault}"
                BorderBrush="{ThemeResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,0,16">
            <Grid RowDefinitions="Auto,*">
                <!-- Column Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="3*,1.5*,1.5*,1*,1*,1*,1*,1*,1*,Auto"
                      Padding="8,6"
                      Background="{ThemeResource SurfaceSubtle}"
                      CornerRadius="4"
                      Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="PRODUCT NAME" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="2" Text="HSN" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="3" Text="QTY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="FREE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="RATE (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="MRP (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="DISC %" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="NET (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="9" Text="" Width="32" />
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding LineItems}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="3*,1.5*,1.5*,1*,1*,1*,1*,1*,1*,Auto"
                                  Padding="4,4"
                                  BorderBrush="{ThemeResource BorderDefault}"
                                  BorderThickness="0,0,0,1">
                                <TextBox Grid.Column="0" Text="{Binding ProductName, Mode=TwoWay}" Margin="2" />
                                <TextBox Grid.Column="1" Text="{Binding BatchNumber, Mode=TwoWay}" Margin="2" FontFamily="Consolas, Fira Code" />
                                <TextBox Grid.Column="2" Text="{Binding HsnCode, Mode=TwoWay}" Margin="2" />
                                <NumberBox Grid.Column="3" Value="{Binding QuantityDouble, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Margin="2" />
                                <NumberBox Grid.Column="4" Value="{Binding FreeQuantityDouble, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Margin="2" />
                                <NumberBox Grid.Column="5" Value="{Binding UnitPriceDouble, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Margin="2" />
                                <NumberBox Grid.Column="6" Value="{Binding MrpDouble, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Margin="2" />
                                <NumberBox Grid.Column="7" Value="{Binding DiscountPctDouble, Mode=TwoWay}" SpinButtonPlacementMode="Compact" Margin="2" />
                                <TextBlock Grid.Column="8" Text="{Binding NetAmount}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0" />
                                <Button Grid.Column="9"
                                        Content="✕"
                                        FontSize="11"
                                        Padding="6,4"
                                        Margin="2"
                                        Command="{Binding DataContext.RemoveRowCommand, ElementName=LineItemsList}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 3. Bottom Summary & Post Action Panel -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceDefault}"
                BorderBrush="{ThemeResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Status Feedback -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentPrimary}" />
                </StackPanel>

                <!-- Financial Breakdown & Post Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                        <TextBlock Text="Taxable Subtotal:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{Binding TaxableSubtotal}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </StackPanel>

                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                        <TextBlock Text="CGST + SGST:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{Binding CgstTotal}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </StackPanel>

                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                        <TextBlock Text="Round Off:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        <TextBlock Text="{Binding RoundOff}" FontSize="14" HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Grand Total Big Display -->
                    <Border Background="{ThemeResource SurfaceSubtle}"
                            BorderBrush="{ThemeResource AccentPrimary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="GRAND TOTAL" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            <TextBlock Text="{Binding GrandTotal}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        </StackPanel>
                    </Border>

                    <!-- Post Button -->
                    <Button Command="{Binding PostPurchaseInvoiceCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="48"
                            Padding="24,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💾" FontSize="16" />
                            <TextBlock Text="POST INVOICE [Ctrl+S]" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
