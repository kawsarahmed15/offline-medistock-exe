<Page
    x:Class="Medistock.Desktop.Views.Purchases.PurchaseEntryPage"
    x:Name="PurchasePageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}"
    Loaded="Page_Loaded"
    PointerPressed="Page_PointerPressed">

    <Page.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BrandGreen" Color="#059669" />
            <SolidColorBrush x:Key="BrandGreenLight" Color="#15059669" />
            <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
            <SolidColorBrush x:Key="BrandBlueLight" Color="#152563EB" />
            <SolidColorBrush x:Key="AlertRed" Color="#DC2626" />
            <SolidColorBrush x:Key="AlertRedLight" Color="#15DC2626" />

            <!-- Suppress WinUI 3 TextBox internal clear/delete ('X') buttons in table row cells -->
            <Style x:Key="TextBoxDeleteButtonStyle" TargetType="Button">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Width" Value="0" />
                <Setter Property="Height" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <x:Double x:Key="TextBoxDeleteButtonWidth">0</x:Double>
            <x:Double x:Key="TextBoxDeleteButtonHeight">0</x:Double>
            <Thickness x:Key="TextBoxDeleteButtonMargin">0</Thickness>
            <Thickness x:Key="TextBoxDeleteButtonThemePadding">0</Thickness>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20">
        <!-- 1. Top Section: Header & Executive KPI Summary Banner -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Title Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="🚚 Purchases &amp; Inward Stock Master"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="Wholesaler Goods Receipt Note (GRN), Batch Ledger Creation, and Vendor Accounts"
                               FontSize="12"
                               Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>

                <!-- Export & Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshAllPurchaseDataCommand}"
                            ToolTipService.ToolTip="Refresh master data, inward ledger vouchers, and stock valuation [F5]"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="13" />
                            <TextBlock Text="Refresh" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenAddSupplierModalCommand}"
                            ToolTipService.ToolTip="Register a new medicine wholesaler/distributor"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🏢" FontSize="13" />
                            <TextBlock Text="Add Supplier" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPurchasesExcelCommand}"
                            ToolTipService.ToolTip="Export purchase ledger to Microsoft Excel (.xlsx)"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📊" FontSize="13" />
                            <TextBlock Text="Excel (.xlsx)" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPurchasesWordCommand}"
                            ToolTipService.ToolTip="Export purchase summary to Microsoft Word (.docx)"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📄" FontSize="13" />
                            <TextBlock Text="Word (.docx)" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPurchasesPdfCommand}"
                            ToolTipService.ToolTip="Export print-ready PDF / HTML report"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📕" FontSize="13" />
                            <TextBlock Text="PDF Report" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 Interactive KPI Metric Summary Cards -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <!-- Card 1: Total Purchases Amount with Period Filter -->
                <Border Grid.Column="0"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="TOTAL PURCHASES" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                            <!-- Period Filters: Today | 1 Month | All -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Content="Today"
                                        Command="{Binding SetPurchasePeriodCommand}" CommandParameter="Today"
                                        FontSize="8.5" Padding="5,2" MinHeight="18" MinWidth="0" CornerRadius="3"
                                        Background="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='Today'}"
                                        Foreground="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='Today'}" />
                                <Button Content="1 Month"
                                        Command="{Binding SetPurchasePeriodCommand}" CommandParameter="1 Month"
                                        FontSize="8.5" Padding="5,2" MinHeight="18" MinWidth="0" CornerRadius="3"
                                        Background="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='1 Month'}"
                                        Foreground="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='1 Month'}" />
                                <Button Content="All"
                                        Command="{Binding SetPurchasePeriodCommand}" CommandParameter="All"
                                        FontSize="8.5" Padding="5,2" MinHeight="18" MinWidth="0" CornerRadius="3"
                                        Background="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='All'}"
                                        Foreground="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='All'}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalPurchasesFormatted}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" Margin="0,3,0,1" />
                        <HyperlinkButton Grid.Row="2" Command="{Binding ViewPurchasesLedgerCommand}" Padding="0" Margin="0" HorizontalAlignment="Left" ToolTipService.ToolTip="View Invoices in Ledger">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="Period:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedPurchasePeriod}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="• View Ledger ↗" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>
                </Border>

                <!-- Card 2: Total Invoices Count -->
                <Button Grid.Column="1"
                        Command="{Binding ViewPurchasesLedgerCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        ToolTipService.ToolTip="Inward GRN ledger vouchers recorded. Click to open Invoices Recorded Ledger.">
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="INVOICES RECORDED" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                        <TextBlock Text="{Binding TotalInvoicesCount}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        <TextBlock Text="Inward GRN ledger vouchers ↗" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                </Button>

                <!-- Card 3: Active Suppliers Count -->
                <Button Grid.Column="2"
                        Command="{Binding ViewWholesalersDirectoryCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        ToolTipService.ToolTip="Enrolled supply chain vendors. Click to open Wholesalers Directory.">
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="ACTIVE WHOLESALERS" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                        <TextBlock Text="{Binding TotalSuppliersCount}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        <TextBlock Text="Enrolled supply chain vendors ↗" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                </Button>

                <!-- Card 4: Total Stock Value (Calculated by Buying Price × Quantity Present) -->
                <Button Grid.Column="3"
                        Command="{Binding RefreshStockValueCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{StaticResource BrandBlue}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        ToolTipService.ToolTip="Calculated by Product Buying Price × Available Quantity. Click to recalculate.">
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="TOTAL STOCK VALUE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" />
                        <TextBlock Text="{Binding TotalStockValueFormatted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" />
                        <TextBlock Text="Valuation: Qty × Buying Price 🔄" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- 2. Navigation Tabs Toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="🚚 Rapid Purchase Entry [F2]"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Entry"
                        Background="{Binding SelectedTab, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='Entry'}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='Entry'}"
                        FontWeight="SemiBold"
                        Padding="14,6"
                        CornerRadius="4" />

                <Button Content="📋 Invoices Recorded Ledger"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="History"
                        Background="{Binding SelectedTab, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='History'}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='History'}"
                        FontWeight="SemiBold"
                        Padding="14,6"
                        CornerRadius="4" />

                <Button Content="🏢 Wholesalers &amp; Suppliers Directory"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Suppliers"
                        Background="{Binding SelectedTab, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='Suppliers'}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='Suppliers'}"
                        FontWeight="SemiBold"
                        Padding="14,6"
                        CornerRadius="4" />
            </StackPanel>

            <!-- Status Banner -->
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{Binding StatusMessage, Converter={StaticResource StatusColorConverter}}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0" />
        </Grid>

        <!-- 3. Main Content Views -->
        <Grid Grid.Row="2">
            <!-- TAB 1: Rapid Inward Entry -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter='Entry'}"
                  RowDefinitions="Auto,*,Auto">
                
                <!-- Supplier & Inward Metadata Panel -->
                <Border Grid.Row="0"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Row 1: Supplier Selector & Invoice Metadata -->
                        <Grid Grid.Row="0" ColumnDefinitions="3*,1.8*,1.4*,1.4*,Auto" ColumnSpacing="12">
                            <!-- Supplier Autocomplete Field -->
                            <StackPanel Grid.Column="0" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="WHOLESALER / SUPPLIER *" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Text="(Press Enter for New)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <AutoSuggestBox x:Name="SupplierAutoSuggestBox"
                                                    Grid.Column="0"
                                                    Text="{Binding SupplierSearchText, Mode=TwoWay}"
                                                    PlaceholderText="Search or type wholesaler (Press Enter for New)..."
                                                    TextChanged="SupplierAutoSuggestBox_TextChanged"
                                                    SuggestionChosen="SupplierAutoSuggestBox_SuggestionChosen"
                                                    QuerySubmitted="SupplierAutoSuggestBox_QuerySubmitted"
                                                    PreviewKeyDown="SupplierAutoSuggestBox_PreviewKeyDown"
                                                    HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="➕ Add"
                                            ToolTipService.ToolTip="Register New Medicine Wholesaler [Click or Press Enter]"
                                            Command="{Binding OpenAddSupplierModalCommand}"
                                            Background="{StaticResource BrandBlue}"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="8,4"
                                            FontSize="11" />
                                </Grid>
                            </StackPanel>

                            <!-- Supplier Invoice Number -->
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="SUPPLIER INVOICE NO. *" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBox x:Name="SupplierInvoiceNoBox"
                                         Text="{Binding SupplierInvoiceNo, Mode=TwoWay}"
                                         CharacterCasing="Upper"
                                         KeyDown="InvoiceNoBox_KeyDown"
                                         PlaceholderText="e.g. APEX/2026/8892"
                                         FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                         FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Supplier Invoice Date -->
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="INVOICE DATE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <DatePicker x:Name="SupplierInvoiceDatePicker"
                                            Date="{Binding SupplierInvoiceDate, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Supplier GSTIN -->
                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="SUPPLIER GSTIN" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBox x:Name="SupplierGstinBox"
                                         Text="{Binding SupplierGstin, Mode=TwoWay}"
                                         KeyDown="GstinBox_KeyDown"
                                         FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                         PlaceholderText="GSTIN..." />
                            </StackPanel>

                            <!-- Interstate Flag & Add Item Button -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                <CheckBox Content="Interstate (IGST)"
                                          IsChecked="{Binding IsInterstate, Mode=TwoWay}"
                                          Margin="0,0,0,2" />
                                <Button Command="{Binding AddBlankRowCommand}"
                                        Content="➕ Add Row [F2]"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="12,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Supplier Details Info Strip -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,8,0,0" Padding="8,4" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="DL No:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SupplierDlNumber}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Credit Terms:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SupplierCreditDays}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="Days" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Current Balance:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SupplierOutstandingBalance}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AlertRed}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <TextBlock Text="Warehouse:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="Main Store (wh-1)" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Line Items Table -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0"
                        Margin="0,0,0,10">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Table Header -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <Grid ColumnDefinitions="2.6*,1.2*,1*,0.8*,0.8*,0.7*,0.6*,0.9*,0.9*,0.7*,0.7*,0.9*,0.9*,0.8*,0.7*,Auto">
                                <TextBlock Grid.Column="0" Text="MEDICINE / PRODUCT NAME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="2" Text="EXPIRY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="3" Text="HSN" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="4" Text="UNIT" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="5" Text="QTY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="FREE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="COST (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="MRP (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="9" Text="DISC %" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="10" Text="GST %" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="11" Text="TAXABLE (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="12" Text="NET (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="13" Text="LANDED" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="14" Text="MARGIN" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="15" Text="" Width="28" />
                            </Grid>
                        </Border>

                        <!-- Items List -->
                        <ListView x:Name="LineItemsListView"
                                  Grid.Row="1"
                                  ItemsSource="{Binding LineItems}"
                                  SelectionMode="None"
                                  Padding="0">
                            <ListView.Resources>
                                <ResourceDictionary>
                                    <Style x:Key="TextBoxDeleteButtonStyle" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Width" Value="0" />
                                        <Setter Property="Height" Value="0" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </Style>
                                    <x:Double x:Key="TextBoxDeleteButtonWidth">0</x:Double>
                                    <x:Double x:Key="TextBoxDeleteButtonHeight">0</x:Double>
                                    <Thickness x:Key="TextBoxDeleteButtonMargin">0</Thickness>
                                    <Thickness x:Key="TextBoxDeleteButtonThemePadding">0</Thickness>
                                </ResourceDictionary>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="36" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource BorderDefault}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,4">
                                        <Grid ColumnDefinitions="2.6*,1.2*,1*,0.8*,0.8*,0.7*,0.6*,0.9*,0.9*,0.7*,0.7*,0.9*,0.9*,0.8*,0.7*,Auto">
                                            <!-- Product Name Input -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="ProductNameBox_TextChanged"
                                                     PreviewKeyDown="ProductNameBox_PreviewKeyDown"
                                                     KeyDown="ProductNameBox_KeyDown"
                                                     Tag="0"
                                                     Margin="1"
                                                     FontSize="11.5"
                                                     FontWeight="SemiBold"
                                                     PlaceholderText="Type Medicine Name..." />

                                            <!-- Batch Number Input -->
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding BatchNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     CharacterCasing="Upper"
                                                     PreviewKeyDown="RowCell_PreviewKeyDown"
                                                     KeyDown="RowCell_KeyDown"
                                                     Tag="1"
                                                     Margin="1"
                                                     FontSize="11.5"
                                                     FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                                     PlaceholderText="Batch No" />

                                            <!-- Expiry MM/YY TextBox -->
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding ExpiryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="RowCell_PreviewKeyDown"
                                                     KeyDown="RowCell_KeyDown"
                                                     TextChanged="ExpiryBox_TextChanged"
                                                     LostFocus="ExpiryBox_LostFocus"
                                                     Tag="2"
                                                     Margin="1"
                                                     FontSize="11"
                                                     FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                                     PlaceholderText="MM/YY"
                                                     MaxLength="5" />

                                            <!-- HSN Code -->
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding HsnCode, Mode=TwoWay}"
                                                     PreviewKeyDown="RowCell_PreviewKeyDown"
                                                     KeyDown="RowCell_KeyDown"
                                                     Tag="3"
                                                     Margin="1"
                                                     FontSize="11" />

                                            <!-- Unit (Strip, Tab, Box, etc.) -->
                                            <ComboBox Grid.Column="4"
                                                      SelectedItem="{Binding Unit, Mode=TwoWay}"
                                                      PreviewKeyDown="RowCell_PreviewKeyDown"
                                                      KeyDown="RowCell_KeyDown"
                                                      Tag="4"
                                                      Margin="1"
                                                      FontSize="11"
                                                      HorizontalAlignment="Stretch">
                                                <x:String>STRIP</x:String>
                                                <x:String>TAB</x:String>
                                                <x:String>BOX</x:String>
                                                <x:String>BOTTLE</x:String>
                                                <x:String>VIAL</x:String>
                                                <x:String>PCS</x:String>
                                            </ComboBox>

                                            <!-- Quantity -->
                                            <NumberBox Grid.Column="5"
                                                       Value="{Binding QuantityDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="5"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5" />

                                            <!-- Free Quantity -->
                                            <NumberBox Grid.Column="6"
                                                       Value="{Binding FreeQuantityDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="6"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5" />

                                            <!-- Unit Price / Cost Rate -->
                                            <NumberBox Grid.Column="7"
                                                       Value="{Binding UnitPriceDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="7"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5" />

                                            <!-- MRP -->
                                            <NumberBox Grid.Column="8"
                                                       Value="{Binding MrpDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="8"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5" />

                                            <!-- Discount % -->
                                            <NumberBox Grid.Column="9"
                                                       Value="{Binding DiscountPctDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="9"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11" />

                                            <!-- GST % -->
                                            <NumberBox Grid.Column="10"
                                                       Value="{Binding GstRatePercentDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="10"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11" />

                                            <!-- Taxable (₹) -->
                                            <TextBlock Grid.Column="11"
                                                       Text="{Binding TaxableAmountFormatted}"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Net (₹) -->
                                            <TextBlock Grid.Column="12"
                                                       Text="{Binding NetAmountFormatted}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrandGreen}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Landed Cost (₹) -->
                                            <TextBlock Grid.Column="13"
                                                       Text="{Binding LandedCostFormatted}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Margin % -->
                                            <TextBlock Grid.Column="14"
                                                       Text="{Binding MarginDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentPrimary}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Remove Row Button -->
                                            <Button Grid.Column="15"
                                                     Content="✕"
                                                     FontSize="10"
                                                     Padding="4,2"
                                                     Margin="2,0,0,0"
                                                     Command="{Binding DataContext.RemoveRowCommand, ElementName=PurchasePageRoot}"
                                                     CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Medicine Search Autocomplete Dropdown (Marg / POS Style) -->
                        <Popup x:Name="ProductSearchPopup"
                               IsOpen="{Binding IsProductSearchOpen, Mode=TwoWay}"
                               IsLightDismissEnabled="False"
                               VerticalOffset="72"
                               HorizontalOffset="12">
                            <Border Width="1040"
                                    MaxHeight="320"
                                    Background="{ThemeResource SurfaceDefault}"
                                    BorderBrush="{ThemeResource BorderStrong}"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Shadow="{ThemeResource SharedShadow}">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Grid.Row="0" ColumnDefinitions="2.8*,2*,0.8*,0.8*,0.9*,0.9*,0.8*,1*" Background="{ThemeResource SurfaceSubtle}" Padding="10,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                        <TextBlock Grid.Column="0" Text="MEDICINE / PRODUCT NAME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="GENERIC / SALT" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="2" Text="PACK" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="3" Text="HSN" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="4" Text="EXPIRY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="5" Text="STOCK" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="GST %" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="MRP (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ListView Grid.Row="1"
                                              x:Name="ProductSearchListView"
                                              ItemsSource="{Binding ProductSearchResults}"
                                              SelectedIndex="{Binding SelectedProductSearchIndex, Mode=TwoWay}"
                                              SelectedItem="{Binding SelectedProductSearchItem, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              KeyDown="ProductSearchListView_KeyDown"
                                              ItemClick="ProductSearchListView_ItemClick"
                                              IsItemClickEnabled="True">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="1,1" />
                                                <Setter Property="MinHeight" Value="34" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding HighlightBackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                        BorderBrush="{Binding HighlightBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="4"
                                                        Margin="2,1">
                                                    <Grid ColumnDefinitions="2.8*,2*,0.8*,0.8*,0.9*,0.9*,0.8*,1*" Padding="10,6">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" />
                                                            <Border Background="#DC2626" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasExpiryBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding ExpiryBadge}" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                            <Border Background="#D97706" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasStockBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding StockBadge}" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding GenericName}" FontSize="11" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding PackSizeDescription}" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding HsnCode}" FontSize="10.5" FontFamily="Consolas, Fira Code" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding ExpiryDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ExpiryForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding StockDisplay}" FontWeight="Bold" FontSize="11" Foreground="{Binding StockForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="6" Text="{Binding GstRatePercent, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="7" Text="{Binding Mrp, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- Bottom Settlement Panel -->
                <Border Grid.Row="2"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Notes Input -->
                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                            <TextBlock Text="INWARD REMARKS / NOTES" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBox Text="{Binding Notes, Mode=TwoWay}"
                                     PlaceholderText="Optional inward remarks or delivery challan notes..."
                                     Height="48" />
                        </StackPanel>

                        <!-- Financial Totals Breakdown & Action Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="Taxable Subtotal:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TaxableSubtotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="Trade Discount:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TotalDiscount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AlertRed}" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="CGST + SGST:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding CgstTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="IGST:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding IgstTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="Round Off:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding RoundOff, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" HorizontalAlignment="Right" />
                            </StackPanel>

                            <!-- Grand Total Pill -->
                            <Border Background="{StaticResource BrandGreenLight}"
                                    BorderBrush="{StaticResource BrandGreen}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="14,6">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="INVOICE TOTAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                                    <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                </StackPanel>
                            </Border>

                            <!-- Post Invoice Button -->
                            <Button Command="{Binding PostPurchaseInvoiceCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="44"
                                    Padding="20,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="💾" FontSize="15" />
                                    <TextBlock Text="POST INVOICE [Ctrl+S]" FontSize="13" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: Inward Invoices Ledger & History -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter='History'}"
                  RowDefinitions="Auto,*">
                <!-- Search & Filters Toolbar -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBox Text="{Binding HistorySearchText, Mode=TwoWay}"
                             TextChanged="HistorySearchTextBox_TextChanged"
                             PlaceholderText="🔍 Search by Invoice No., Supplier Name, or GSTIN..."
                             Width="380"
                             HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="💡 Select an invoice row and press Enter (or click) to view details" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                </Grid>

                <!-- Invoices Ledger Data Table -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid ColumnDefinitions="1.8*,3*,1.8*,1.4*,0.8*,1.4*,1.2*,1.4*,1.2*,Auto">
                                <TextBlock Grid.Column="0" Text="INVOICE NO." FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="WHOLESALER / SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="2" Text="SUPPLIER GSTIN" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="3" Text="INVOICE DATE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="4" Text="ITEMS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="TAXABLE (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="GST (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="GRAND TOTAL (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="9" Text="ACTION" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" Width="70" />
                            </Grid>
                        </Border>

                        <ListView x:Name="RecentPurchasesListView"
                                  Grid.Row="1"
                                  ItemsSource="{Binding FilteredRecentPurchases}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="RecentPurchasesListView_ItemClick"
                                  KeyDown="RecentPurchasesListView_KeyDown"
                                  DoubleTapped="RecentPurchasesListView_DoubleTapped"
                                  Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource BorderDefault}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,8">
                                        <Grid ColumnDefinitions="1.8*,3*,1.8*,1.4*,0.8*,1.4*,1.2*,1.4*,1.2*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding SupplierInvoiceNo}" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas, Fira Code" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SupplierName}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding SupplierGstin}" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding SupplierInvoiceDate, Converter={StaticResource DateFormatConverter}}" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding ItemCount}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding TaxableAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="6" Text="{Binding CgstAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="7" Text="{Binding GrandTotal, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrandGreen}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="8" Background="#25059669" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                                            </Border>

                                            <!-- Actions: Details button removed as requested, only Cancel option -->
                                            <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="⊘ Cancel"
                                                        FontSize="10"
                                                        Padding="8,3"
                                                        Foreground="#DC2626"
                                                        Visibility="{Binding Status, Converter={StaticResource PostedStatusVisibilityConverter}}"
                                                        Command="{Binding DataContext.RequestCancelInvoiceCommand, ElementName=PurchasePageRoot}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 3: Wholesalers Directory -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter='Suppliers'}"
                  RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="Registered Medicine Wholesalers &amp; Distributors" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding OpenAddSupplierModalCommand}"
                            Content="➕ Add New Wholesaler"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="14,6" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid ColumnDefinitions="3*,1.8*,1.6*,1.6*,1.4*,1.4*,1.6*,1*">
                                <TextBlock Grid.Column="0" Text="WHOLESALER NAME" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="GSTIN" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="2" Text="DL NUMBER" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="3" Text="PHONE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="4" Text="CITY / ADDRESS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="5" Text="CREDIT TERMS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="OUTSTANDING (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding FilteredSuppliers}"
                                  SelectionMode="None"
                                  Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource BorderDefault}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,8">
                                        <Grid ColumnDefinitions="3*,1.8*,1.6*,1.6*,1.4*,1.4*,1.6*,1*">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Gstin}" FontFamily="Consolas, Fira Code" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding DlNumber}" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Phone}" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Address}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CreditDays}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text=" Days" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="6" Text="{Binding CurrentOutstandingBalance, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource AlertRed}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <Border Grid.Column="7" Background="#25059669" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Invoice Details Pop-Over Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsInvoiceDetailsModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="850"
                    MaxHeight="620"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20"
                    Shadow="{ThemeResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="📋 Purchase Invoice &amp; GRN Details" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierName}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseInvoiceDetailsCommand}" Padding="8,4" />
                    </Grid>

                    <!-- Invoice Metadata Header Strip -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Background="{ThemeResource SurfaceSubtle}" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="INVOICE NUMBER" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierInvoiceNo}" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas, Fira Code" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="INVOICE DATE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierInvoiceDate, Converter={StaticResource DateFormatConverter}}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock Text="SUPPLIER GSTIN" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierGstin}" FontSize="12" FontFamily="Consolas, Fira Code" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="1" HorizontalAlignment="Right">
                            <TextBlock Text="GRAND TOTAL" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.GrandTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                        </StackPanel>
                    </Grid>

                    <!-- Line Items Table -->
                    <Border Grid.Row="2" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4">
                        <ListView ItemsSource="{Binding SelectedInvoiceDetails.Items}" SelectionMode="None">
                            <ListView.Header>
                                <Grid ColumnDefinitions="3*,1.4*,1.2*,0.8*,0.8*,1*,1*,1*,1*,1*" Background="{ThemeResource SurfaceSubtle}" Padding="8,6">
                                    <TextBlock Grid.Column="0" Text="PRODUCT NAME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="EXPIRY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="QTY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="FREE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="COST RATE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="MRP" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="TAXABLE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="8" Text="NET (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="9" Text="LANDED" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="3*,1.4*,1.2*,0.8*,0.8*,1*,1*,1*,1*,1*" Padding="8,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="11.5" />
                                        <TextBlock Grid.Column="1" Text="{Binding BatchNumber}" FontFamily="Consolas, Fira Code" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding ExpiryDate, Converter={StaticResource MonthYearFormatConverter}}" FontSize="11" />
                                        <TextBlock Grid.Column="3" Text="{Binding Quantity}" FontSize="11.5" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding FreeQuantity}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="{Binding Mrp, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="{Binding TaxableAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="8" Text="{Binding NetAmount, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource BrandGreen}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="9" Text="{Binding LandedCostPerUnit, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
                        <Button Content="Close" Command="{Binding CloseInvoiceDetailsCommand}" Padding="16,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Add New Wholesaler / Supplier Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsAddSupplierModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24"
                    Shadow="{ThemeResource SharedShadow}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="🏢 Register New Medicine Wholesaler" FontSize="16" FontWeight="Bold" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseAddSupplierModalCommand}" Padding="6,2" />
                    </Grid>

                    <TextBox x:Name="NewSupplierNameBox"
                             Header="Wholesaler / Firm Name *"
                             Text="{Binding NewSupplierName, Mode=TwoWay}"
                             Loaded="NewSupplierNameBox_Loaded"
                             PlaceholderText="e.g. Apex Pharma Wholesalers" />

                    <Grid ColumnDefinitions="*,*">
                        <TextBox Grid.Column="0" Header="GSTIN"
                                 Text="{Binding NewSupplierGstin, Mode=TwoWay}"
                                 PlaceholderText="29AABCU9603R1ZM"
                                 Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Header="Drug License (DL) No."
                                 Text="{Binding NewSupplierDlNumber, Mode=TwoWay}"
                                 PlaceholderText="DL-20B-112233"
                                 Margin="6,0,0,0" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <TextBox Grid.Column="0" Header="Phone Number"
                                 Text="{Binding NewSupplierPhone, Mode=TwoWay}"
                                 PlaceholderText="+91 98765 43210"
                                 Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Header="Email Address"
                                 Text="{Binding NewSupplierEmail, Mode=TwoWay}"
                                 PlaceholderText="orders@wholesaler.in"
                                 Margin="6,0,0,0" />
                    </Grid>

                    <TextBox Header="Premises / Warehouse Address"
                             Text="{Binding NewSupplierAddress, Mode=TwoWay}"
                             PlaceholderText="Industrial Area, City, Pincode" />

                    <Grid ColumnDefinitions="*,*">
                        <NumberBox Grid.Column="0" Header="Payment Credit Days"
                                   Value="{Binding NewSupplierCreditDays, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="5"
                                   Margin="0,0,6,0" />
                        <NumberBox Grid.Column="1" Header="Opening Balance (₹)"
                                   Value="{Binding NewSupplierOpeningBalance, Mode=TwoWay}"
                                   Margin="6,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAddSupplierModalCommand}" Padding="16,6" />
                        <Button Content="Save Supplier"
                                Command="{Binding SaveNewSupplierCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="20,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6. Cancel Invoice Confirmation Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsCancelConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,20"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Shadow="{ThemeResource SharedShadow}">
                <StackPanel Spacing="16">
                    <TextBlock Text="⊘ Cancel Purchase Invoice?"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextSecondary}">
                        <Run Text="This will permanently reverse all stock, supplier balance, and accounting entries for invoice " />
                        <Run Text="{Binding InvoicePendingCancel.SupplierInvoiceNo}"
                             FontWeight="Bold" Foreground="#DC2626" />
                        <Run Text=". This action cannot be undone." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="No, Keep Invoice"
                                Command="{Binding DismissCancelConfirmCommand}"
                                Padding="16,8" />
                        <Button Content="⊘ Yes, Cancel Invoice"
                                Command="{Binding ConfirmCancelInvoiceAsyncCommand}"
                                Background="#DC2626"
                                Foreground="White"
                                Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

