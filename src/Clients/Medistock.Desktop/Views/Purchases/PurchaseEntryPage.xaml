<Page
    x:Class="Medistock.Desktop.Views.Purchases.PurchaseEntryPage"
    x:Name="PurchasePageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}"
    Loaded="Page_Loaded"
    PointerPressed="Page_PointerPressed">

    <Page.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BrandGreen" Color="#059669" />
            <SolidColorBrush x:Key="BrandGreenLight" Color="#15059669" />
            <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
            <SolidColorBrush x:Key="BrandBlueLight" Color="#152563EB" />
            <SolidColorBrush x:Key="AlertRed" Color="#DC2626" />
            <SolidColorBrush x:Key="AlertRedLight" Color="#15DC2626" />

            <!-- Suppress WinUI 3 TextBox internal clear/delete ('X') buttons in table row cells -->
            <Style x:Key="TextBoxDeleteButtonStyle" TargetType="Button">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Width" Value="0" />
                <Setter Property="Height" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <x:Double x:Key="TextBoxDeleteButtonWidth">0</x:Double>
            <x:Double x:Key="TextBoxDeleteButtonHeight">0</x:Double>
            <Thickness x:Key="TextBoxDeleteButtonMargin">0</Thickness>
            <Thickness x:Key="TextBoxDeleteButtonThemePadding">0</Thickness>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20">
        <!-- 1. Top Section: Header & Executive KPI Summary Banner (Hidden when Pure Purchase Entry is active) -->
        <Grid Grid.Row="0" Margin="0,0,0,12" Visibility="{Binding IsPurchaseEntryScreenOpen, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Title Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="🚚 Purchases &amp; Inward Stock Master"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="Wholesaler Goods Receipt Note (GRN), Batch Ledger Creation, and Vendor Accounts"
                               FontSize="12"
                               Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>

                <!-- Export & Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshAllPurchaseDataCommand}"
                            ToolTipService.ToolTip="Refresh master data, inward ledger vouchers, and stock valuation [F5]"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="13" />
                            <TextBlock Text="Refresh" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenAddSupplierModalCommand}"
                            ToolTipService.ToolTip="Register a new medicine wholesaler/distributor"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🏢" FontSize="13" />
                            <TextBlock Text="Add Supplier" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPurchasesExcelCommand}"
                            ToolTipService.ToolTip="Export purchase ledger to Microsoft Excel (.xlsx)"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📊" FontSize="13" />
                            <TextBlock Text="Excel (.xlsx)" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPurchasesWordCommand}"
                            ToolTipService.ToolTip="Export purchase summary to Microsoft Word (.docx)"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📄" FontSize="13" />
                            <TextBlock Text="Word (.docx)" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPurchasesPdfCommand}"
                            ToolTipService.ToolTip="Export print-ready PDF / HTML report"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📕" FontSize="13" />
                            <TextBlock Text="PDF Report" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 Interactive KPI Metric Summary Cards -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <!-- Card 1: Total Purchases Amount with Period Filter -->
                <Border Grid.Column="0"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="TOTAL PURCHASES" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                            <!-- Period Filters: Today | 1 Month | All -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Content="Today"
                                        Command="{Binding SetPurchasePeriodCommand}" CommandParameter="Today"
                                        FontSize="8.5" Padding="5,2" MinHeight="18" MinWidth="0" CornerRadius="3"
                                        Background="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='Today'}"
                                        Foreground="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='Today'}" />
                                <Button Content="1 Month"
                                        Command="{Binding SetPurchasePeriodCommand}" CommandParameter="1 Month"
                                        FontSize="8.5" Padding="5,2" MinHeight="18" MinWidth="0" CornerRadius="3"
                                        Background="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='1 Month'}"
                                        Foreground="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='1 Month'}" />
                                <Button Content="All"
                                        Command="{Binding SetPurchasePeriodCommand}" CommandParameter="All"
                                        FontSize="8.5" Padding="5,2" MinHeight="18" MinWidth="0" CornerRadius="3"
                                        Background="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='All'}"
                                        Foreground="{Binding SelectedPurchasePeriod, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='All'}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalPurchasesFormatted}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" Margin="0,3,0,1" />
                        <HyperlinkButton Grid.Row="2" Command="{Binding ViewPurchasesLedgerCommand}" Padding="0" Margin="0" HorizontalAlignment="Left" ToolTipService.ToolTip="View Invoices in Ledger">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="Period:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedPurchasePeriod}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="• View Ledger ↗" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>
                </Border>

                <!-- Card 2: Total Invoices Count -->
                <Button Grid.Column="1"
                        Command="{Binding ViewPurchasesLedgerCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        ToolTipService.ToolTip="Inward GRN ledger vouchers recorded. Click to open Invoices Recorded Ledger.">
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="INVOICES RECORDED" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                        <TextBlock Text="{Binding TotalInvoicesCount}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        <TextBlock Text="Inward GRN ledger vouchers ↗" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                </Button>

                <!-- Card 3: Active Suppliers Count -->
                <Button Grid.Column="2"
                        Command="{Binding ViewWholesalersDirectoryCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        ToolTipService.ToolTip="Enrolled supply chain vendors. Click to open Wholesalers Directory.">
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="ACTIVE WHOLESALERS" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                        <TextBlock Text="{Binding TotalSuppliersCount}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        <TextBlock Text="Enrolled supply chain vendors ↗" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                </Button>

                <!-- Card 4: Total Stock Value (Calculated by Buying Price × Quantity Present) -->
                <Button Grid.Column="3"
                        Click="TotalStockValueCard_Click"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{StaticResource BrandBlue}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        ToolTipService.ToolTip="Total Stock Value (Qty × Net Buying Cost). Click to open Inventory &amp; Stock screen ↗">
                    <StackPanel Orientation="Vertical" Spacing="2">
                        <TextBlock Text="TOTAL STOCK VALUE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" />
                        <TextBlock Text="{Binding TotalStockValueFormatted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" />
                        <TextBlock Text="Valuation: Qty × Net Cost ↗" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- 1B. Dedicated Purchase Entry Pure Header (Shown ONLY when Purchase Entry is active) -->
        <Grid Grid.Row="0" Margin="0,0,0,12" Visibility="{Binding IsPurchaseEntryScreenOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🚚" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding FormHeaderTitle}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        <TextBlock Text="Direct Purchase Inward Entry • Fast Barcode/Search • Multi-Batch &amp; Packaging" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Message -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding StatusMessage, Converter={StaticResource StatusColorConverter}}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close / Exit Button -->
                <Button Grid.Column="2"
                        Content="✕ Close [Esc]"
                        Command="{Binding RequestClosePurchaseEntryCommand}"
                        ToolTipService.ToolTip="Exit Purchase Entry [Esc]"
                        FontWeight="SemiBold"
                        Padding="14,6"
                        CornerRadius="4" />
            </Grid>
        </Grid>

        <!-- 2. Navigation Tabs Toolbar (Hidden when Pure Purchase Entry is active) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10" Visibility="{Binding IsPurchaseEntryScreenOpen, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="📋 Invoices Recorded Ledger"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="History"
                        Background="{Binding SelectedTab, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='History'}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='History'}"
                        FontWeight="SemiBold"
                        Padding="14,6"
                        CornerRadius="4" />

                <Button Content="🏢 Wholesalers &amp; Suppliers Directory"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Suppliers"
                        Background="{Binding SelectedTab, Converter={StaticResource SelectedTabBackgroundConverter}, ConverterParameter='Suppliers'}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource SelectedTabForegroundConverter}, ConverterParameter='Suppliers'}"
                        FontWeight="SemiBold"
                        Padding="14,6"
                        CornerRadius="4" />
            </StackPanel>

            <!-- Status Banner -->
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{Binding StatusMessage, Converter={StaticResource StatusColorConverter}}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0" />

            <!-- Add Purchase Entry Action Button -->
            <Button Grid.Column="2"
                    Content="➕ Add Purchase Entry [F2]"
                    Command="{Binding OpenPurchaseEntryCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    FontWeight="Bold"
                    Padding="14,6"
                    CornerRadius="4" />
        </Grid>

        <!-- 3. Main Content Views -->
        <Grid Grid.Row="2">
            <!-- TAB 1: Rapid Inward Entry -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter='Entry'}"
                  RowDefinitions="Auto,Auto,*,Auto">
                
                <!-- Supplier & Inward Metadata Panel (and Edit Banner when active) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="8">
                    <!-- EDIT MODE ALERT BANNER -->
                    <Border Visibility="{Binding IsEditingInvoice, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#20D97706"
                            BorderBrush="#D97706"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="✏️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormHeaderTitle}" FontWeight="Bold" FontSize="13" Foreground="#D97706" />
                                <TextBlock Text="You are editing an existing purchase bill. You can modify quantities/rates, or add new medicines to this same bill. Saving will atomically revise stock balances and invoice items."
                                           FontSize="11.5" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="✕ Cancel Edit"
                                    Command="{Binding CancelEditInvoiceCommand}"
                                    Padding="12,5"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Supplier & Inward Metadata Panel -->
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10">
                        <Grid RowDefinitions="Auto,Auto">
                        <!-- Row 1: Supplier Selector & Invoice Metadata -->
                        <Grid Grid.Row="0" ColumnDefinitions="3*,1.8*,1.4*,Auto" ColumnSpacing="12">
                            <!-- Supplier Autocomplete Field -->
                            <StackPanel Grid.Column="0" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="WHOLESALER / SUPPLIER *" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Text="(Press Enter for New)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" VerticalAlignment="Center" />
                                </StackPanel>
                                <AutoSuggestBox x:Name="SupplierAutoSuggestBox"
                                                Text="{Binding SupplierSearchText, Mode=TwoWay}"
                                                PlaceholderText="Search or type wholesaler (Press Enter for New)..."
                                                TextChanged="SupplierAutoSuggestBox_TextChanged"
                                                SuggestionChosen="SupplierAutoSuggestBox_SuggestionChosen"
                                                QuerySubmitted="SupplierAutoSuggestBox_QuerySubmitted"
                                                PreviewKeyDown="SupplierAutoSuggestBox_PreviewKeyDown"
                                                HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Supplier Invoice Number -->
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="SUPPLIER INVOICE NO. *" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBox x:Name="SupplierInvoiceNoBox"
                                         Text="{Binding SupplierInvoiceNo, Mode=TwoWay}"
                                         CharacterCasing="Upper"
                                         KeyDown="InvoiceNoBox_KeyDown"
                                         PlaceholderText="e.g. APEX/2026/8892"
                                         FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                         FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Supplier Invoice Date Text Input -->
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="INVOICE DATE (DD/MM/YYYY) *" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBox x:Name="SupplierInvoiceDateBox"
                                         Text="{Binding SupplierInvoiceDateText, Mode=TwoWay}"
                                         PlaceholderText="DD/MM/YYYY"
                                         TextChanged="SupplierInvoiceDateBox_TextChanged"
                                         PreviewKeyDown="SupplierInvoiceDateBox_PreviewKeyDown"
                                         KeyDown="SupplierInvoiceDateBox_KeyDown"
                                         FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                         FontWeight="SemiBold"
                                         MaxLength="10" />
                            </StackPanel>

                            <!-- Add Item & Add Product Action Buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Command="{Binding OpenAddProductModalCommand}"
                                        Content="💊 Add Product [F3]"
                                        ToolTipService.ToolTip="Register a new medicine into database catalog &amp; invoice [F3]"
                                        Padding="10,6" />
                                <Button Command="{Binding AddBlankRowCommand}"
                                        Content="➕ Add Row [F2]"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="12,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Supplier Details Info Strip -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,8,0,0" Padding="8,4" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="DL No:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SupplierDlNumber}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Credit Terms:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SupplierCreditDays}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="Days" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Current Balance:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding SupplierOutstandingBalance}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AlertRed}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <TextBlock Text="Warehouse:" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="Main Store (wh-1)" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                </StackPanel>

                <!-- Top Dedicated Medicine Search Bar (POS-Style) -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <TextBox x:Name="PurchaseProductSearchBox"
                             PlaceholderText="🔍 [F3] Type Medicine Name, Generic / Salt, or Scan Barcode... [↑/↓: Navigate, Enter: Select, F3 / ➕: Add New Product]"
                             Text="{Binding ProductSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13.5"
                             FontWeight="SemiBold"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             BorderThickness="1.5"
                             BorderBrush="{ThemeResource AccentPrimary}"
                             KeyDown="PurchaseProductSearchBox_KeyDown"
                             PreviewKeyDown="PurchaseProductSearchBox_PreviewKeyDown" />

                    <!-- Floating Product Search Results Autocomplete Dropdown Popup -->
                    <Popup x:Name="PurchaseProductSearchResultsPopup"
                           IsOpen="{Binding HasProductSearchResults, Mode=OneWay}"
                           VerticalOffset="40"
                           HorizontalOffset="0"
                           IsLightDismissEnabled="False">
                        <Border Width="1100"
                                MaxHeight="340"
                                Background="{ThemeResource SurfaceBackground}"
                                BorderBrush="{ThemeResource BorderStrong}"
                                 BorderThickness="1.5"
                                 CornerRadius="6"
                                 Shadow="{StaticResource SharedShadow}">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <!-- Table Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="2.2*,1.5*,85,90,75,85,85,75" Background="{ThemeResource SurfaceSubtle}" Padding="10,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <TextBlock Grid.Column="0" Text="Medicine / Product Name" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="Generic / Salt" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="Pack / Unit" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Grid.Column="3" Text="HSN" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Grid.Column="4" Text="Stock" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Buying Rate (₹)" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="MRP (₹)" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="GST %" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Search Results List -->
                                <ListView Grid.Row="1"
                                          x:Name="PurchaseProductSearchResultsList"
                                          ItemsSource="{Binding ProductSearchResults, Mode=OneWay}"
                                          SelectionMode="Single"
                                          SelectedIndex="{Binding SelectedProductSearchIndex, Mode=TwoWay}"
                                          IsItemClickEnabled="True"
                                          ItemClick="PurchaseProductSearchResultsList_ItemClick"
                                          KeyDown="PurchaseProductSearchResultsList_KeyDown">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProductSearchItemViewModel">
                                            <Border Background="{x:Bind RowBackgroundHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                    BorderBrush="{x:Bind RowBorderHex, Mode=OneWay, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Margin="1,1">
                                                <Grid ColumnDefinitions="2.2*,1.5*,85,90,75,85,85,75" Padding="8,5">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <ItemsControl ItemsSource="{x:Bind NameSegments, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:HighlightedSegment">
                                                                    <Border Background="{x:Bind BackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                            BorderBrush="{x:Bind BorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Padding="1,0"
                                                                            Margin="0,0">
                                                                        <TextBlock Text="{x:Bind Text}"
                                                                                   FontSize="12.5"
                                                                                   FontWeight="{x:Bind FontWeight}"
                                                                                   Foreground="{x:Bind ForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border Background="#DC2626" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                Visibility="{x:Bind HasExpiryBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Bind ExpiryBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind GenericNameSegments, Mode=OneWay}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:HighlightedSegment">
                                                                <Border Background="{x:Bind BackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                        BorderBrush="{x:Bind BorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        Padding="1,0"
                                                                        Margin="0,0">
                                                                    <TextBlock Text="{x:Bind Text}"
                                                                               FontSize="11"
                                                                               FontWeight="{x:Bind FontWeight}"
                                                                               Foreground="{x:Bind ForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind PackSizeDescription}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind HsnCode}" FontSize="11" FontFamily="Consolas, Fira Code" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind StockDisplay}" FontWeight="SemiBold" FontSize="11.5" Foreground="{ThemeResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{x:Bind SaleRate, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="SemiBold" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6" Text="{x:Bind Mrp, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="7" Text="{x:Bind GstRatePercent, Converter={StaticResource StringFormatConverter}, ConverterParameter='GST {0:N0}%'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Footer / "+ Add [Product Name]" item -->
                                <Border Grid.Row="2" Background="{ThemeResource SurfaceSubtle}" Padding="10,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Button Background="{ThemeResource AccentPrimary}"
                                                Foreground="White"
                                                CornerRadius="16"
                                                Padding="12,4"
                                                Command="{Binding AddSearchedProductModalCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="White" CornerRadius="8" Width="16" Height="16">
                                                    <TextBlock Text="+" Foreground="{ThemeResource AccentPrimary}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                </Border>
                                                <TextBlock Text="{Binding AddNewProductButtonText}" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="[↑/↓: Navigate • Enter: Select • F3: Open Add Product Modal • Esc: Dismiss]" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Line Items Table -->
                <Border Grid.Row="2"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0"
                        Margin="0,0,0,10">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Table Header -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <Grid ColumnDefinitions="2.2*,1.1*,0.9*,0.7*,0.7*,0.7*,0.75*,0.6*,0.95*,0.95*,0.65*,0.65*,0.85*,0.85*,0.75*,0.65*,Auto">
                                <TextBlock Grid.Column="0" Text="MEDICINE / PRODUCT NAME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="2" Text="EXPIRY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="3" Text="HSN" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="4" Text="STRIP / PACK" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="PIECE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="QTY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="FREE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="STRIP RATE (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="9" Text="STRIP MRP (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="10" Text="DISC %" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="11" Text="GST %" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="12" Text="TAXABLE (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="13" Text="NET (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="14" Text="LANDED" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="15" Text="MARGIN" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="16" Text="" Width="28" />
                            </Grid>
                        </Border>

                        <!-- Items List -->
                        <ListView x:Name="LineItemsListView"
                                  Grid.Row="1"
                                  ItemsSource="{Binding LineItems}"
                                  SelectionMode="None"
                                  Padding="0">
                            <ListView.Resources>
                                <ResourceDictionary>
                                    <Style x:Key="TextBoxDeleteButtonStyle" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Width" Value="0" />
                                        <Setter Property="Height" Value="0" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </Style>
                                    <x:Double x:Key="TextBoxDeleteButtonWidth">0</x:Double>
                                    <x:Double x:Key="TextBoxDeleteButtonHeight">0</x:Double>
                                    <Thickness x:Key="TextBoxDeleteButtonMargin">0</Thickness>
                                    <Thickness x:Key="TextBoxDeleteButtonThemePadding">0</Thickness>
                                </ResourceDictionary>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="36" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource BorderDefault}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,4">
                                        <Grid ColumnDefinitions="2.2*,1.1*,0.9*,0.7*,0.7*,0.7*,0.75*,0.6*,0.95*,0.95*,0.65*,0.65*,0.85*,0.85*,0.75*,0.65*,Auto"
                                              GotFocus="Row_GotFocus">
                                            <!-- Product Name Input -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="ProductNameBox_TextChanged"
                                                     PreviewKeyDown="ProductNameBox_PreviewKeyDown"
                                                     KeyDown="ProductNameBox_KeyDown"
                                                     Tag="0"
                                                     Margin="1"
                                                     FontSize="11.5"
                                                     FontWeight="SemiBold"
                                                     PlaceholderText="Type Medicine Name..." />

                                            <!-- Batch Number Input -->
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding BatchNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     CharacterCasing="Upper"
                                                     PreviewKeyDown="RowCell_PreviewKeyDown"
                                                     KeyDown="RowCell_KeyDown"
                                                     Tag="1"
                                                     Margin="1"
                                                     FontSize="11.5"
                                                     FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                                     PlaceholderText="Batch No" />

                                            <!-- Expiry MM/YY TextBox -->
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding ExpiryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="RowCell_PreviewKeyDown"
                                                     KeyDown="RowCell_KeyDown"
                                                     TextChanged="ExpiryBox_TextChanged"
                                                     LostFocus="ExpiryBox_LostFocus"
                                                     Tag="2"
                                                     Margin="1"
                                                     FontSize="11"
                                                     FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                                     PlaceholderText="MM/YY"
                                                     MaxLength="5" />

                                            <!-- HSN Code -->
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding HsnCode, Mode=TwoWay}"
                                                     PreviewKeyDown="RowCell_PreviewKeyDown"
                                                     KeyDown="RowCell_KeyDown"
                                                     Tag="3"
                                                     Margin="1"
                                                     FontSize="11" />

                                            <!-- Strip Count -->
                                            <NumberBox Grid.Column="4"
                                                       Value="{Binding StripCountDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="4"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5"
                                                       ToolTipService.ToolTip="{Binding UnitPackagingHoverText}" />

                                            <!-- Pieces per Strip -->
                                            <NumberBox Grid.Column="5"
                                                       Value="{Binding PiecesPerStripDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="5"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5"
                                                       ToolTipService.ToolTip="Pieces / Tablets per strip" />

                                            <!-- Total Quantity (Strip × Piece) -->
                                            <NumberBox Grid.Column="6"
                                                       Value="{Binding QuantityDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="6"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5"
                                                       ToolTipService.ToolTip="{Binding UnitPackagingHoverText}" />

                                            <!-- Free Quantity -->
                                            <NumberBox Grid.Column="7"
                                                       Value="{Binding FreeQuantityDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="7"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11.5" />

                                            <!-- Strip Buying Price / Cost Rate -->
                                            <Grid Grid.Column="8" Margin="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <NumberBox Grid.Row="0"
                                                           Value="{Binding StripPriceDouble, Mode=TwoWay}"
                                                           PreviewKeyDown="RowCell_PreviewKeyDown"
                                                           KeyDown="RowCell_KeyDown"
                                                           Tag="8"
                                                           SpinButtonPlacementMode="Hidden"
                                                           FontSize="11.5"
                                                           ToolTipService.ToolTip="{Binding StripPriceBreakdownDisplay}" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding UnitPricePieceDisplay}"
                                                           FontSize="9"
                                                           Foreground="{ThemeResource TextMuted}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,-3,2,0" />
                                            </Grid>

                                            <!-- Strip MRP -->
                                            <Grid Grid.Column="9" Margin="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <NumberBox Grid.Row="0"
                                                           Value="{Binding StripMrpDouble, Mode=TwoWay}"
                                                           PreviewKeyDown="RowCell_PreviewKeyDown"
                                                           KeyDown="RowCell_KeyDown"
                                                           Tag="9"
                                                           SpinButtonPlacementMode="Hidden"
                                                           FontSize="11.5"
                                                           ToolTipService.ToolTip="{Binding StripMrpBreakdownDisplay}" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding MrpPieceDisplay}"
                                                           FontSize="9"
                                                           Foreground="{ThemeResource TextMuted}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,-3,2,0" />
                                            </Grid>

                                            <!-- Discount % -->
                                            <NumberBox Grid.Column="10"
                                                       Value="{Binding DiscountPctDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="10"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11" />

                                            <!-- GST % -->
                                            <NumberBox Grid.Column="11"
                                                       Value="{Binding GstRatePercentDouble, Mode=TwoWay}"
                                                       PreviewKeyDown="RowCell_PreviewKeyDown"
                                                       KeyDown="RowCell_KeyDown"
                                                       Tag="11"
                                                       SpinButtonPlacementMode="Hidden"
                                                       Margin="1"
                                                       FontSize="11" />

                                            <!-- Taxable (₹) -->
                                            <TextBlock Grid.Column="12"
                                                       Text="{Binding TaxableAmountFormatted}"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Net (₹) -->
                                            <TextBlock Grid.Column="13"
                                                       Text="{Binding NetAmountFormatted}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrandGreen}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Landed Cost (₹) -->
                                            <TextBlock Grid.Column="14"
                                                       Text="{Binding LandedCostFormatted}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Margin % -->
                                            <TextBlock Grid.Column="15"
                                                       Text="{Binding MarginDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentPrimary}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="2,0" />

                                            <!-- Remove Row Button -->
                                            <Button Grid.Column="16"
                                                    Content="✕"
                                                    FontSize="10"
                                                    Padding="4,2"
                                                    Margin="2,0,0,0"
                                                    Click="RowDeleteButton_Click"
                                                    ToolTipService.ToolTip="Delete this row (Ctrl+Z to undo)" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Medicine Search Autocomplete Dropdown (Marg / POS Style) -->
                        <Popup x:Name="ProductSearchPopup"
                               IsOpen="{Binding IsProductSearchOpen, Mode=TwoWay}"
                               IsLightDismissEnabled="False"
                               VerticalOffset="72"
                               HorizontalOffset="12">
                            <Border Width="1040"
                                    MaxHeight="320"
                                    Background="{ThemeResource SurfaceDefault}"
                                    BorderBrush="{ThemeResource BorderStrong}"
                                    BorderThickness="1.5"
                                    CornerRadius="6"
                                    Shadow="{ThemeResource SharedShadow}">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="2.8*,2*,0.8*,0.8*,0.9*,0.9*,0.8*,1*" Background="{ThemeResource SurfaceSubtle}" Padding="10,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                        <TextBlock Grid.Column="0" Text="MEDICINE / PRODUCT NAME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="GENERIC / SALT" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="2" Text="PACK" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="3" Text="HSN" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="4" Text="EXPIRY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                        <TextBlock Grid.Column="5" Text="STOCK" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="GST %" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="MRP (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ListView Grid.Row="1"
                                              x:Name="ProductSearchListView"
                                              ItemsSource="{Binding ProductSearchResults}"
                                              SelectedIndex="{Binding SelectedProductSearchIndex, Mode=TwoWay}"
                                              SelectedItem="{Binding SelectedProductSearchItem, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              KeyDown="ProductSearchListView_KeyDown"
                                              ItemClick="ProductSearchListView_ItemClick"
                                              IsItemClickEnabled="True">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="1,1" />
                                                <Setter Property="MinHeight" Value="34" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding HighlightBackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                        BorderBrush="{Binding HighlightBorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="4"
                                                        Margin="2,1">
                                                    <Grid ColumnDefinitions="2.8*,2*,0.8*,0.8*,0.9*,0.9*,0.8*,1*" Padding="10,6">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <ItemsControl ItemsSource="{Binding NameSegments}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{Binding BackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                                BorderBrush="{Binding BorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="3"
                                                                                Padding="1,0"
                                                                                Margin="0,0">
                                                                            <TextBlock Text="{Binding Text}"
                                                                                       FontSize="11.5"
                                                                                       FontWeight="{Binding FontWeight}"
                                                                                       Foreground="{Binding ForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Border Background="#DC2626" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasExpiryBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding ExpiryBadge}" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                            <Border Background="#D97706" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasStockBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding StockBadge}" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                            </Border>
                                                        </StackPanel>
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding GenericNameSegments}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding BackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                            BorderBrush="{Binding BorderHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Padding="1,0"
                                                                            Margin="0,0">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontSize="11"
                                                                                   FontWeight="{Binding FontWeight}"
                                                                                   Foreground="{Binding ForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Grid.Column="2" Text="{Binding PackSizeDescription}" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding HsnCode}" FontSize="10.5" FontFamily="Consolas, Fira Code" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding ExpiryDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ExpiryForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding StockDisplay}" FontWeight="Bold" FontSize="11" Foreground="{Binding StockForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="6" Text="{Binding GstRatePercent, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="7" Text="{Binding Mrp, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Border Grid.Row="2" Background="{ThemeResource SurfaceSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,1,0,0" Padding="8,4">
                                        <Button Command="{Binding OpenAddProductModalCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,3"
                                                HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="➕" FontSize="11" />
                                                <TextBlock Text="Can't find medicine? Register New Product [F3]" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- Bottom Settlement Panel -->
                <Border Grid.Row="3"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Notes Input -->
                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                            <TextBlock Text="INWARD REMARKS / NOTES" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBox Text="{Binding Notes, Mode=TwoWay}"
                                     PlaceholderText="Optional inward remarks or delivery challan notes..."
                                     Height="48" />
                        </StackPanel>

                        <!-- Financial Totals Breakdown & Action Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="Taxable Subtotal:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TaxableSubtotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="Trade Discount:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TotalDiscount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AlertRed}" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="CGST + SGST:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding CgstTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="IGST:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding IgstTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Spacing="1" HorizontalAlignment="Right">
                                <TextBlock Text="Round Off:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding RoundOff, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" HorizontalAlignment="Right" />
                            </StackPanel>

                            <!-- Grand Total Pill -->
                            <Border Background="{StaticResource BrandGreenLight}"
                                    BorderBrush="{StaticResource BrandGreen}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="14,6">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="INVOICE TOTAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                                    <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                </StackPanel>
                            </Border>

                            <!-- Post Invoice Button -->
                            <Button Command="{Binding RequestSaveSummaryCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="44"
                                    Padding="20,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="💾" FontSize="15" />
                                    <TextBlock Text="{Binding SaveButtonText}" FontSize="13" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: Inward Invoices Ledger & History -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter='History'}"
                  RowDefinitions="Auto,*">
                <!-- Search & Filters Toolbar -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBox Text="{Binding HistorySearchText, Mode=TwoWay}"
                             TextChanged="HistorySearchTextBox_TextChanged"
                             PlaceholderText="🔍 Search by Invoice No., Supplier Name, or GSTIN..."
                             Width="380"
                             HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="💡 Select an invoice row and press Enter (or click) to view details" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                </Grid>

                <!-- Invoices Ledger Data Table -->
                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid ColumnDefinitions="1.8*,3*,1.8*,1.4*,0.8*,1.4*,1.2*,1.4*,1.2*,Auto">
                                <TextBlock Grid.Column="0" Text="INVOICE NO." FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="WHOLESALER / SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="2" Text="SUPPLIER GSTIN" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="3" Text="INVOICE DATE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="4" Text="ITEMS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="TAXABLE (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="GST (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="GRAND TOTAL (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="8" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="9" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" Width="140" />
                            </Grid>
                        </Border>

                        <ListView x:Name="RecentPurchasesListView"
                                  Grid.Row="1"
                                  ItemsSource="{Binding FilteredRecentPurchases}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="RecentPurchasesListView_ItemClick"
                                  KeyDown="RecentPurchasesListView_KeyDown"
                                  DoubleTapped="RecentPurchasesListView_DoubleTapped"
                                  Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource BorderDefault}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,8">
                                        <Grid ColumnDefinitions="1.8*,3*,1.8*,1.4*,0.8*,1.4*,1.2*,1.4*,1.2*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SupplierInvoiceNo}" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas, Fira Code" />
                                                <TextBlock Text="{Binding FormattedPurchaseNo}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" FontFamily="Consolas, Fira Code" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SupplierName}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding SupplierGstin}" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding SupplierInvoiceDate, Converter={StaticResource DateFormatConverter}}" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding ItemCount}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding TaxableAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="6" Text="{Binding CgstAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="7" Text="{Binding GrandTotal, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrandGreen}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="8" Background="#25059669" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                                            </Border>

                                            <!-- Actions: Edit Bill and Purchase Return (Debit Note) -->
                                            <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Width="140">
                                                <Button Content="✏️ Edit"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Padding="8,4"
                                                        Foreground="{StaticResource BrandBlue}"
                                                        Background="{StaticResource BrandBlueLight}"
                                                        BorderBrush="{StaticResource BrandBlue}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Command="{Binding DataContext.EditPurchaseInvoiceCommand, ElementName=PurchasePageRoot}"
                                                        CommandParameter="{Binding}"
                                                        ToolTipService.ToolTip="Edit this purchase bill (add/modify products, rates, quantities)" />

                                                <Button Content="↩ Return"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Padding="8,4"
                                                        Foreground="#D97706"
                                                        Background="#15D97706"
                                                        BorderBrush="#D97706"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Command="{Binding DataContext.OpenPurchaseReturnCommand, ElementName=PurchasePageRoot}"
                                                        CommandParameter="{Binding}"
                                                        ToolTipService.ToolTip="Process purchase return / debit note for medicines from this bill" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 3: Wholesalers Directory -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter='Suppliers'}"
                  RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="Registered Medicine Wholesalers &amp; Distributors" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding OpenAddSupplierModalCommand}"
                            Content="➕ Add New Wholesaler"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="14,6" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{ThemeResource SurfaceDefault}"
                        BorderBrush="{ThemeResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid ColumnDefinitions="2.6*,1.6*,1.4*,1.3*,1.8*,1.6*,1.8*,0.9*">
                                <TextBlock Grid.Column="0" Text="WHOLESALER NAME" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="GSTIN" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="2" Text="DL NUMBER" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="3" Text="PHONE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="4" Text="CITY / ADDRESS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="5" Text="PURCHASE NO." FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="6" Text="INVOICE NUMBER" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="7" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding FilteredSuppliers}"
                                  SelectionMode="None"
                                  Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource BorderDefault}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,8">
                                        <Grid ColumnDefinitions="2.6*,1.6*,1.4*,1.3*,1.8*,1.6*,1.8*,0.9*">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Gstin}" FontFamily="Consolas, Fira Code" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding DlNumber}" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Phone}" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Address}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="5" Text="{Binding FormattedPurchaseNo}"
                                                       ToolTipService.ToolTip="{Binding FormattedPurchaseNo}"
                                                       FontFamily="Consolas, Fira Code" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrandBlue}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="6" Text="{Binding FormattedInvoiceNo}"
                                                       ToolTipService.ToolTip="{Binding FormattedInvoiceNo}"
                                                       FontFamily="Consolas, Fira Code" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="7" Background="#25059669" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Invoice Details Pop-Over Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsInvoiceDetailsModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="850"
                    MaxHeight="620"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20"
                    Shadow="{ThemeResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="📋 Purchase Invoice &amp; GRN Details" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierName}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseInvoiceDetailsCommand}" Padding="8,4" />
                    </Grid>

                    <!-- Invoice Metadata Header Strip -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Background="{ThemeResource SurfaceSubtle}" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="INVOICE NUMBER" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierInvoiceNo}" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas, Fira Code" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="INVOICE DATE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierInvoiceDate, Converter={StaticResource DateFormatConverter}}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock Text="SUPPLIER GSTIN" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.SupplierGstin}" FontSize="12" FontFamily="Consolas, Fira Code" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="1" HorizontalAlignment="Right">
                            <TextBlock Text="GRAND TOTAL" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding SelectedInvoiceDetails.GrandTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                        </StackPanel>
                    </Grid>

                    <!-- Line Items Table -->
                    <Border Grid.Row="2" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4">
                        <ListView ItemsSource="{Binding SelectedInvoiceDetails.Items}" SelectionMode="None">
                            <ListView.Header>
                                <Grid ColumnDefinitions="3*,1.4*,1.2*,0.8*,0.8*,1*,1*,1*,1*,1*" Background="{ThemeResource SurfaceSubtle}" Padding="8,6">
                                    <TextBlock Grid.Column="0" Text="PRODUCT NAME" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="EXPIRY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="QTY" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="FREE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="COST RATE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="MRP" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="TAXABLE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="8" Text="NET (₹)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="9" Text="LANDED" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="3*,1.4*,1.2*,0.8*,0.8*,1*,1*,1*,1*,1*" Padding="8,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="11.5" />
                                        <TextBlock Grid.Column="1" Text="{Binding BatchNumber}" FontFamily="Consolas, Fira Code" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding ExpiryDate, Converter={StaticResource MonthYearFormatConverter}}" FontSize="11" />
                                        <TextBlock Grid.Column="3" Text="{Binding Quantity}" FontSize="11.5" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding FreeQuantity}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="{Binding Mrp, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="{Binding TaxableAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="8" Text="{Binding NetAmount, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource BrandGreen}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="9" Text="{Binding LandedCostPerUnit, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
                        <Button Content="Close" Command="{Binding CloseInvoiceDetailsCommand}" Padding="16,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Add New Wholesaler / Supplier Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsAddSupplierModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24"
                    Shadow="{ThemeResource SharedShadow}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="🏢 Register New Medicine Wholesaler" FontSize="16" FontWeight="Bold" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseAddSupplierModalCommand}" Padding="6,2" />
                    </Grid>

                    <TextBox x:Name="NewSupplierNameBox"
                             Header="Wholesaler / Firm Name *"
                             Text="{Binding NewSupplierName, Mode=TwoWay}"
                             Loaded="NewSupplierNameBox_Loaded"
                             PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                             PlaceholderText="e.g. Apex Pharma Wholesalers" />

                    <Grid ColumnDefinitions="*,*">
                        <TextBox x:Name="NewSupplierGstinBox"
                                 Grid.Column="0" Header="GSTIN"
                                 Text="{Binding NewSupplierGstin, Mode=TwoWay}"
                                 PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                 PlaceholderText="29AABCU9603R1ZM"
                                 Margin="0,0,6,0" />
                        <TextBox x:Name="NewSupplierDlNumberBox"
                                 Grid.Column="1" Header="Drug License (DL) No."
                                 Text="{Binding NewSupplierDlNumber, Mode=TwoWay}"
                                 PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                 PlaceholderText="DL-20B-112233"
                                 Margin="6,0,0,0" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <TextBox x:Name="NewSupplierPhoneBox"
                                 Grid.Column="0" Header="Phone Number"
                                 Text="{Binding NewSupplierPhone, Mode=TwoWay}"
                                 PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                 PlaceholderText="+91 98765 43210"
                                 Margin="0,0,6,0" />
                        <TextBox x:Name="NewSupplierEmailBox"
                                 Grid.Column="1" Header="Email Address"
                                 Text="{Binding NewSupplierEmail, Mode=TwoWay}"
                                 PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                 PlaceholderText="orders@wholesaler.in"
                                 Margin="6,0,0,0" />
                    </Grid>

                    <TextBox x:Name="NewSupplierAddressBox"
                             Header="Premises / Warehouse Address"
                             Text="{Binding NewSupplierAddress, Mode=TwoWay}"
                             PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                             PlaceholderText="Industrial Area, City, Pincode" />

                    <Grid ColumnDefinitions="*,*">
                        <NumberBox x:Name="NewSupplierCreditDaysBox"
                                   Grid.Column="0" Header="Payment Credit Days"
                                   Value="{Binding NewSupplierCreditDays, Mode=TwoWay}"
                                   PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="5"
                                   Margin="0,0,6,0" />
                        <NumberBox x:Name="NewSupplierOpeningBalanceBox"
                                   Grid.Column="1" Header="Opening Balance (₹)"
                                   Value="{Binding NewSupplierOpeningBalance, Mode=TwoWay}"
                                   PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                   Margin="6,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button x:Name="CancelNewSupplierBtn"
                                Content="Cancel [Esc]"
                                Command="{Binding CloseAddSupplierModalCommand}"
                                PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                Padding="16,6" />
                        <Button x:Name="SaveNewSupplierBtn"
                                Content="Save Supplier [Enter]"
                                Command="{Binding SaveNewSupplierCommand}"
                                PreviewKeyDown="NewSupplierField_PreviewKeyDown"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="20,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 7. Add New Product to Inventory Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsAddProductModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="780"
                    MaxHeight="840"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20,16"
                    Shadow="{ThemeResource SharedShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="1">
                                <TextBlock Text="💊 Add New Product to Inventory" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Product not found in system. Register it with pricing, packaging &amp; batch details."
                                           FontSize="11.5" Foreground="{ThemeResource TextSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Command="{Binding CloseAddProductModalCommand}" Padding="8,4" VerticalAlignment="Top" />
                        </Grid>

                        <!-- Validation Message -->
                        <Border Background="#20DC2626" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Padding="8,4"
                                Visibility="{Binding HasNewProductValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding NewProductValidationMessage}" Foreground="#EF4444" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <!-- Section: Basic Information -->
                        <TextBlock Text="Product Details" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" Margin="0,2,0,0" />

                        <Grid ColumnDefinitions="*,*">
                            <TextBox x:Name="NewProductNameBox"
                                     Grid.Column="0"
                                     Header="Product Name *"
                                     Text="{Binding NewProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Loaded="NewProductNameBox_Loaded"
                                     PreviewKeyDown="NewProductField_PreviewKeyDown"
                                     PlaceholderText="e.g. Augmentin 625 Duo Tablet"
                                     Margin="0,0,6,0" />

                            <TextBox x:Name="NewProductManufacturerBox"
                                     Grid.Column="1"
                                     Header="Manufacturer / Company"
                                     Text="{Binding NewProductManufacturer, Mode=TwoWay}"
                                     PreviewKeyDown="NewProductField_PreviewKeyDown"
                                     PlaceholderText="e.g. GSK / Cipla / Sun Pharma"
                                     Margin="6,0,0,0" />
                        </Grid>

                        <!-- Section: Stock Type & Packaging -->
                        <TextBlock Text="Stock Classification &amp; Packaging" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" Margin="0,2,0,0" />

                        <Grid ColumnDefinitions="*,*">
                            <ComboBox x:Name="NewProductStockTypeComboBox"
                                      Grid.Column="0"
                                      Header="Stock Type"
                                      ItemsSource="{Binding StockTypeOptions}"
                                      SelectedItem="{Binding NewProductStockType, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      PreviewKeyDown="NewProductField_PreviewKeyDown"
                                      Margin="0,0,6,0" />

                            <Grid Grid.Column="1" Margin="6,0,0,0">
                                <!-- Option 1: Tablet / Capsule -> Strip and Pcs -->
                                <Grid ColumnDefinitions="*,*"
                                      Visibility="{Binding IsTabletOrCapsule, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <NumberBox x:Name="NewProductStripCountBox"
                                               Grid.Column="0"
                                               Header="Strip"
                                               Value="{Binding NewProductStripCountDouble, Mode=TwoWay}"
                                               SpinButtonPlacementMode="Inline"
                                               SmallChange="1"
                                               PreviewKeyDown="NewProductField_PreviewKeyDown"
                                               Margin="0,0,3,0" />
                                    <NumberBox x:Name="NewProductPcsPerStripBox"
                                               Grid.Column="1"
                                               Header="Pcs / Strip"
                                               Value="{Binding NewProductPcsPerStripDouble, Mode=TwoWay}"
                                               SpinButtonPlacementMode="Inline"
                                               SmallChange="1"
                                               PreviewKeyDown="NewProductField_PreviewKeyDown"
                                               Margin="3,0,0,0" />
                                </Grid>

                                <!-- Option 2: Syrup / Injection / Drop -> Volume in ml (e.g. 100ml, 200ml) -->
                                <ComboBox x:Name="NewProductVolumeMlComboBox"
                                          Header="Pack Size (ml)"
                                          IsEditable="True"
                                          Text="{Binding NewProductPackSizeText, Mode=TwoWay}"
                                          ItemsSource="{Binding VolumeMlOptions}"
                                          HorizontalAlignment="Stretch"
                                          PreviewKeyDown="NewProductField_PreviewKeyDown"
                                          Visibility="{Binding IsVolumeMlType, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Option 3: Cream -> Weight in gm (e.g. 20gm, 10gm) -->
                                <ComboBox x:Name="NewProductWeightGmComboBox"
                                          Header="Pack Size (gm)"
                                          IsEditable="True"
                                          Text="{Binding NewProductPackSizeText, Mode=TwoWay}"
                                          ItemsSource="{Binding WeightGmOptions}"
                                          HorizontalAlignment="Stretch"
                                          PreviewKeyDown="NewProductField_PreviewKeyDown"
                                          Visibility="{Binding IsWeightGmType, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Option 4: General / Other -> Units -->
                                <NumberBox x:Name="NewProductPackOptionsBox"
                                           Header="Pack Units"
                                           Value="{Binding NewProductPackOptionsDouble, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1"
                                           PreviewKeyDown="NewProductField_PreviewKeyDown"
                                           Visibility="{Binding IsGeneralType, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <TextBox x:Name="NewProductHsnBox"
                                     Grid.Column="0"
                                     Header="HSN Code"
                                     Text="{Binding NewProductHsnCode, Mode=TwoWay}"
                                     PreviewKeyDown="NewProductField_PreviewKeyDown"
                                     PlaceholderText="3004"
                                     Margin="0,0,6,0" />
                            <ComboBox x:Name="NewProductTaxComboBox"
                                      Grid.Column="1"
                                      Header="Tax % (GST)"
                                      ItemsSource="{Binding TaxRateOptions}"
                                      SelectedItem="{Binding NewProductTaxPercent, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      PreviewKeyDown="NewProductField_PreviewKeyDown"
                                      Margin="6,0,0,0" />
                        </Grid>

                        <!-- Section: Pricing -->
                        <TextBlock Text="Pricing &amp; Valuation" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" Margin="0,2,0,0" />

                        <Grid ColumnDefinitions="*,*">
                            <NumberBox x:Name="NewProductMrpBox"
                                       Grid.Column="0"
                                       Header="{Binding NewProductMrpHeader}"
                                       Value="{Binding NewProductMrpDouble, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Compact"
                                       PreviewKeyDown="NewProductField_PreviewKeyDown"
                                       Margin="0,0,6,0" />
                            <NumberBox x:Name="NewProductBuyingPriceBox"
                                       Grid.Column="1"
                                       Header="{Binding NewProductBuyingPriceHeader}"
                                       Value="{Binding NewProductBuyingPriceDouble, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Compact"
                                       PreviewKeyDown="NewProductField_PreviewKeyDown"
                                       Margin="6,0,0,0" />
                        </Grid>

                        <!-- Strip to Piece Price Breakdown Helper -->
                        <TextBlock Text="{Binding NewProductPriceBreakdownText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentPrimary}"
                                   Margin="0,-2,0,0" />

                        <!-- Section: Initial Stock & Batch Details -->
                        <TextBlock Text="Initial Stock &amp; Batch Details" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" Margin="0,2,0,0" />

                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="2">
                                <NumberBox x:Name="NewProductInitialStockQtyBox"
                                           Header="Initial Stock Qty"
                                           Value="{Binding NewProductInitialStockQtyDouble, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1"
                                           PreviewKeyDown="NewProductField_PreviewKeyDown" />
                                <TextBlock Text="{Binding NewProductStockBreakdownText}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBox x:Name="NewProductBatchBox"
                                     Grid.Column="1"
                                     Header="Batch"
                                     Text="{Binding NewProductBatch, Mode=TwoWay}"
                                     CharacterCasing="Upper"
                                     PreviewKeyDown="NewProductField_PreviewKeyDown"
                                     PlaceholderText="e.g. B101"
                                     Margin="4,0,4,0" />
                            <TextBox x:Name="NewProductExpiryBox"
                                     Grid.Column="2"
                                     Header="Expiry (MM/YY)"
                                     Text="{Binding NewProductExpiryText, Mode=TwoWay}"
                                     TextChanged="NewProductExpiryBox_TextChanged"
                                     PreviewKeyDown="NewProductField_PreviewKeyDown"
                                     PlaceholderText="MM/YY"
                                     Margin="4,0,0,0" />
                        </Grid>

                        <!-- Section: Regulatory & Rx Checkbox -->
                        <Border Background="{ThemeResource SurfaceSubtle}"
                                BorderBrush="{ThemeResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,2,0,0">
                            <CheckBox x:Name="NewProductRxCheckBox"
                                      IsChecked="{Binding NewProductIsPrescriptionRequired, Mode=TwoWay}"
                                      PreviewKeyDown="NewProductField_PreviewKeyDown">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Prescription required" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="Mark this product as Rx-only (Schedule H / H1 safeguard required at POS)"
                                               FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                            <Button x:Name="CancelNewProductBtn"
                                    Content="Cancel [Esc]"
                                    Command="{Binding CloseAddProductModalCommand}"
                                    PreviewKeyDown="NewProductField_PreviewKeyDown"
                                    Padding="16,5" />
                            <Button x:Name="SaveNewProductBtn"
                                    Content="Save &amp; Add to Invoice [Enter]"
                                    Command="{Binding SaveNewProductCommand}"
                                    PreviewKeyDown="NewProductField_PreviewKeyDown"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="16,5" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 6. Cancel Invoice Confirmation Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsCancelConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,20"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Shadow="{ThemeResource SharedShadow}">
                <StackPanel Spacing="16">
                    <TextBlock Text="⊘ Cancel Purchase Invoice?"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextSecondary}">
                        <Run Text="This will permanently reverse all stock, supplier balance, and accounting entries for invoice " />
                        <Run Text="{Binding InvoicePendingCancel.SupplierInvoiceNo}"
                             FontWeight="Bold" Foreground="#DC2626" />
                        <Run Text=". This action cannot be undone." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="No, Keep Invoice"
                                Command="{Binding DismissCancelConfirmCommand}"
                                Padding="16,8" />
                        <Button Content="⊘ Yes, Cancel Invoice"
                                Command="{Binding ConfirmCancelInvoiceAsyncCommand}"
                                Background="#DC2626"
                                Foreground="White"
                                Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 7. Purchase Return (Debit Note) Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsPurchaseReturnModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="980"
                    MaxHeight="720"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24"
                    Shadow="{ThemeResource SharedShadow}">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="↩️ Make Purchase Return (Debit Note)" FontSize="17" FontWeight="Bold" Foreground="#D97706" />
                                <Border Background="#25D97706" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding ReturnSourcePurchaseNo}" FontSize="11" FontWeight="Bold" Foreground="#D97706" />
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondary}">
                                <Run Text="Original Bill: " />
                                <Run Text="{Binding ReturnSourceInvoice.SupplierInvoiceNo}" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                <Run Text=" | Wholesaler: " />
                                <Run Text="{Binding ReturnSourceInvoice.SupplierName}" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding ClosePurchaseReturnModalCommand}" Padding="8,4" />
                    </Grid>

                    <!-- Return Items Table -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource SurfaceSubtle}"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="0"
                            MinHeight="200"
                            MaxHeight="360">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Table Header -->
                            <Border Grid.Row="0"
                                    Background="{ThemeResource SurfaceDefault}"
                                    BorderBrush="{ThemeResource BorderDefault}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="36,2.4*,1.4*,1*,1*,1*,1.2*,1.2*,1.4*,2*">
                                    <TextBlock Grid.Column="0" Text="RET" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="MEDICINE NAME" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="BATCH NO." FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="EXPIRY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="4" Text="INWARD QTY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="STOCK" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="RET QTY" FontSize="10" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="NET RATE (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="8" Text="RETURN VALUE" FontSize="10" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="9" Text="REASON" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" Margin="8,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ReturnItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource BorderDefault}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="10,6">
                                                <Grid ColumnDefinitions="36,2.4*,1.4*,1*,1*,1*,1.2*,1.2*,1.4*,2*">
                                                    <!-- Select Checkbox -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              MinWidth="24" />

                                                    <!-- Medicine Name -->
                                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                    <!-- Batch Number -->
                                                    <TextBlock Grid.Column="2" Text="{Binding BatchNumber}" FontFamily="Consolas, Fira Code" FontSize="11" VerticalAlignment="Center" />

                                                    <!-- Expiry Date -->
                                                    <TextBlock Grid.Column="3" Text="{Binding ExpiryFormatted}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />

                                                    <!-- Inwarded Quantity -->
                                                    <TextBlock Grid.Column="4" Text="{Binding InwardedQuantity}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                    <!-- Current Available Stock -->
                                                    <TextBlock Grid.Column="5" Text="{Binding AvailableStock}" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                    <!-- Return Quantity Input -->
                                                    <NumberBox Grid.Column="6"
                                                               Value="{Binding ReturnQuantity, Mode=TwoWay}"
                                                               Minimum="0"
                                                               Maximum="{Binding MaxReturnable}"
                                                               SpinButtonPlacementMode="Inline"
                                                               SmallChange="1"
                                                               Width="72"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />

                                                    <!-- Net Buying Rate (Price + GST) -->
                                                    <TextBlock Grid.Column="7" Text="{Binding NetUnitPriceFormatted}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                    <!-- Net Return Value (Deduction from inventory valuation) -->
                                                    <TextBlock Grid.Column="8" Text="{Binding NetAmountFormatted}" FontWeight="Bold" FontSize="12" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                    <!-- Return Reason -->
                                                    <TextBox Grid.Column="9"
                                                             Text="{Binding Reason, Mode=TwoWay}"
                                                             PlaceholderText="e.g. Expired / Damaged"
                                                             FontSize="11"
                                                             Margin="8,0,0,0"
                                                             VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Summary Card -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,12,0,12">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="24">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="VALUATION IMPACT" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Text="Total return value will be immediately deducted from total stock valuation (buying price + GST) and stock balance."
                                           FontSize="11.5" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Selected Items:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TotalReturnSelectedItems}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="Total Return Qty:" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TotalReturnQuantity}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>

                            <Border Grid.Column="3" Background="#20DC2626" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Padding="12,4">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="TOTAL RETURN VALUE" FontSize="9" FontWeight="Bold" Foreground="#DC2626" />
                                    <TextBlock Text="{Binding TotalReturnAmountFormatted}" FontSize="17" FontWeight="Bold" Foreground="#DC2626" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancel" Command="{Binding ClosePurchaseReturnModalCommand}" Padding="16,6" />
                        <Button Content="↩️ Confirm &amp; Generate Return Bill"
                                Command="{Binding ConfirmPurchaseReturnCommand}"
                                Background="#D97706"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="20,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 8. Generated Purchase Return Bill Preview Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsPurchaseReturnBillModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="840"
                    MaxHeight="700"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24"
                    Shadow="{ThemeResource SharedShadow}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Bill Header -->
                    <Border Grid.Row="0" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="MEDISTOCK PHARMACEUTICALS &amp; DISTRIBUTORS" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="DEBIT NOTE / PURCHASE RETURN VOUCHER" FontSize="13" FontWeight="SemiBold" Foreground="#D97706" />
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedVoucherNo}" FontWeight="Bold" FontFamily="Consolas, Fira Code" />
                                    <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedReturnDate}" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedRefInvoice}" FontFamily="Consolas, Fira Code" />
                                    <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedRefPo}" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" FontFamily="Consolas, Fira Code" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <TextBlock Text="Return To Vendor:" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Text="{Binding CurrentPurchaseReturnBill.SupplierName}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedGstin}" Foreground="{ThemeResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#20059669" BorderBrush="{StaticResource BrandGreen}" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Top">
                                <TextBlock Text="✓ RETURN RECORDED" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrandGreen}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Items Table -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource SurfaceSubtle}"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{ThemeResource SurfaceDefault}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid ColumnDefinitions="2.5*,1.5*,1*,1*,1.2*,1.2*,2*">
                                    <TextBlock Grid.Column="0" Text="MEDICINE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="BATCH" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="EXPIRY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="RET QTY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="NET RATE (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="NET VALUE (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="REASON" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentPurchaseReturnBill.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid ColumnDefinitions="2.5*,1.5*,1*,1*,1.2*,1.2*,2*">
                                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding BatchNumber}" FontFamily="Consolas, Fira Code" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedExpiry}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ReturnQuantity}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding NetUnitPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding NetAmount, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="Bold" FontSize="12" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Reason}" FontSize="11" Foreground="{ThemeResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Footer & Grand Total -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedItemsCount}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedTotalQuantity}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding CurrentPurchaseReturnBill.FormattedTotalDeducted}" FontWeight="Bold" FontSize="13" Foreground="#DC2626" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Content="🖨️ Print Return Bill"
                                    Command="{Binding PrintPurchaseReturnBillCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="16,6" />
                            <Button Content="Close"
                                    Command="{Binding ClosePurchaseReturnBillModalCommand}"
                                    Padding="16,6" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- EXIT CONFIRMATION DIALOG (When Esc pressed with data entered) -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsExitConfirmDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#99000000"
              Margin="-20"
              Canvas.ZIndex="1200">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource BorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="24"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Shadow="{StaticResource SharedShadow}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚠️" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Discard Purchase Changes?" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="You have entered supplier or medicine details in this bill." FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="What would you like to do before leaving Purchase Entry?" FontSize="12" Foreground="{ThemeResource TextSecondary}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Content="🗑️ Discard &amp; Exit"
                                Command="{Binding DiscardAndExitCommand}"
                                Background="#DC2626"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="8,8"
                                HorizontalAlignment="Stretch" />

                        <Button Grid.Column="1"
                                Content="💾 Save Draft"
                                Command="{Binding SaveDraftAndExitCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                FontWeight="SemiBold"
                                Padding="8,8"
                                HorizontalAlignment="Stretch" />

                        <Button Grid.Column="2"
                                Content="✕ Keep Editing"
                                Command="{Binding CancelExitDialogCommand}"
                                Padding="8,8"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SAVE PURCHASE INVOICE SUMMARY CONFIRMATION MODAL -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsSaveSummaryModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#99000000"
              Margin="-20"
              Canvas.ZIndex="1300">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource BorderStrong}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="24"
                    Width="780"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Shadow="{StaticResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💾" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Text="Confirm Purchase Inward Invoice" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CancelSaveSummaryCommand}"
                                Padding="8,4"
                                Background="Transparent"
                                BorderThickness="0" />
                    </Grid>

                    <!-- Summary Card (Supplier Info) -->
                    <Border Grid.Row="1" Background="{ThemeResource SurfaceSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Wholesaler:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedSupplierName}" FontWeight="Bold" FontSize="13" Margin="8,0,16,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="GSTIN:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="3" Text="{Binding SupplierGstin}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Invoice No:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding SupplierInvoiceNo}" FontWeight="Bold" FontSize="12.5" Margin="8,0,16,0" />
                                <TextBlock Grid.Column="2" Text="Date:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Grid.Column="3" Text="{Binding SupplierInvoiceDateText}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Items Table Preview -->
                    <Border Grid.Row="2" Background="{ThemeResource SurfaceSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" MinHeight="140" MaxHeight="260">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{ThemeResource SurfaceDefault}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="10,6">
                                <Grid ColumnDefinitions="3*,1.4*,1.2*,1*,1.2*,1.2*,1.4*">
                                    <TextBlock Grid.Column="0" Text="MEDICINE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="BATCH" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="EXPIRY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="QTY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="RATE (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="TAX %" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="TOTAL (₹)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PreviewLineItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="10,6">
                                                <Grid ColumnDefinitions="3*,1.4*,1.2*,1*,1.2*,1.2*,1.4*">
                                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding BatchNumber}" FontFamily="Consolas, Fira Code" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ExpiryFormatted}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Quantity}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding GstRatePercent, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6" Text="{Binding LineTotal, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandGreen}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Total Amount Banner -->
                    <Border Grid.Row="3" Background="{StaticResource BrandGreenLight}" BorderBrush="{StaticResource BrandGreen}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid ColumnDefinitions="*,*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Taxable Subtotal:" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TaxableSubtotal, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Total GST (Tax):" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{Binding TotalTax, Converter={StaticResource CurrencyFormatConverter}}" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="1">
                                <TextBlock Text="NET PAYABLE GRAND TOTAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyFormatConverter}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Text="[Enter: Confirm &amp; Save • Esc: Cancel / Keep Editing]" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CancelSaveSummaryButton"
                                    Content="✕ Cancel [Esc]"
                                    Command="{Binding CancelSaveSummaryCommand}"
                                    KeyDown="SaveSummaryModalBtn_KeyDown"
                                    PreviewKeyDown="SaveSummaryModalBtn_PreviewKeyDown"
                                    Padding="14,6" />
                            <Button x:Name="ConfirmSaveSummaryButton"
                                    Content="💾 Confirm &amp; Save [Enter]"
                                    Command="{Binding ConfirmAndSavePurchaseCommand}"
                                    KeyDown="SaveSummaryModalBtn_KeyDown"
                                    PreviewKeyDown="SaveSummaryModalBtn_PreviewKeyDown"
                                    Style="{StaticResource AccentButtonStyle}"
                                    FontWeight="Bold"
                                    Padding="18,6" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

