<Page
    x:Class="Medistock.Desktop.Views.B2B.B2bCommercePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    xmlns:b2b="using:Medistock.Contracts.B2B"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,*" Margin="20,16,20,16" RowSpacing="12">
        <!-- 1. Header Toolbar & Status Ribbon -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="B2B Pharmacy-to-Wholesaler Commerce" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}"/>
                <TextBlock Text="Browse wholesaler digital catalogs, order bulk medicine deals with schemes, and track live deliveries." Foreground="{ThemeResource TextSecondary}" FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.RefreshCatalogCommand}" ToolTipService.ToolTip="Refresh Catalog">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. KPI Ribbon Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <!-- Wholesalers Active -->
            <Border Grid.Column="0" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="DISTRIBUTOR NETWORK" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBlock Text="{x:Bind ViewModel.ActiveWholesalersCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}"/>
                    <TextBlock Text="Verified distributors connected" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Total POs -->
            <Border Grid.Column="1" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="TOTAL ORDERS PLACED" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalOrdersCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}"/>
                    <TextBlock Text="Lifetime B2B procurement" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Pending Delivery -->
            <Border Grid.Column="2" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="IN-TRANSIT / PENDING" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBlock Text="{x:Bind ViewModel.PendingDeliveryCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource Warning}"/>
                    <TextBlock Text="Awaiting store delivery" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Total Spend -->
            <Border Grid.Column="3" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="TOTAL PROCUREMENT SPEND" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalOrderSpend, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}"/>
                    <TextBlock Text="Cumulative B2B invoice volume" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Main Content TabView -->
        <TabView Grid.Row="2" SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}" IsAddTabButtonVisible="False">
            <!-- TAB 1: Catalog & Order Placement -->
            <TabViewItem Header="Wholesaler Marketplace &amp; Ordering" IsClosable="False">
                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14" Margin="0,10,0,0">
                    <!-- Left: Catalog Search & Item List -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox PlaceholderText="Search medicine name, salt, or distributor scheme..." Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCatalogCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                                    <TextBlock Text="Search"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Catalog Items List -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CatalogItems, Mode=OneWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="b2b:WholesalerCatalogItemDto">
                                    <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind BrandName}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextPrimary}"/>
                                                    <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{x:Bind WholesalerName}" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind GenericName}" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                    <TextBlock Text="{x:Bind Strength}" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                                                    <TextBlock Text="{x:Bind Manufacturer}" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                                                    <Border Background="{ThemeResource AccentSubtle}" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="{x:Bind SchemeDescription, TargetNullValue='Standard Price'}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Pricing Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{x:Bind WholesaleRate}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}"/>
                                                <TextBlock Text="Wholesale Rate" FontSize="10" Foreground="{ThemeResource TextSecondary}"/>
                                                <TextBlock Text="{x:Bind Mrp}" FontSize="11" TextDecorations="Strikethrough" Foreground="{ThemeResource TextSecondary}"/>
                                            </StackPanel>

                                            <!-- Add to Cart Button -->
                                            <Button Grid.Column="2" VerticalAlignment="Center" Click="AddToCart_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                    <TextBlock Text="Add PO"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Right: Running Purchase Order Cart -->
                    <Border Grid.Column="1" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="New Purchase Order" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource TextPrimary}"/>
                                <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearCartCommand}"/>
                            </Grid>

                            <!-- Cart Items -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:B2bCartItemViewModel">
                                        <Border BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind FormattedRate}" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                                                        <TextBlock Text="{x:Bind GstRate}" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                                                        <TextBlock Text="% GST" FontSize="11" Foreground="{ThemeResource TextSecondary}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Quantity and Free -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                    <NumberBox Value="{x:Bind Quantity, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Compact" Width="80"/>
                                                </StackPanel>

                                                <!-- Item Total & Remove -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind FormattedTotal}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimary}"/>
                                                    <Button Content="✕" Click="RemoveCartItem_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Cart Summary & Submit -->
                            <StackPanel Grid.Row="2" Spacing="8">
                                <TextBox Header="Delivery Address" Text="{x:Bind ViewModel.DeliveryAddress, Mode=TwoWay}"/>
                                <TextBox Header="PO Notes / Specifics" Text="{x:Bind ViewModel.OrderNotes, Mode=TwoWay}"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBlock Text="Taxable Subtotal:" Foreground="{ThemeResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CartSubtotal, Mode=OneWay}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Estimated GST:" Foreground="{ThemeResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CartTax, Mode=OneWay}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Total Payable Amount:" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource TextPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CartGrandTotal, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentPrimary}"/>
                                </Grid>

                                <Button Command="{x:Bind ViewModel.SubmitPurchaseOrderCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BF;" FontSize="16"/>
                                        <TextBlock Text="Place B2B Purchase Order" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- TAB 2: Purchase Order Tracking & Receiving -->
            <TabViewItem Header="Order Tracker &amp; Inward Receipts" IsClosable="False">
                <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,10,0,0">
                    <!-- Orders List -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.PurchaseOrders, Mode=OneWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="b2b:B2bOrderSummaryDto">
                                <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                        <!-- PO Number & Date -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind OrderNumber}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentPrimary}"/>
                                            <TextBlock Text="{x:Bind WholesalerName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                                        </StackPanel>

                                        <!-- Items & Delivery Details -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind TotalItems}" FontSize="12"/>
                                                <TextBlock Text="Line Items" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                                                <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                                                <TextBlock Text="{x:Bind DispatchTrackingNumber, TargetNullValue='No tracking ID'}" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Badge & Amount -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                            <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind Status}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextPrimary}"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind TotalAmount}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" Foreground="{ThemeResource TextPrimary}"/>
                                        </StackPanel>

                                        <!-- Action: Receive & Stock -->
                                        <Button Grid.Column="3" VerticalAlignment="Center" Click="ReceiveOrder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                                <TextBlock Text="Receive &amp; Inward Stock"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
