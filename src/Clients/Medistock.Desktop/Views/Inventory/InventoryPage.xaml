<Page
    x:Class="Medistock.Desktop.Views.Inventory.InventoryPage"
    x:Name="StockTableRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Page.Resources>
        <Style x:Key="MetricCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20">
        <!-- 1. Top Section: Header & Executive KPI Summary Banner -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Title Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="📦 Inventory &amp; Stock Master"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="Enterprise batch ledger, FEFO expiry tracking, and real-time inventory valuation"
                               FontSize="12"
                               Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>

                <!-- Export Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ExportExcelCommand}"
                            ToolTipService.ToolTip="Export full stock ledger to Microsoft Excel (.xlsx)"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📊" FontSize="13" />
                            <TextBlock Text="Excel (.xlsx)" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportWordCommand}"
                            ToolTipService.ToolTip="Export formatted report to Microsoft Word (.docx)"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📄" FontSize="13" />
                            <TextBlock Text="Word (.docx)" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportPdfCommand}"
                            ToolTipService.ToolTip="Export executive print-ready PDF / HTML report"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📕" FontSize="13" />
                            <TextBlock Text="PDF Report" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 Stock & Inventory KPI Metric Summary Cards -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <!-- Card 1: Total Products Available -->
                <Button Grid.Column="0"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="TotalProducts"
                        ToolTipService.ToolTip="Click to view all products and active stock batches">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="TOTAL PRODUCTS AVAILABLE" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalProductsAvailable}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="{Binding TotalBatchesCountDisplay}" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Unique active items in stock" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Card 2: Expiry Near / Expired -->
                <Button Grid.Column="1"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="ExpiryNear"
                        ToolTipService.ToolTip="Click to view all near expiry and expired batch details">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="#80DC2626"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="EXPIRY NEAR / EXPIRED" FontSize="9.5" FontWeight="Bold" Foreground="#DC2626" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="#DC2626" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpiryNearProductsCount}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" />
                                <Border Background="#25DC2626" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="ATTENTION" FontSize="8.5" FontWeight="Bold" Foreground="#DC2626" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="≤ threshold days or expired" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Card 3: Low Stock / OOS -->
                <Button Grid.Column="2"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="LowStock"
                        ToolTipService.ToolTip="Click to view reorder list for low and out-of-stock items">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="#80D97706"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="LOW STOCK / OUT OF STOCK" FontSize="9.5" FontWeight="Bold" Foreground="#D97706" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="#D97706" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LowStockProductsCount}" FontSize="20" FontWeight="Bold" Foreground="#D97706" />
                                <Border Background="#25D97706" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="REORDER" FontSize="8.5" FontWeight="Bold" Foreground="#D97706" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="At or below min alert level" FontSize="10" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Card 4: Total Stock Valuation -->
                <Button Grid.Column="3"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="StockValuation"
                        ToolTipService.ToolTip="Click to view complete stock valuation breakdown">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="{ThemeResource AccentPrimary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="TOTAL STOCK VALUATION (NET RATE)" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="₹" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalStockValueFormatted}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding TotalStockValueMrpFormatted}" FontSize="10" Foreground="{ThemeResource TextSecondary}" ToolTipService.ToolTip="Valuation calculated as Net Buying Cost (Buying Cost + GST %) × Available Quantity" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <!-- 4 Financial & Sales Collection KPI Cards -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" Margin="0,8,0,0">
                <!-- Financial Card 1: Estimated Profit -->
                <Button Grid.Column="0"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="EstimatedProfit"
                        ToolTipService.ToolTip="Click to view estimated profit breakdown (MRP - Product buying cost)">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="#8016A34A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="ESTIMATED PROFIT" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="#16A34A" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="₹" FontSize="14" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EstimatedProfitFormatted}" FontSize="20" FontWeight="Bold" Foreground="#16A34A" />
                            </StackPanel>
                            <TextBlock Text="{Binding EstimatedProfitMarginDisplay}" FontSize="10" Foreground="{ThemeResource TextSecondary}" ToolTipService.ToolTip="Estimated profit margin on active inventory stock (MRP - Buying Cost)" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Financial Card 2: Revenue This Month -->
                <Button Grid.Column="1"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="RevenueThisMonth"
                        ToolTipService.ToolTip="Click to view finalized sales invoices this month">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="{ThemeResource AccentPrimary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="REVENUE THIS MONTH" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="₹" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RevenueThisMonthFormatted}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MonthlyInvoicesCountDisplay}" FontSize="10" Foreground="{ThemeResource TextSecondary}" ToolTipService.ToolTip="Total sales revenue finalized in the current calendar month" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Financial Card 3: Cash Collection -->
                <Button Grid.Column="2"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="CashCollection"
                        ToolTipService.ToolTip="Click to view cash payments collected this month">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="#800D9488"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CASH COLLECTION" FontSize="9.5" FontWeight="Bold" Foreground="#0D9488" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="#0D9488" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="₹" FontSize="14" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CashCollectionThisMonthFormatted}" FontSize="20" FontWeight="Bold" Foreground="#0D9488" />
                            </StackPanel>
                            <TextBlock Text="{Binding CashCollectionCountDisplay}" FontSize="10" Foreground="{ThemeResource TextSecondary}" ToolTipService.ToolTip="Cash payments collected from invoices this month" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Financial Card 4: Online Collection -->
                <Button Grid.Column="3"
                        Style="{StaticResource MetricCardButtonStyle}"
                        Command="{Binding ShowMetricDetailCommand}"
                        CommandParameter="OnlineCollection"
                        ToolTipService.ToolTip="Click to view UPI, QR &amp; Card digital payments this month">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="#807C3AED"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="ONLINE COLLECTION" FontSize="9.5" FontWeight="Bold" Foreground="#7C3AED" />
                                <TextBlock Grid.Column="1" Text="Details ↗" FontSize="9" FontWeight="SemiBold" Foreground="#7C3AED" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="₹" FontSize="14" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OnlineCollectionThisMonthFormatted}" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" />
                            </StackPanel>
                            <TextBlock Text="{Binding OnlineCollectionCountDisplay}" FontSize="10" Foreground="{ThemeResource TextSecondary}" ToolTipService.ToolTip="Digital payments collected via UPI, QR code &amp; Card this month" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Grid>

        <!-- 2. Filter & Quick Search Bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource SurfaceDefault}"
                BorderBrush="{ThemeResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="3*,Auto,Auto,Auto">
                    <!-- Search Input -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍 Search by product name, generic salt, batch number..."
                             Margin="0,0,10,0" />

                    <!-- Quick Filter Segmented Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,10,0">
                        <Button Content="All Batches"
                                FontSize="11.5"
                                Padding="10,5"
                                Command="{Binding SelectFilterTabCommand}"
                                CommandParameter="All" />
                        <Button Content="⚠️ Near Expiry"
                                FontSize="11.5"
                                Padding="10,5"
                                Command="{Binding SelectFilterTabCommand}"
                                CommandParameter="NearExpiry" />
                        <Button Content="🚨 Expired"
                                FontSize="11.5"
                                Padding="10,5"
                                Command="{Binding SelectFilterTabCommand}"
                                CommandParameter="Expired" />
                        <Button Content="📉 Low Stock"
                                FontSize="11.5"
                                Padding="10,5"
                                Command="{Binding SelectFilterTabCommand}"
                                CommandParameter="LowStock" />
                        <Button Content="💊 Schedule"
                                FontSize="11.5"
                                Padding="10,5"
                                Command="{Binding SelectFilterTabCommand}"
                                CommandParameter="ScheduleDrugs" />
                    </StackPanel>

                    <!-- Filter & Refresh -->
                    <Button Grid.Column="2"
                            Command="{Binding LoadStocksCommand}"
                            Content="Apply Filter"
                            Style="{StaticResource AccentButtonStyle}"
                            FontSize="11.5"
                            Padding="12,5"
                            Margin="0,0,6,0" />

                    <Button Grid.Column="3"
                            Command="{Binding LoadStocksCommand}"
                            Content="🔄 Refresh"
                            FontSize="11.5"
                            Padding="10,5" />
                </Grid>

                <!-- Feedback Banner -->
                <InfoBar Grid.Row="1"
                         IsOpen="{Binding HasExportMessage, Mode=OneWay}"
                         Severity="Informational"
                         Message="{Binding ExportStatusMessage}"
                         IsClosable="True"
                         Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- 3. Professional High-Density Data Table -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceDefault}"
                BorderBrush="{ThemeResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0">
            <Grid RowDefinitions="Auto,*">
                <!-- Table Header Row -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="3.0*,1.1*,1.1*,0.9*,1.0*,0.9*,1.0*,1.0*,1.2*,0.9*,1.3*"
                      Padding="12,8"
                      Background="{ThemeResource SurfaceSubtle}"
                      BorderBrush="{ThemeResource BorderDefault}"
                      BorderThickness="0,0,0,1">
                    <TextBlock Grid.Column="0" Text="PRODUCT &amp; COMPOSITION" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="EXPIRY" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="SCHEDULE" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="AVAIL QTY" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="MIN ALERT" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="MRP (₹)" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="COST (₹)" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="8" Text="VALUATION (₹)" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="9" Text="STATUS" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="10" Text="ACTIONS" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Table Data Rows -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding StockItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                    BorderBrush="{ThemeResource BorderDefault}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,6">
                                <Grid ColumnDefinitions="3.0*,1.1*,1.1*,0.9*,1.0*,0.9*,1.0*,1.0*,1.2*,0.9*,1.3*">
                                    <!-- 0. Product Name & Salt Composition -->
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding GenericName}" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 1. Batch Number -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BatchNumber}"
                                               FontFamily="Consolas, Fira Code, Segoe UI Mono"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TextPrimary}"
                                               VerticalAlignment="Center" />

                                    <!-- 2. Expiry Date & Expiry Badge -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding ExpiryText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding ExpiryForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}" />
                                        <TextBlock Text="{Binding ExpiryBadgeText}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding ExpiryBadgeColor, Converter={StaticResource HexToSolidColorBrushConverter}}" />
                                    </StackPanel>

                                    <!-- 3. Schedule Badge -->
                                    <Border Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource AccentSubtle}"
                                            CornerRadius="3"
                                            Padding="5,1.5">
                                        <TextBlock Text="{Binding ScheduleBadgeText}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentPrimary}" />
                                    </Border>

                                    <!-- 4. Available Quantity -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding StockDisplay}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{Binding StockForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- 5. Minimum Alert Level -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding MinStockAlert}"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- 6. MRP -->
                                    <TextBlock Grid.Column="6" Text="{Binding MrpFormatted}" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <!-- 7. Cost / Purchase Rate -->
                                    <TextBlock Grid.Column="7" Text="{Binding PurchaseRateFormatted}" FontSize="11.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <!-- 8. Stock Valuation (Cost) -->
                                    <TextBlock Grid.Column="8" Text="{Binding StockValueAtCostFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <!-- 9. Status Pill -->
                                    <Border Grid.Column="9"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Background="{Binding StatusBadgeBackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                            CornerRadius="3"
                                            Padding="5,2">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding StatusBadgeForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}" />
                                    </Border>

                                    <!-- 10. Actions -->
                                    <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="✏️ Edit Details"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Padding="8,3"
                                                Command="{Binding DataContext.OpenEditProductCommand, ElementName=StockTableRoot}"
                                                CommandParameter="{Binding}"
                                                ToolTipService.ToolTip="Edit product information and batch details" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 4. Edit Product Details Modal Popup -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsEditProductModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="680"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <!-- Modal Title Bar -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="✏️" FontSize="18" />
                                <TextBlock Text="Edit Product Details" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Command="{Binding CloseEditProductCommand}" Padding="6,2" />
                        </Grid>

                        <!-- Error Message Alert if any -->
                        <Border Visibility="{Binding EditErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#25DC2626"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6">
                            <TextBlock Text="{Binding EditErrorMessage}" Foreground="#DC2626" FontSize="11.5" TextWrapping="Wrap" />
                        </Border>

                        <!-- Section: Product Master Info -->
                        <TextBlock Text="Product Master Information" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
                        
                        <Grid ColumnDefinitions="*,*">
                            <TextBox x:Name="EditProductNameBox"
                                     Header="Product Name *"
                                     Text="{Binding EditProductName, Mode=TwoWay}"
                                     PlaceholderText="Brand / Trade Name"
                                     Margin="0,0,6,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <TextBox x:Name="EditGenericNameBox"
                                     Grid.Column="1"
                                     Header="Generic Name"
                                     Text="{Binding EditGenericName, Mode=TwoWay}"
                                     PlaceholderText="Generic Molecule Name"
                                     Margin="6,0,0,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <TextBox x:Name="EditSaltCompositionBox"
                                     Header="Salt Composition"
                                     Text="{Binding EditSaltComposition, Mode=TwoWay}"
                                     PlaceholderText="e.g. Paracetamol 650mg"
                                     Margin="0,0,6,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <TextBox x:Name="EditManufacturerBox"
                                     Grid.Column="1"
                                     Header="Manufacturer"
                                     Text="{Binding EditManufacturer, Mode=TwoWay}"
                                     PlaceholderText="e.g. Cipla / Sun Pharma"
                                     Margin="6,0,0,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*">
                            <TextBox x:Name="EditCategoryNameBox"
                                     Header="Category / Unit"
                                     Text="{Binding EditCategoryName, Mode=TwoWay}"
                                     PlaceholderText="e.g. TAB, SYR"
                                     Margin="0,0,4,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <TextBox x:Name="EditHsnCodeBox"
                                     Grid.Column="1"
                                     Header="HSN Code"
                                     Text="{Binding EditHsnCode, Mode=TwoWay}"
                                     PlaceholderText="3004"
                                     Margin="4,0,4,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <TextBox x:Name="EditGstRatePercentBox"
                                     Grid.Column="2"
                                     Header="GST Rate (%)"
                                     Text="{Binding EditGstRatePercent, Mode=TwoWay}"
                                     PlaceholderText="12.0"
                                     Margin="4,0,0,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <ComboBox x:Name="EditScheduleComboBox"
                                      Header="Drug Schedule"
                                      SelectedIndex="{Binding EditScheduleIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,6,0"
                                      PreviewKeyDown="EditProductInput_PreviewKeyDown">
                                <ComboBoxItem Content="OTC (Over The Counter)" />
                                <ComboBoxItem Content="Schedule H (Rx Required)" />
                                <ComboBoxItem Content="Schedule H1 (High Risk Rx)" />
                                <ComboBoxItem Content="Schedule X (Narcotic / Controlled)" />
                            </ComboBox>
                            <TextBox x:Name="EditMinStockAlertBox"
                                     Grid.Column="1"
                                     Header="Min Stock Alert Threshold"
                                     Text="{Binding EditMinStockAlert, Mode=TwoWay}"
                                     PlaceholderText="10"
                                     Margin="6,0,0,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                        </Grid>

                        <!-- Section: Batch Details (Editable) -->
                        <TextBlock Text="Selected Batch &amp; Pricing Details" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" Margin="0,6,0,0" />

                        <Grid ColumnDefinitions="*,*">
                            <TextBox x:Name="EditBatchNumberBox"
                                     Header="Batch Number"
                                     Text="{Binding EditBatchNumber, Mode=TwoWay}"
                                     PlaceholderText="Batch No"
                                     Margin="0,0,6,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <DatePicker x:Name="EditExpiryDatePicker"
                                        Grid.Column="1"
                                        Header="Expiry Date"
                                        Date="{Binding EditExpiryDate, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch"
                                        Margin="6,0,0,0"
                                        PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*">
                            <TextBox x:Name="EditMrpBox"
                                     Header="MRP (₹)"
                                     Text="{Binding EditMrp, Mode=TwoWay}"
                                     Margin="0,0,4,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <TextBox x:Name="EditPurchaseRateBox"
                                     Grid.Column="1"
                                     Header="Purchase Rate (₹)"
                                     Text="{Binding EditPurchaseRate, Mode=TwoWay}"
                                     Margin="4,0,4,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <TextBox x:Name="EditSaleRateBox"
                                     Grid.Column="2"
                                     Header="Sale Rate (₹)"
                                     Text="{Binding EditSaleRate, Mode=TwoWay}"
                                     Margin="4,0,0,0"
                                     PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
                            <Button x:Name="CancelEditProductButton"
                                    Content="Cancel [Esc]"
                                    Command="{Binding CloseEditProductCommand}"
                                    Padding="16,6"
                                    PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                            <Button x:Name="SaveEditProductButton"
                                    Content="Save Changes [Enter]"
                                    Command="{Binding SaveProductDetailsCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="20,6"
                                    PreviewKeyDown="EditProductInput_PreviewKeyDown" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 5. Metric Actual Details Breakdown Modal Popup -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsMetricDetailModalOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#90000000"
              Margin="-20">
            <Border Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="1100"
                    MaxHeight="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,18"
                    Shadow="{ThemeResource SharedShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <TextBlock Text="{Binding MetricDetailTitle}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="{Binding MetricDetailSummary}" FontSize="12" Foreground="{ThemeResource AccentPrimary}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                FontSize="13"
                                FontWeight="Bold"
                                Padding="8,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding CloseMetricDetailCommand}" />
                    </Grid>

                    <!-- Search Filter & Export inside Modal -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBox Grid.Column="0"
                                 Text="{Binding MetricDetailSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="🔍 Search in actual details by product, batch, customer, date..."
                                 Margin="0,0,10,0" />
                        <Button Grid.Column="1"
                                Command="{Binding ExportMetricDetailCsvCommand}"
                                Padding="12,6"
                                ToolTipService.ToolTip="Export these actual itemized details to CSV (.csv)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📥" FontSize="12" />
                                <TextBlock Text="Export CSV" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Table Container -->
                    <Border Grid.Row="2"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{ThemeResource SurfaceSubtle}">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Table Header -->
                            <Border Grid.Row="0"
                                    Background="{ThemeResource SurfaceDefault}"
                                    BorderBrush="{ThemeResource BorderDefault}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="2.6*,1.2*,1.2*,1*,1*,1*,1.1*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding MetricDetailCol1Header}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding MetricDetailCol2Header}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="{Binding MetricDetailCol3Header}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding MetricDetailCol4Header}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding MetricDetailCol5Header}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{Binding MetricDetailCol6Header}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="{Binding MetricDetailCol7Header}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" Width="85" TextAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding MetricDetailRows}"
                                      SelectionMode="None"
                                      MaxHeight="430"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource BorderDefault}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,6">
                                            <Grid ColumnDefinitions="2.6*,1.2*,1.2*,1*,1*,1*,1.1*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Col1}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Col2}" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" FontFamily="Consolas, Fira Code, Segoe UI Mono" />
                                                <TextBlock Grid.Column="2" Text="{Binding Col3}" FontSize="10.5" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Col4}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding Col5}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="{Binding Col6}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="6" Text="{Binding Col7}" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <Border Grid.Column="7"
                                                        Width="85"
                                                        Background="{Binding BadgeBackgroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                        CornerRadius="3"
                                                        Padding="4,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding BadgeText}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding BadgeForegroundHex, Converter={StaticResource HexToSolidColorBrushConverter}}"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Modal Footer -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
                        <Button Content="Close [Esc]"
                                Command="{Binding CloseMetricDetailCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="20,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
