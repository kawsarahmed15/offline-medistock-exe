<Page
    x:Class="Medistock.Desktop.Views.Inventory.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- 1. Header & Filter Toolbar -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="📦 Inventory &amp; Stock Master"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="Multi-batch tracking, expiry band monitoring, and stock adjustments"
                               FontSize="13"
                               Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>

                <!-- KPI Quick Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,8">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <TextBlock Text="TOTAL BATCHES" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding TotalItemsCount}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource SurfaceDefault}"
                            BorderBrush="{ThemeResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,8">
                        <StackPanel Orientation="Vertical" Spacing="2">
                            <TextBlock Text="INVENTORY VALUE (COST)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                            <TextBlock Text="{Binding TotalStockValue, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Filter Row -->
            <Border Grid.Row="1"
                    Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍 Search product, generic salt, batch number..."
                             Margin="0,0,12,0" />

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding LowStockOnly, Mode=TwoWay}"
                              Content="Low Stock Only (≤10)"
                              Margin="0,0,12,0" />

                    <Button Grid.Column="2"
                            Command="{Binding LoadStocksCommand}"
                            Content="Apply Filter"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="3"
                            Command="{Binding LoadStocksCommand}"
                            Content="🔄 Refresh" />
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Stock Table / ListView -->
        <Border Grid.Row="1"
                Background="{ThemeResource SurfaceDefault}"
                BorderBrush="{ThemeResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <Grid RowDefinitions="Auto,*">
                <!-- Column Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="3*,1.5*,1.5*,1.5*,1*,1*,1*,1.5*"
                      Padding="12,8"
                      Background="{ThemeResource SurfaceSubtle}"
                      CornerRadius="4"
                      Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="PRODUCT &amp; COMPOSITION" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="2" Text="EXPIRY DATE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="3" Text="SCHEDULE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="4" Text="AVAIL QTY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="MRP (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="COST (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="ACTIONS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" />
                </Grid>

                <!-- Stock Items List -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding StockItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="3*,1.5*,1.5*,1.5*,1*,1*,1*,1.5*"
                                  Padding="8,6"
                                  BorderBrush="{ThemeResource BorderDefault}"
                                  BorderThickness="0,0,0,1">
                                <!-- Product Info -->
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                                    <TextBlock Text="{Binding GenericName}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                    <TextBlock Text="{Binding SaltComposition}" FontSize="10" Foreground="{ThemeResource TextMuted}" />
                                </StackPanel>

                                <!-- Batch No -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BatchNumber}"
                                           FontFamily="Consolas, Fira Code"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />

                                <!-- Expiry Badge -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding ExpiryText}" FontSize="12" Foreground="{ThemeResource TextPrimary}" />
                                    <Border Background="{ThemeResource SurfaceSubtle}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ExpiryBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding ExpiryBadgeColor}" />
                                    </Border>
                                </StackPanel>

                                <!-- Schedule Badge -->
                                <Border Grid.Column="3"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentSubtle}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{Binding ScheduleBadgeText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentPrimary}" />
                                </Border>

                                <!-- Quantities & Pricing -->
                                <TextBlock Grid.Column="4" Text="{Binding AvailableQuantity}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{Binding Mrp}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="{Binding PurchaseRate}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="Quarantine"
                                            FontSize="10"
                                            Padding="6,2"
                                            Command="{Binding DataContext.QuarantineExpiredBatchCommand, ElementName=ShortcutsList}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
