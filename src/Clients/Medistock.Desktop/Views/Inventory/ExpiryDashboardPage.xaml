<Page
    x:Class="Medistock.Desktop.Views.Inventory.ExpiryDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <!-- 1. Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="⏳ Expiry Risk &amp; Quarantine Dashboard"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}" />
                <TextBlock Text="Real-time statutory expiry monitoring, value-at-risk analysis, and FEFO alerts"
                           FontSize="13"
                           Foreground="{ThemeResource TextSecondary}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding LoadDashboardCommand}"
                    Content="🔄 Refresh Analytics"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- 2. 4-Band KPI Cards Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,24">
            <!-- Band 1: Expired -->
            <Border Grid.Column="0"
                    Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="#DC2626"
                    BorderThickness="2,0,0,0"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔴" FontSize="14" />
                        <TextBlock Text="EXPIRED" FontSize="11" FontWeight="Bold" Foreground="#DC2626" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExpiredCount}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="{Binding ExpiredValue, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Band 2: Critical (<=30d) -->
            <Border Grid.Column="1"
                    Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="#EA580C"
                    BorderThickness="2,0,0,0"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔴" FontSize="14" />
                        <TextBlock Text="CRITICAL (≤30D)" FontSize="11" FontWeight="Bold" Foreground="#EA580C" />
                    </StackPanel>
                    <TextBlock Text="{Binding CriticalCount}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="{Binding CriticalValue, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Band 3: Warning (31-90d) -->
            <Border Grid.Column="2"
                    Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="#D97706"
                    BorderThickness="2,0,0,0"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🟡" FontSize="14" />
                        <TextBlock Text="WARNING (31-90D)" FontSize="11" FontWeight="Bold" Foreground="#D97706" />
                    </StackPanel>
                    <TextBlock Text="{Binding WarningCount}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="{Binding WarningValue, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Band 4: Good (>90d) -->
            <Border Grid.Column="3"
                    Background="{ThemeResource SurfaceDefault}"
                    BorderBrush="#16A34A"
                    BorderThickness="2,0,0,0"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🟢" FontSize="14" />
                        <TextBlock Text="GOOD (>90D)" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                    </StackPanel>
                    <TextBlock Text="{Binding GoodCount}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="{Binding GoodValue, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Urgent Action Table -->
        <Border Grid.Row="2"
                Background="{ThemeResource SurfaceDefault}"
                BorderBrush="{ThemeResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0"
                           Text="🚨 Urgent Action Required: Expired &amp; Near-Expiry Batches"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"
                           Margin="0,0,0,12" />

                <!-- Headers -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="3*,1.5*,1.5*,1*,1*,1.5*"
                      Padding="8,6"
                      Background="{ThemeResource SurfaceSubtle}"
                      CornerRadius="4"
                      Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="PRODUCT NAME" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="BATCH NO." FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="2" Text="EXPIRY DATE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" />
                    <TextBlock Grid.Column="3" Text="QUANTITY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="VALUE AT RISK (₹)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMuted}" HorizontalAlignment="Center" />
                </Grid>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding UrgentExpiryBatches}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="3*,1.5*,1.5*,1*,1*,1.5*"
                                  Padding="8,6"
                                  BorderBrush="{ThemeResource BorderDefault}"
                                  BorderThickness="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BatchNumber}" FontFamily="Consolas, Fira Code" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ExpiryText}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding AvailableQuantity}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding StockValueAtCost}" FontSize="12" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <Border Grid.Column="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SurfaceSubtle}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{Binding ExpiryBadgeText}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{Binding ExpiryBadgeColor}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
