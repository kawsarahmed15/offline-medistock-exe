<Page
    x:Class="Medistock.Desktop.Views.Inventory.StockTransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dtos="using:Medistock.Application.Inventory.DTOs"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. Header Toolbar -->
        <Grid Grid.Row="0" Background="{ThemeResource SurfaceBackground}" Padding="16,12" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="INTER-BRANCH STOCK TRANSFERS" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="● Multi-Branch Rebalancing &amp; Transit Audit" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="↻ Refresh" Command="{x:Bind ViewModel.LoadTransfersCommand}" />
            </StackPanel>
        </Grid>

        <!-- 2. Two-Panel Split -->
        <Grid Grid.Row="1" ColumnDefinitions="450,*" Margin="16,12,16,12">
            <!-- Left: Transfers List -->
            <Border Grid.Column="0" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Transfer Requests &amp; In-Transit Batches" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,8" />

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Transfers, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTransferSummary, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:StockTransferSummaryDto">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="6,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <!-- Transfer No Badge -->
                                    <Border Grid.Column="0" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TransferNo}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                    </Border>

                                    <!-- Source -> Destination -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind SourceBranchId}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="➔" FontSize="11" Foreground="{ThemeResource AccentPrimary}" />
                                            <TextBlock Text="{x:Bind DestinationBranchId}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind CreatedAt, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                    </StackPanel>

                                    <!-- Status & Total Qty -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                        <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind TotalRequestedQuantity, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} units'}" FontSize="11" Foreground="{ThemeResource TextSecondary}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Detailed Transfer View -->
            <Border Grid.Column="1" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Transfer Header Info -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SelectedTransferDetail.TransferNo, Mode=OneWay, TargetNullValue='Select a transfer'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />
                                <Border Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTransferDetail.Status, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="From:" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedTransferDetail.SourceBranchId, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="To:" FontSize="12" Foreground="{ThemeResource TextSecondary}" Margin="8,0,0,0" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedTransferDetail.DestinationBranchId, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="📦 Dispatch Stock" Command="{x:Bind ViewModel.DispatchSelectedTransferCommand}" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="📥 Receive &amp; Verify" Command="{x:Bind ViewModel.OpenReceiveDialogCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Table Header -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,110,90,90,90,90,100" Padding="8,6" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Product Name" FontWeight="Bold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="Batch No" FontWeight="Bold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Requested" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Dispatched" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Received" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Discrepancy" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Unit Cost (₹)" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Table Items -->
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedTransferDetail.Items, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:StockTransferItemDto">
                                <Grid ColumnDefinitions="*,110,90,90,90,90,100" Padding="8,8" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ProductName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BatchNumber}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind RequestedQuantity}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DispatchedQuantity}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource AccentPrimary}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ReceivedQuantity}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource StatusSuccess}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind DiscrepancyQuantity}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource StatusDanger}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind UnitCost, Converter={StaticResource StringFormatConverter}, ConverterParameter='₹{0:N2}'}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Notes footer -->
                    <Border Grid.Row="3" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTransferDetail.Notes, Mode=OneWay, TargetNullValue='No transfer notes attached.'}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{ThemeResource SurfaceBackground}" Padding="16,6">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
        </Border>

        <!-- 4. Receive Transfer Dialog Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
              Visibility="{x:Bind ViewModel.IsReceiveDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource SurfaceBackground}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Shadow="{ThemeResource SharedShadow}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Receive Delivery &amp; Verify Discrepancies" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" />

                    <Grid ColumnDefinitions="*,100,100,100" Padding="6,4" Background="{ThemeResource SurfaceSubtle}" CornerRadius="4">
                        <TextBlock Grid.Column="0" Text="Product" FontWeight="Bold" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Batch" FontWeight="Bold" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="Dispatched" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Received Qty" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.ReceiveRows, Mode=OneWay}" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReceiveItemRowViewModel">
                                <Grid ColumnDefinitions="*,100,100,100" Padding="4,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ProductName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind BatchNumber}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind DispatchedQuantity}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <NumberBox Grid.Column="3" Value="{x:Bind ReceivedQuantity, Mode=TwoWay}"
                                               Minimum="0" Maximum="{x:Bind DispatchedQuantityDouble}"
                                               SpinButtonPlacementMode="Inline" Margin="4,0" SmallChange="1" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="Cancel" Command="{x:Bind ViewModel.CloseReceiveDialogCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Confirm Receipt &amp; Restock" Command="{x:Bind ViewModel.ProcessReceiveTransferCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
