<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Medistock.Desktop.Views.Settings.BillCustomizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Medistock.Contracts.Printing"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    Background="{ThemeResource AppBackground}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="16,12">
        <!-- Top Toolbar Ribbon -->
        <Border Grid.Row="0" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Title & Template Picker -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🧾 Bill Studio" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                    <ComboBox x:Name="TemplatePicker"
                              ItemsSource="{x:Bind ViewModel.SavedTemplates, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.CurrentTemplate, Mode=TwoWay}"
                              SelectionChanged="TemplatePicker_SelectionChanged"
                              DisplayMemberPath="Name"
                              Width="260"
                              Height="32" />

                    <!-- Preset Library Menu Flyout -->
                    <DropDownButton Content="⚡ Library Presets" Height="32" FontSize="12">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="📄 Standard A4 Tax Invoice (GST)" Click="PresetA4_Click" />
                                <MenuFlyoutItem Text="✨ Modern Clean A4 Invoice" Click="PresetA4Modern_Click" />
                                <MenuFlyoutItem Text="🏢 Wholesale B2B A4 Invoice" Click="PresetA4Wholesale_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="📜 Compact A5 Memo (Landscape)" Click="PresetA5_Click" />
                                <MenuFlyoutItem Text="💊 A5 Prescription &amp; Bill (Portrait)" Click="PresetA5Rx_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="🧾 High-Speed 80mm Thermal Slip" Click="Preset80mm_Click" />
                                <MenuFlyoutItem Text="📱 Modern 80mm Thermal Receipt" Click="Preset80mmModern_Click" />
                                <MenuFlyoutItem Text="🏷️ Compact 58mm Thermal Slip (2-inch)" Click="Preset58mm_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="⭐ Set Default" Command="{x:Bind ViewModel.SetAsDefaultCommand}" Height="32" FontSize="12" ToolTipService.ToolTip="Set as default invoice template for billing" />
                    <Button Content="📋 Duplicate" Command="{x:Bind ViewModel.DuplicateCurrentTemplateCommand}" Height="32" FontSize="12" ToolTipService.ToolTip="Create an editable copy of this template" />
                    <Button Content="📥 Import JSON" Click="ImportJson_Click" Height="32" FontSize="12" ToolTipService.ToolTip="Import a custom template JSON file" />
                    <Button Content="📤 Export JSON" Click="ExportJson_Click" Height="32" FontSize="12" ToolTipService.ToolTip="Copy or export template JSON" />
                    <Button Content="🗑️ Delete" Command="{x:Bind ViewModel.DeleteCurrentTemplateCommand}" Height="32" FontSize="12" ToolTipService.ToolTip="Delete this custom template" />
                    <Button Content="💾 Save Template" Command="{x:Bind ViewModel.SaveTemplateCommand}" Style="{StaticResource AccentButtonStyle}" FontWeight="Bold" Height="32" FontSize="12" Padding="14,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Split Screen: Left Config Tabs (45%), Right Live Preview (55%) -->
        <Grid Grid.Row="1" ColumnDefinitions="480,12,*">
            <!-- Left Side: Customization Tabs -->
            <Border Grid.Column="0" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12">
                <TabView x:Name="ConfigTabView" IsAddTabButtonVisible="False" TabWidthMode="Equal">
                    <!-- TAB 1: Header & Branding -->
                    <TabViewItem Header="🏢 Header" IsClosable="False">
                        <ScrollViewer Padding="8,12">
                            <StackPanel Spacing="10">
                                <!-- Template Meta -->
                                <Grid ColumnDefinitions="*,120" Margin="0,0,0,6">
                                    <TextBox x:Name="TemplateNameBox" Grid.Column="0" Header="Template Name" Text="{x:Bind ViewModel.CurrentTemplate.Name, Mode=TwoWay}" TextChanged="OnControlChanged" Margin="0,0,4,0" />
                                    <TextBox x:Name="PrimaryColorBox" Grid.Column="1" Header="Accent Color" Text="{x:Bind ViewModel.CurrentTemplate.Styling.PrimaryColorHex, Mode=TwoWay}" TextChanged="OnControlChanged" Margin="4,0,0,0" PlaceholderText="#1b5e20" />
                                </Grid>

                                <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,4" />

                                <ToggleSwitch Header="Show Header Section" IsOn="{x:Bind ViewModel.CurrentTemplate.Header.IsVisible, Mode=TwoWay}" Toggled="OnControlChanged" />
                                
                                <TextBox x:Name="StoreNameBox" Header="Pharmacy / Store Name" Text="{x:Bind ViewModel.CurrentTemplate.Header.StoreName, Mode=TwoWay}" TextChanged="OnControlChanged" />
                                <TextBox x:Name="TaglineBox" Header="Tagline / Slogan" Text="{x:Bind ViewModel.CurrentTemplate.Header.Tagline, Mode=TwoWay}" TextChanged="OnControlChanged" />
                                <TextBox x:Name="AddressLine1Box" Header="Address Line 1" Text="{x:Bind ViewModel.CurrentTemplate.Header.AddressLine1, Mode=TwoWay}" TextChanged="OnControlChanged" />
                                <TextBox x:Name="AddressLine2Box" Header="Address Line 2" Text="{x:Bind ViewModel.CurrentTemplate.Header.AddressLine2, Mode=TwoWay}" TextChanged="OnControlChanged" />
                                <TextBox x:Name="PhoneBox" Header="Contact Phone(s)" Text="{x:Bind ViewModel.CurrentTemplate.Header.Phone, Mode=TwoWay}" TextChanged="OnControlChanged" />
                                <TextBox x:Name="EmailBox" Header="Email / Website" Text="{x:Bind ViewModel.CurrentTemplate.Header.Email, Mode=TwoWay}" TextChanged="OnControlChanged" />
                                
                                <Grid ColumnDefinitions="*,*">
                                    <TextBox x:Name="GstinBox" Grid.Column="0" Header="GSTIN" Text="{x:Bind ViewModel.CurrentTemplate.Header.Gstin, Mode=TwoWay}" TextChanged="OnControlChanged" Margin="0,0,4,0" />
                                    <TextBox x:Name="DlNumbersBox" Grid.Column="1" Header="Drug License (20B/21B)" Text="{x:Bind ViewModel.CurrentTemplate.Header.DlNumbers, Mode=TwoWay}" TextChanged="OnControlChanged" Margin="4,0,0,0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*">
                                    <TextBox x:Name="FssaiBox" Grid.Column="0" Header="FSSAI Lic No" Text="{x:Bind ViewModel.CurrentTemplate.Header.Fssai, Mode=TwoWay}" TextChanged="OnControlChanged" Margin="0,0,4,0" />
                                    <TextBox x:Name="SaleInvoiceTitleBox" Grid.Column="1" Header="Bill Title" Text="{x:Bind ViewModel.CurrentTemplate.Header.SaleInvoiceTitle, Mode=TwoWay}" TextChanged="OnControlChanged" Margin="4,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <!-- TAB 2: Columns Customizer -->
                    <TabViewItem Header="📊 Columns" IsClosable="False">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="Toggle visibility, rename headers, and reorder columns:" FontSize="12" Foreground="{ThemeResource TextSecondary}" Margin="4,6,4,8" />
                            
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.EditableColumns, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BillColumnConfig">
                                        <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="4,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsVisible, Mode=TwoWay}" Checked="OnColumnToggled" Unchecked="OnColumnToggled" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Text="{x:Bind HeaderTitle, Mode=TwoWay}" TextChanged="OnColumnHeaderTextChanged" Height="30" FontSize="12" VerticalAlignment="Center" />
                                                
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind FieldType}" FontSize="10" Foreground="{ThemeResource TextTertiary}" VerticalAlignment="Center" Width="80" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Button Content="▲" Click="MoveColUp_Click" Height="28" Width="28" Padding="0" FontSize="10" />
                                                    <Button Content="▼" Click="MoveColDown_Click" Height="28" Width="28" Padding="0" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabViewItem>

                    <!-- TAB 3: Metadata & Patient -->
                    <TabViewItem Header="👤 Topbar" IsClosable="False">
                        <ScrollViewer Padding="8,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Select metadata fields to show on the invoice topbar:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                
                                <CheckBox Content="Show Invoice Number" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowInvoiceNo, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Invoice Date &amp; Time" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowInvoiceDate, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Counter Name" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowCounter, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Cashier / Billed By" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowCashier, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                
                                <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,8" />
                                <TextBlock Text="Doctor &amp; Patient Information:" FontSize="12" FontWeight="SemiBold" />
                                
                                <CheckBox Content="Show Patient / Customer Name" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowCustomerName, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Patient Phone" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowCustomerPhone, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Prescribing Doctor Name" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowDoctorName, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Doctor Reg Number" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowDoctorRegNo, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Payment Mode" IsChecked="{x:Bind ViewModel.CurrentTemplate.Metadata.ShowPaymentMode, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <!-- TAB 4: Totals & Footer -->
                    <TabViewItem Header="💰 Totals" IsClosable="False">
                        <ScrollViewer Padding="8,12">
                            <StackPanel Spacing="10">
                                <CheckBox Content="Show Subtotal (Taxable Value)" IsChecked="{x:Bind ViewModel.CurrentTemplate.Footer.ShowSubtotal, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Total Items &amp; Quantity Count" IsChecked="{x:Bind ViewModel.CurrentTemplate.Footer.ShowTotalItems, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Customer Savings Callout Banner" IsChecked="{x:Bind ViewModel.CurrentTemplate.Footer.ShowSavingsCallout, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Statutory Round-Off (+/-)" IsChecked="{x:Bind ViewModel.CurrentTemplate.Footer.ShowRoundOff, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show Amount in Words (INR format)" IsChecked="{x:Bind ViewModel.CurrentTemplate.Footer.ShowAmountInWords, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <CheckBox Content="Show GST Tax Breakdown Table" IsChecked="{x:Bind ViewModel.CurrentTemplate.TaxSummary.ShowTaxTable, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />

                                <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,8" />
                                <TextBox x:Name="TermsAndConditionsBox" Header="Terms &amp; Conditions (Multi-line)" Text="{x:Bind ViewModel.CurrentTemplate.Footer.TermsAndConditionsText, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" TextChanged="OnControlChanged" />
                                <TextBox x:Name="GreetingBox" Header="Closing Greeting" Text="{x:Bind ViewModel.CurrentTemplate.Footer.GreetingText, Mode=TwoWay}" TextChanged="OnControlChanged" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <!-- TAB 5: Signatures & Layout -->
                    <TabViewItem Header="✍️ Signatures" IsClosable="False">
                        <ScrollViewer Padding="8,12">
                            <StackPanel Spacing="10">
                                <CheckBox Content="Show Registered Pharmacist Seal" IsChecked="{x:Bind ViewModel.CurrentTemplate.Signatures.ShowPharmacistSign, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <TextBox x:Name="PharmacistSignTitleBox" Header="Pharmacist Sign Title" Text="{x:Bind ViewModel.CurrentTemplate.Signatures.PharmacistSignTitle, Mode=TwoWay}" TextChanged="OnControlChanged" />

                                <CheckBox Content="Show Customer / Receiver Signature" IsChecked="{x:Bind ViewModel.CurrentTemplate.Signatures.ShowCustomerSign, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                
                                <CheckBox Content="Show Authorized Signatory" IsChecked="{x:Bind ViewModel.CurrentTemplate.Signatures.ShowAuthorizedSign, Mode=TwoWay}" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <TextBox x:Name="AuthorizedSignTitleBox" Header="Authorized Signatory Title" Text="{x:Bind ViewModel.CurrentTemplate.Signatures.AuthorizedSignTitle, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" TextChanged="OnControlChanged" />

                                <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,8" />
                                <TextBlock Text="Styling &amp; Paper Size:" FontSize="12" FontWeight="SemiBold" />
                                <ToggleSwitch Header="Alternate Row Shading" IsOn="{x:Bind ViewModel.CurrentTemplate.Styling.AlternateRowColors, Mode=TwoWay}" Toggled="OnControlChanged" />
                                <ToggleSwitch Header="Table Grid Borders" IsOn="{x:Bind ViewModel.CurrentTemplate.Styling.ShowTableBorders, Mode=TwoWay}" Toggled="OnControlChanged" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>
                </TabView>
            </Border>

            <!-- Center Divider -->
            <Border Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Side: Interactive Live Print Preview Container -->
            <Border Grid.Column="2" Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Preview Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="👁️ Live WYSIWYG Bill Preview" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="(Updates automatically on any edit)" FontSize="11" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button HorizontalAlignment="Right" Content="🔄 Refresh Preview" Click="RefreshPreview_Click" Height="30" FontSize="11" Padding="10,0" />
                    </Grid>

                    <!-- WebView2 Viewport -->
                    <Border Grid.Row="1" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4" Background="#ffffff">
                        <WebView2 x:Name="LivePreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>

                    <!-- Footer Status -->
                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondary}" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
