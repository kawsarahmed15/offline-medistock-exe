<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Medistock.Desktop.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Medistock.Desktop.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Medistock.Desktop.ViewModels"
    Background="{ThemeResource AppBackground}"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16">
        <StackPanel MaxWidth="900" Spacing="20" HorizontalAlignment="Left">
            <!-- Header Banner -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/MedistockLogo.png" Width="42" Height="42" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Medistock Configuration &amp; Preferences" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Customize application theme, font scale, store details, and printer defaults" FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="💾 Save Settings"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            FontWeight="Bold"
                            Height="36"
                            Padding="16,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Status Banner -->
            <Border Background="{ThemeResource SurfaceSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimary}" />
            </Border>

            <!-- 1. Appearance & Visual Customization -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="🎨 Visual Theme &amp; Typography" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />

                    <!-- Theme Selector -->
                    <Grid ColumnDefinitions="200,*">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Application Theme" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Switch between Dark and Light mode" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}" Width="240">
                            <x:String>Dark</x:String>
                            <x:String>Light</x:String>
                        </ComboBox>
                    </Grid>

                    <!-- Font Size Scaling -->
                    <Grid ColumnDefinitions="200,*">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="System Font Size Scaling" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Adjust app &amp; table readability" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.FontSize, Mode=TwoWay}" Width="240">
                            <x:String>Compact (11px)</x:String>
                            <x:String>Standard (13px)</x:String>
                            <x:String>Medium (14px)</x:String>
                            <x:String>Large (15px)</x:String>
                            <x:String>Extra Large (17px)</x:String>
                            <x:String>Huge (19px)</x:String>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Pharmacy / Store Metadata -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="🏥 Pharmacy &amp; Business Information" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <!-- Store Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Pharmacy / Store Name" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                            <TextBox Text="{x:Bind ViewModel.PharmacyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="32" />
                        </StackPanel>

                        <!-- GSTIN -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="GSTIN / Tax ID" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                            <TextBox Text="{x:Bind ViewModel.Gstin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="32" />
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Contact Phone / Mobile" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                            <TextBox Text="{x:Bind ViewModel.ContactPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="32" />
                        </StackPanel>

                        <!-- Invoice Prefix -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Invoice Number Prefix" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                            <TextBox Text="{x:Bind ViewModel.InvoicePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="32" />
                        </StackPanel>

                        <!-- Address -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                            <TextBlock Text="Store Address (Printed on Invoices)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" />
                            <TextBox Text="{x:Bind ViewModel.StoreAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="32" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Hardware & POS Scanner Preferences -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="⚙ POS Scanner &amp; Hardware" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />

                    <CheckBox IsChecked="{x:Bind ViewModel.EnableBarcodeAudio, Mode=TwoWay}"
                              Content="Enable Audio Sound / Beep Feedback on Barcode Scan"
                              FontSize="13" />
                </StackPanel>
            </Border>

            <!-- 3.5. Inventory & Expiry Alert Thresholds -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="⚠️ Inventory &amp; Expiry Alerts" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />

                    <Grid ColumnDefinitions="240,*">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Near-Expiry Alert Threshold" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Days before expiry to mark medicine in Red" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumberBox Value="{x:Bind ViewModel.NearExpiryDays, Mode=TwoWay}"
                                       Minimum="1"
                                       Maximum="730"
                                       SmallChange="15"
                                       SpinButtonPlacementMode="Inline"
                                       Width="140"
                                       Height="34"
                                       FontSize="13" />
                            <TextBlock Text="Days (e.g. 30, 60, 90, 180)" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Bill Customizer Studio Card -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="🧾 Bill &amp; Invoice Customizer Studio" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                        <TextBlock Text="Configure 100% of your bill: customize headers, pick columns, reorder items, setup signatures, and preview live." FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open Customizer Studio ➔" Click="OpenCustomizer_Click" Style="{StaticResource AccentButtonStyle}" Height="36" Padding="14,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 5. Backup & Disaster Recovery -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="📦 Backup &amp; Disaster Recovery" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                    <TextBlock Text="Safeguard your pharmacy data with local zip archives and end-to-end encrypted cloud snapshots." FontSize="12" Foreground="{ThemeResource TextSecondary}" />

                    <!-- A. Local Backup & Restore Sub-section -->
                    <Border Background="{ThemeResource SurfaceBackgroundSecondary}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="💾 Local Backups (.ZIP)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                            
                            <!-- Destination Path -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Destination Folder" FontSize="11" Foreground="{ThemeResource TextSecondary}" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBox Grid.Column="0"
                                             Text="{x:Bind ViewModel.BackupLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="C:\Users\...\Documents\Medistock\Backups"
                                             FontSize="12"
                                             Height="32" />
                                    <Button Grid.Column="1"
                                            Content="📁 Browse..."
                                            Click="BrowseBackupLocation_Click"
                                            Height="32"
                                            ToolTipService.ToolTip="Select a custom local or external drive folder" />
                                    <Button Grid.Column="2"
                                            Content="↺ Reset"
                                            Command="{x:Bind ViewModel.ResetBackupLocationCommand}"
                                            Height="32"
                                            ToolTipService.ToolTip="Reset path back to Documents\Medistock\Backups" />
                                    <Button Grid.Column="3"
                                            Content="↗ Open"
                                            Command="{x:Bind ViewModel.OpenBackupFolderCommand}"
                                            Height="32"
                                            ToolTipService.ToolTip="Open folder in Windows Explorer" />
                                </Grid>
                            </StackPanel>

                            <!-- Local Automated Backup Options -->
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <CheckBox IsChecked="{x:Bind ViewModel.AutoDailyBackup, Mode=TwoWay}"
                                          Content="Automatic daily local backup (creates backup on startup if not already created today)"
                                          FontSize="12" />
                                <CheckBox IsChecked="{x:Bind ViewModel.AutoDeleteBackupsOlderThan7Days, Mode=TwoWay}"
                                          Content="Keep only the latest 7 backups (automatically delete older backup files beyond last 7)"
                                          FontSize="12" />
                            </StackPanel>

                            <!-- Local Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button Content="💾 Create Local Backup (ZIP)"
                                        Command="{x:Bind ViewModel.CreateLocalBackupCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="34" />
                                <Button Content="📥 Import / Restore from File (.ZIP)..."
                                        Click="BrowseAndRestoreLocalBackup_Click"
                                        Height="34"
                                        ToolTipService.ToolTip="Choose an existing .zip backup file to restore database" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- B. Cloud Backup & Restore (AES-256) Sub-section -->
                    <Border Background="{ThemeResource SurfaceBackgroundSecondary}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="☁ Cloud Backups (AES-256 Encrypted)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Snapshots are encrypted locally with AES-256 before uploading to the server." FontSize="11" Foreground="{ThemeResource TextSecondary}" />

                            <!-- Cloud Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="☁ Upload to Cloud"
                                        Command="{x:Bind ViewModel.UploadCloudBackupCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="34" />
                                <Button Content="📥 Restore Latest Cloud Backup"
                                        Click="RestoreCloudBackup_Click"
                                        Height="34"
                                        ToolTipService.ToolTip="Download and restore latest cloud backup from server" />
                                <Button Content="🔄 Refresh Cloud List"
                                        Command="{x:Bind ViewModel.RefreshCloudBackupsCommand}"
                                        Height="34" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Notification Banner -->
                    <Border Background="{ThemeResource SurfaceSubtle}"
                            BorderBrush="{ThemeResource AccentPrimary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Visibility="{x:Bind ViewModel.BackupStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.BackupStatusMessage, Mode=OneWay}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource AccentPrimary}"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5.5. Master Medicine Database & Default Catalog Seeder -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="💊 Master Medicine Catalog &amp; Default Seeder" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Seed or manage the 250,000+ Indian medicines directory (Allopathy, generics, compositions, dosage forms &amp; GST). Medicines are not automatically seeded on fresh installation."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Product Count Badge -->
                        <Border Grid.Column="1" Background="{ThemeResource SurfaceSubtle}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="📦 Catalog Size:" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ProductCount, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="medicines" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- File Path & Detection Box -->
                    <Border Background="{ThemeResource SurfaceBackgroundSecondary}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="12">
                            <TextBlock Text="📁 Master Data JSON Source" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                            
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{x:Bind ViewModel.MedicineJsonPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="c:\Users\...\Downloads\indian_medicine_data.json"
                                         FontSize="12"
                                         Height="34" />
                                <Button Grid.Column="1"
                                        Content="📁 Browse JSON..."
                                        Click="BrowseMedicineJson_Click"
                                        Height="34"
                                        ToolTipService.ToolTip="Select indian_medicine_data.json file" />
                            </Grid>

                            <!-- Actions Row -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button Content="⚡ Seed Master Indian Medicines (253,973 Items)"
                                        Command="{x:Bind ViewModel.SeedMasterMedicinesCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="36"
                                        FontWeight="Bold"
                                        ToolTipService.ToolTip="Import all 250,000+ Indian medicines into local SQLite database" />

                                <Button Content="🧪 Seed Sample Pack (220 Items with Stock)"
                                        Command="{x:Bind ViewModel.SeedSampleMedicinesCommand}"
                                        Height="36"
                                        ToolTipService.ToolTip="Seed 220 common demo medicines with batches and stock" />

                                <Button Content="🗑 Clear Catalog"
                                        Click="ClearProducts_Click"
                                        Height="36"
                                        ToolTipService.ToolTip="Remove all products and batches from catalog" />
                            </StackPanel>

                            <!-- Progress Bar (Visible during seeding) -->
                            <StackPanel Spacing="6" Margin="0,6,0,0" Visibility="{x:Bind ViewModel.IsSeeding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Value="{x:Bind ViewModel.SeedProgressPercent, Mode=OneWay}"
                                             Maximum="100"
                                             Height="8"
                                             Foreground="{ThemeResource AccentPrimary}" />
                                <TextBlock Text="{x:Bind ViewModel.SeedProgressStatus, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentPrimary}" />
                            </StackPanel>

                            <!-- Status / Result Message -->
                            <TextBlock Text="{x:Bind ViewModel.SeedStatusMessage, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentPrimary}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.SeedStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 6. Software Updates & Licensing -->
            <Border Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="🔄 Software Updates &amp; Activation" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimary}" />
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.LicenseInfo, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                            <TextBlock Text="Automatic updates run in the background. You can also check manually." FontSize="12" Foreground="{ThemeResource TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="🔍 Check for Updates"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                Height="36"
                                Padding="14,0" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource AccentPrimary}"
                               FontWeight="SemiBold"
                               Visibility="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Action Save Button -->
            <Button Content="💾 Save All Preferences"
                    Command="{x:Bind ViewModel.SaveSettingsCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Height="40"
                    Width="200"
                    FontWeight="Bold"
                    FontSize="13" />
        </StackPanel>
    </ScrollViewer>
</Page>
