<ContentDialog
    x:Class="Medistock.Desktop.Controls.ShortcutHelpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cmd="using:Medistock.Desktop.Commands"
    mc:Ignorable="d"
    Title="⌨ Keyboard Shortcuts Reference"
    PrimaryButtonText="Close [Esc]"
    DefaultButton="Primary">

    <Grid MinWidth="480" MaxHeight="450" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   x:Name="ProfileHeader"
                   Text="Profile: Medistock Standard"
                   FontSize="12"
                   Foreground="{ThemeResource TextSecondary}"
                   Margin="0,0,0,12" />

        <ListView Grid.Row="1"
                  x:Name="ShortcutsList"
                  SelectionMode="None"
                  BorderBrush="{ThemeResource BorderDefault}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="4">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,6" BorderBrush="{ThemeResource BorderDefault}" BorderThickness="0,0,0,1">
                        <Border Grid.Column="0"
                                Background="{ThemeResource AccentSubtle}"
                                CornerRadius="4"
                                Padding="8,3"
                                MinWidth="60">
                            <TextBlock Text="{Binding Key}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{ThemeResource AccentPrimary}"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Description}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />

                        <Border Grid.Column="2"
                                Background="{ThemeResource SurfaceSubtle}"
                                CornerRadius="3"
                                Padding="6,2">
                            <TextBlock Text="{Binding Scope}"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextMuted}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
